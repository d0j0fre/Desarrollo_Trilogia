<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7b74823b-2359-4973-9f0c-d9fd2fd4c13a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.Identity habilita Authentication=Active Directory Default en la cadena de
         conexion, que es como el proyecto se conecta a Azure SQL sin contrasena.
         Llega de forma transitiva con Microsoft.Data.SqlClient, pero se declara explicito
         para que una actualizacion de ese paquete no lo quite sin aviso. -->
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
