<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>30d9c23e-7cc1-4aff-928a-97b41cc67542</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.Identity habilita Authentication=Active Directory Default en la cadena de
         conexion, que es como el proyecto se conecta a Azure SQL sin contrasena.
         Llega de forma transitiva con Microsoft.Data.SqlClient, pero se declara explicito
         para que una actualizacion de ese paquete no lo quite sin aviso. -->
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.12" />
  </ItemGroup>

</Project>
