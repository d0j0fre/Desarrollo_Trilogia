@model Proyecto_Final.Models.Admin.MileageIndexViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Kilometraje"; var vehiculos = ViewBag.VehiculosKm as List<Proyecto_Final.Models.Admin.VehicleListItemViewModel> ?? new(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Logística · Flota</span><h1>Kilometraje de jornada</h1><p>Registrá el kilometraje inicial y final para mantener el historial del vehículo.</p></div></header>
<div class="djj-workspace-split"><section class="djj-card djj-form-card" aria-labelledby="open-mileage"><h2 id="open-mileage">Iniciar jornada</h2><form asp-action="OpenMileage" method="post" class="djj-form-grid">@Html.AntiForgeryToken()<div class="djj-field djj-form-grid__full"><label for="kmVehiculo">Vehículo</label><select asp-for="Nueva.VehiculoId" id="kmVehiculo" class="djj-input"><option value="">Seleccione un vehículo</option>@foreach (var v in vehiculos) { <option value="@v.VehiculoId" data-odometro="@v.KilometrajeActual">@v.Placa — @v.Descripcion (odómetro: @v.KilometrajeActual km)</option> }</select></div><div class="djj-field"><label asp-for="Nueva.KmInicial">Kilometraje inicial</label><input asp-for="Nueva.KmInicial" id="kmInicial" class="djj-input" type="number" min="0" /><small id="kmHint">No puede ser menor al odómetro actual.</small></div><div class="djj-field"><label asp-for="Nueva.Observaciones">Observaciones <span>(opcional)</span></label><input asp-for="Nueva.Observaciones" class="djj-input" /></div><div class="djj-form-actions djj-form-grid__full"><button type="submit" class="djj-button djj-button--primary">Iniciar jornada</button></div></form></section><section class="djj-card djj-data-section" aria-labelledby="mileage-list"><header><div><h2 id="mileage-list">Jornadas registradas</h2><p>@Model.Jornadas.Count jornada(s).</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Vehículo</th><th>Chofer</th><th>Fecha</th><th class="djj-align-right">Inicial</th><th class="djj-align-right">Final</th><th class="djj-align-right">Recorrido</th><th>Acción</th></tr></thead><tbody>@if (!Model.Jornadas.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin jornadas registradas</h3><p>Las jornadas de kilometraje aparecerán aquí.</p></div></td></tr> } else { @foreach (var j in Model.Jornadas) { <tr><td><strong>@j.VehiculoPlaca</strong></td><td>@j.ChoferNombre</td><td>@j.Fecha.ToString("dd/MM/yyyy")</td><td class="djj-align-right">@j.KmInicial km</td><td class="djj-align-right">@(j.KmFinal?.ToString() ?? "—")</td><td class="djj-align-right">@(j.Recorrido.HasValue ? $"{j.Recorrido} km" : "—")</td><td>@if (j.Abierta) { <form asp-action="CloseMileage" method="post" class="djj-inline-form" data-djj-confirm="¿Cerrar la jornada con este kilometraje final? El odómetro se actualizará.">@Html.AntiForgeryToken()<input type="hidden" name="kilometrajeId" value="@j.KilometrajeId" /><label class="djj-sr-only" for="km-final-@j.KilometrajeId">Kilometraje final de @j.VehiculoPlaca</label><input id="km-final-@j.KilometrajeId" type="number" name="kmFinal" class="djj-input" min="@j.KmInicial" required /><button type="submit" class="djj-button djj-button--success djj-button--sm">Cerrar</button></form> } else { <span class="djj-status-badge djj-status-badge--success">Cerrada</span> }</td></tr> } }</tbody></table></div></section></div>
@section Scripts { <script>(function(){var sel=document.getElementById('kmVehiculo'),km=document.getElementById('kmInicial'),hint=document.getElementById('kmHint');if(!sel||!km)return;sel.addEventListener('change',function(){var opt=sel.options[sel.selectedIndex],odo=opt?parseInt(opt.getAttribute('data-odometro')||'0',10):0;km.min=odo;if(!km.value||parseInt(km.value,10)<odo)km.value=odo;if(hint)hint.textContent='Odómetro actual: '+odo+' km. El kilometraje inicial no puede ser menor.';});})();</script> }
