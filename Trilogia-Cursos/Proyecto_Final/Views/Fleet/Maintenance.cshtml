@model Proyecto_Final.Models.Admin.MaintenanceIndexViewModel
@{
    ViewData["Title"] = "Mantenimiento de flota";
    var vehiculos = ViewBag.Vehiculos as List<Proyecto_Final.Models.Admin.VehicleOptionViewModel> ?? new();
    string TextoEstado(string e) => e == "EnProceso" ? "En proceso" : e;
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header">
                <h2 class="mb-2">Órdenes de mantenimiento</h2>
                <p class="mb-0">Registre el mantenimiento preventivo y correctivo de cada vehículo para llevar control de los gastos del taller. Mientras una orden correctiva está En proceso, el vehículo queda fuera de circulación.</p>
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-lg-4 mb-4">
            <div class="admin-table-wrapper p-4">
                <h5 class="mb-3">Nueva orden</h5>
                <form asp-action="CreateMaintenance" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label class="font-weight-bold">Vehículo</label>
                        <select asp-for="Nueva.VehiculoId" class="form-control">
                            <option value="">-- Seleccione --</option>
                            @foreach (var v in vehiculos)
                            {
                                <option value="@v.VehiculoId">@v.Placa — @v.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Tipo</label>
                        <select asp-for="Nueva.Tipo" class="form-control">
                            <option value="Preventivo">Preventivo</option>
                            <option value="Correctivo">Correctivo</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Descripción</label>
                        <textarea asp-for="Nueva.Descripcion" class="form-control" rows="2" placeholder="Ej: cambio de aceite y filtros"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Taller</label>
                        <input asp-for="Nueva.Taller" class="form-control" />
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label class="font-weight-bold">Costo (₡)</label>
                            <input asp-for="Nueva.Costo" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <div class="form-group col-6">
                            <label class="font-weight-bold">Estado</label>
                            <select asp-for="Nueva.Estado" class="form-control" id="estadoOrden">
                                <option value="Programada">Programada</option>
                                <option value="EnProceso">En proceso</option>
                                <option value="Completada">Completada</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label class="font-weight-bold">Fecha programada</label>
                            <input asp-for="Nueva.FechaProgramada" class="form-control" type="date" />
                        </div>
                        <div class="form-group col-6">
                            <label class="font-weight-bold">Próximo (km)</label>
                            <input asp-for="Nueva.KilometrajeProximo" class="form-control" type="number" min="0" placeholder="Aviso por desgaste" />
                        </div>
                    </div>
                    <div class="form-group" id="fechaRealizadaGrupo">
                        <label class="font-weight-bold">Fecha de realización</label>
                        <input asp-for="Nueva.FechaRealizada" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <small class="form-text text-muted">Para una orden Completada; si se deja vacía se usa la fecha de hoy.</small>
                    </div>
                    <button type="submit" class="btn btn-ds-create btn-block"><i class="fa fa-wrench mr-2"></i>Registrar orden</button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="admin-filter-bar mb-3">
                <form asp-action="Maintenance" method="get" class="form-inline">
                    <select name="estado" class="form-control mr-2 mb-2">
                        <option value="">Todos los estados</option>
                        <option value="Programada" selected="@(Model.Estado == "Programada")">Programada</option>
                        <option value="EnProceso" selected="@(Model.Estado == "EnProceso")">En proceso</option>
                        <option value="Completada" selected="@(Model.Estado == "Completada")">Completada</option>
                    </select>
                    <button type="submit" class="btn btn-ds-search mr-2 mb-2"><i class="fa fa-filter mr-2"></i>Filtrar</button>
                    <a asp-action="Maintenance" class="btn btn-ds-neutral mb-2"><i class="fa fa-eraser mr-2"></i>Limpiar</a>
                </form>
            </div>

            <div class="admin-table-wrapper">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Historial de mantenimiento</h5>
                    <span class="text-muted">Total: @Model.Ordenes.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>Vehículo</th>
                                <th>Tipo</th>
                                <th>Descripción</th>
                                <th>Fechas</th>
                                <th class="text-right">Próx. km</th>
                                <th class="text-right">Costo</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Ordenes.Any())
                            {
                                <tr><td colspan="8" class="text-center text-muted py-4">No hay órdenes registradas.</td></tr>
                            }
                            else
                            {
                                @foreach (var o in Model.Ordenes)
                                {
                                    var badge = o.Estado == "Completada" ? "success" : (o.Estado == "EnProceso" ? "dark" : "warning");
                                    var tipoBadge = o.Tipo == "Preventivo" ? "info" : "danger";
                                    var cerrada = o.Estado == "Completada" || o.Estado == "Cancelada";
                                    <tr>
                                        <td class="font-weight-bold">@o.VehiculoPlaca</td>
                                        <td><span class="admin-badge-soft @tipoBadge">@o.Tipo</span></td>
                                        <td>@o.Descripcion<br /><small class="text-muted">@o.Taller</small></td>
                                        <td class="small text-nowrap">
                                            Registrada: @o.FechaRegistro.ToString("dd/MM/yyyy")<br />
                                            Programada: @(o.FechaProgramada?.ToString("dd/MM/yyyy") ?? "—")<br />
                                            Realizada: @(o.FechaRealizada?.ToString("dd/MM/yyyy") ?? "—")
                                        </td>
                                        <td class="text-right">@(o.KilometrajeProximo.HasValue ? $"{o.KilometrajeProximo.Value:N0} km" : "—")</td>
                                        <td class="text-right">₡@o.Costo.ToString("N2")</td>
                                        <td class="text-center"><span class="admin-badge-soft @badge">@TextoEstado(o.Estado)</span></td>
                                        <td class="text-center text-nowrap">
                                            @if (o.Estado == "Programada")
                                            {
                                                <form asp-action="StartMaintenance" method="post" class="d-inline"
                                                      data-s3-confirm="@(o.Tipo == "Correctivo" ? "¿Iniciar la reparación? El vehículo quedará fuera de circulación hasta completarla." : "¿Pasar la orden a En proceso?")"
                                                      data-s3-confirm-title="Iniciar mantenimiento"
                                                      data-s3-confirm-type="warning"
                                                      data-s3-confirm-ok="Sí, iniciar"
                                                      data-s3-confirm-cancel="Cancelar">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ordenId" value="@o.OrdenMantenimientoId" />
                                                    <button type="submit" class="btn btn-sm btn-ds-edit" title="Iniciar" aria-label="Iniciar la orden de @o.VehiculoPlaca"><i class="fa fa-play"></i></button>
                                                </form>
                                            }
                                            @if (!cerrada)
                                            {
                                                <button type="button" class="btn btn-sm btn-ds-action" data-toggle="collapse" data-target="#completar-@o.OrdenMantenimientoId"
                                                        title="Completar" aria-label="Marcar mantenimiento como atendido"><i class="fa fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@o.FechaRealizada?.ToString("dd/MM/yyyy")</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (!cerrada)
                                    {
                                        <tr class="collapse" id="completar-@o.OrdenMantenimientoId">
                                            <td colspan="8" class="bg-light">
                                                <form asp-action="CompleteMaintenance" method="post" class="form-inline"
                                                      data-s3-confirm="¿Marcar la orden como completada con el costo final indicado?"
                                                      data-s3-confirm-title="Completar mantenimiento"
                                                      data-s3-confirm-type="warning"
                                                      data-s3-confirm-ok="Sí, completar"
                                                      data-s3-confirm-cancel="Cancelar">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ordenId" value="@o.OrdenMantenimientoId" />
                                                    <label class="font-weight-bold mr-2 mb-2" for="costo-@o.OrdenMantenimientoId">Costo final (₡)</label>
                                                    <input type="number" id="costo-@o.OrdenMantenimientoId" name="costo" step="0.01" min="0" value="@o.Costo.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control mr-3 mb-2" style="width:150px" />
                                                    <label class="font-weight-bold mr-2 mb-2" for="fecha-@o.OrdenMantenimientoId">Fecha de realización</label>
                                                    <input type="date" id="fecha-@o.OrdenMantenimientoId" name="fechaRealizada" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control mr-3 mb-2" />
                                                    <button type="submit" class="btn btn-ds-create mb-2"><i class="fa fa-check mr-2"></i>Completar orden</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var estado = document.getElementById('estadoOrden');
            var grupo = document.getElementById('fechaRealizadaGrupo');
            if (!estado || !grupo) return;
            function sync() { grupo.style.display = estado.value === 'Completada' ? '' : 'none'; }
            estado.addEventListener('change', sync);
            sync();
        })();
    </script>
}
