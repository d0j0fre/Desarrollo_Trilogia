@model Proyecto_Final.Models.Admin.FleetAlertsViewModel
@{
    ViewData["Title"] = "Alertas de flota";
    var vehiculos = ViewBag.Vehiculos as List<Proyecto_Final.Models.Admin.VehicleOptionViewModel> ?? new();
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header">
                <h2 class="mb-2">Alertas de flota</h2>
                <p class="mb-0">Vencimientos legales y mantenimientos preventivos próximos o vencidos, para evitar averías mayores o multas.</p>
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-lg-8 mb-4">
            <div class="admin-filter-bar mb-3">
                <form asp-action="Alerts" method="get" class="form-inline">
                    <label class="mr-2 mb-2">Avisar con</label>
                    <input type="number" name="diasAviso" value="@Model.DiasAviso" min="1" max="180" class="form-control mr-2 mb-2" style="width:90px" />
                    <span class="mr-2 mb-2">días de anticipación</span>
                    <button type="submit" class="btn btn-ds-edit mb-2"><i class="fa fa-sync mr-2"></i>Actualizar</button>
                </form>
            </div>

            <div class="admin-table-wrapper">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Alertas activas</h5>
                    <span class="text-muted">Total: @Model.Alertas.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>Categoría</th>
                                <th>Vehículo</th>
                                <th>Detalle</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Alertas.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-4"><i class="fa fa-check-circle text-success mr-2"></i>Sin alertas pendientes.</td></tr>
                            }
                            else
                            {
                                @foreach (var a in Model.Alertas)
                                {
                                    var badge = a.Severidad switch { "Vencido" => "danger", "EnCurso" => "info", "Pendiente" => "dark", _ => "warning" };
                                    var texto = a.Severidad switch
                                    {
                                        "Vencido" => "Vencido",
                                        "EnCurso" => "En reparación",
                                        "Pendiente" => "Pendiente",
                                        _ => a.DiasRestantes.HasValue ? $"En {a.DiasRestantes} día(s)" : "Por vencer"
                                    };
                                    var icono = a.Categoria == "Documento" ? "fa-file-contract" : "fa-wrench";
                                    <tr>
                                        <td><i class="fa @icono mr-2 text-muted"></i>@a.Categoria</td>
                                        <td class="font-weight-bold">@a.VehiculoPlaca</td>
                                        <td>@a.Detalle</td>
                                        <td class="text-center"><span class="admin-badge-soft @badge">@texto</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-table-wrapper mt-4">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap">
                    <h5 class="mb-0">Documentos legales</h5>
                    <form asp-action="Alerts" method="get" class="form-inline">
                        <input type="hidden" name="diasAviso" value="@Model.DiasAviso" />
                        <label class="mr-2 mb-0" for="docVehiculo">Vehículo</label>
                        <select id="docVehiculo" name="vehiculoId" class="form-control form-control-sm mr-2" onchange="this.form.submit()">
                            <option value="">Todos</option>
                            @foreach (var v in vehiculos)
                            {
                                <option value="@v.VehiculoId" selected="@(Model.VehiculoId == v.VehiculoId)">@v.Placa</option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-sm btn-ds-search">Filtrar</button></noscript>
                    </form>
                </div>
                <p class="text-muted small px-3 pt-2 mb-0">Solo el documento vigente (el más reciente de cada vehículo y tipo) genera alertas; los anteriores quedan como historial.</p>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>Vehículo</th>
                                <th>Tipo</th>
                                <th>Vence</th>
                                <th>Observaciones</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Documentos.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">No hay documentos registrados.</td></tr>
                            }
                            else
                            {
                                @foreach (var d in Model.Documentos)
                                {
                                    <tr class="@(d.EsVigente ? "" : "text-muted")">
                                        <td class="font-weight-bold">@d.VehiculoPlaca</td>
                                        <td>@d.Tipo</td>
                                        <td>@d.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                        <td>@d.Observaciones</td>
                                        <td class="text-center">
                                            @if (!d.EsVigente)
                                            {
                                                <span class="admin-badge-soft dark">Reemplazado</span>
                                            }
                                            else if (d.DiasRestantes < 0)
                                            {
                                                <span class="admin-badge-soft danger">Vencido</span>
                                            }
                                            else if (d.DiasRestantes <= Model.DiasAviso)
                                            {
                                                <span class="admin-badge-soft warning">En @d.DiasRestantes día(s)</span>
                                            }
                                            else
                                            {
                                                <span class="admin-badge-soft success">Vigente</span>
                                            }
                                        </td>
                                        <td class="text-center text-nowrap">
                                            <a asp-action="EditDocument" asp-route-id="@d.DocumentoId" class="btn btn-sm btn-ds-edit" title="Editar" aria-label="Editar el documento @d.Tipo de @d.VehiculoPlaca"><i class="fa fa-edit"></i></a>
                                            <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                  data-s3-confirm="¿Dar de baja el documento @d.Tipo de @d.VehiculoPlaca? Dejará de contarse en las alertas."
                                                  data-s3-confirm-title="Dar de baja documento"
                                                  data-s3-confirm-type="danger"
                                                  data-s3-confirm-ok="Sí, dar de baja"
                                                  data-s3-confirm-cancel="Cancelar">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="documentoId" value="@d.DocumentoId" />
                                                <input type="hidden" name="vehiculoId" value="@Model.VehiculoId" />
                                                <button type="submit" class="btn btn-sm btn-ds-danger" title="Dar de baja" aria-label="Dar de baja el documento @d.Tipo de @d.VehiculoPlaca"><i class="fa fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="admin-table-wrapper p-4">
                <h5 class="mb-3">Registrar documento legal</h5>
                <p class="text-muted small">Marchamo, RTV, seguro u otro documento con fecha de vencimiento.</p>
                <form asp-action="CreateDocument" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="font-weight-bold">Vehículo</label>
                        <select asp-for="NuevoDocumento.VehiculoId" class="form-control">
                            <option value="">-- Seleccione --</option>
                            @foreach (var v in vehiculos)
                            {
                                <option value="@v.VehiculoId">@v.Placa — @v.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Tipo</label>
                        <select asp-for="NuevoDocumento.Tipo" class="form-control">
                            <option value="Marchamo">Marchamo</option>
                            <option value="RTV">RTV (Riteve)</option>
                            <option value="Seguro">Seguro</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Fecha de vencimiento</label>
                        <input asp-for="NuevoDocumento.FechaVencimiento" class="form-control" type="date" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Observaciones</label>
                        <input asp-for="NuevoDocumento.Observaciones" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-ds-create btn-block"><i class="fa fa-save mr-2"></i>Registrar documento</button>
                </form>
            </div>
        </div>
    </div>
</div>
