@model Proyecto_Final.Models.ProfileEditViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Mi perfil"; }
<main class="djj-container djj-store-page djj-form-page"><partial name="~/Views/ClientPortal/_ClientPortalNav.cshtml" /><header class="djj-store-heading"><div class="djj-store-heading__copy"><span class="djj-page-header__eyebrow">Portal del cliente</span><h1>Mi perfil</h1><p>Actualizá tu información personal básica.</p></div></header><form asp-action="Edit" asp-controller="Profile" method="post" class="djj-card djj-standard-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-field"><label asp-for="NombreCompleto" class="djj-field__label"></label><input asp-for="NombreCompleto" class="djj-input" autocomplete="name" /><span asp-validation-for="NombreCompleto" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Correo" class="djj-field__label"></label><input asp-for="Correo" class="djj-input" autocomplete="email" /><span asp-validation-for="Correo" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Telefono" class="djj-field__label"></label><input asp-for="Telefono" class="djj-input" autocomplete="tel" /><span asp-validation-for="Telefono" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Direccion" class="djj-field__label"></label><textarea asp-for="Direccion" class="djj-textarea" rows="3" autocomplete="street-address"></textarea><span asp-validation-for="Direccion" class="djj-field__error"></span></div><div class="djj-form-actions"><a class="djj-button djj-button--ghost" asp-controller="ClientPortal" asp-action="Index">Volver</a><button class="djj-button djj-button--primary" type="submit">Guardar cambios</button></div></form></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
