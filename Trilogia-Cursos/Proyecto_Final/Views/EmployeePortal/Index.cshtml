@model Proyecto_Final.Models.Admin.EmployeePortalViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Mi portal de empleado"; var perfil = Model.Perfil!; string Tone(string state) => state switch { "Completada" or "Aprobada" => "success", "Rechazada" or "Cancelada" => "danger", "Pendiente" or "En proceso" => "warning", _ => "neutral" }; string PriorityTone(string priority) => priority is "Urgente" or "Alta" ? "danger" : priority == "Media" ? "warning" : "neutral"; }

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Autoservicio de personal</span><h1>Hola, @perfil.NombreCompleto</h1><p>@perfil.Puesto · @(perfil.Departamento ?? "Sin departamento")</p></div><div class="djj-page-header__actions"><a asp-controller="MyAttendance" asp-action="Index" class="djj-button djj-button--outline">Mis jornadas</a><a asp-controller="MyPaySlips" asp-action="Index" class="djj-button djj-button--outline">Mis boletas</a></div></header>

<section class="djj-kpi-grid djj-kpi-grid--four" aria-label="Resumen personal"><article class="djj-kpi-card"><span>Tareas</span><strong>@Model.Tareas.Count</strong><small>Asignadas a tu perfil</small></article><article class="djj-kpi-card"><span>Solicitudes</span><strong>@Model.Solicitudes.Count</strong><small>Historial propio</small></article><article class="djj-kpi-card"><span>Puesto</span><strong class="djj-kpi-card__compact">@perfil.Puesto</strong><small>@perfil.Rol</small></article><article class="djj-kpi-card"><span>Salario actual</span><strong class="djj-money djj-kpi-card__compact">₡@perfil.Salario.ToString("N2")</strong><small>Dato privado de tu expediente</small></article></section>

<div class="djj-hr-split djj-hr-split--balanced">
    <section class="djj-card" aria-labelledby="my-profile-title"><div class="djj-card__header"><div><h2 id="my-profile-title">Mi información</h2><p>Datos de contacto y responsabilidades registradas.</p></div></div><dl class="djj-detail-grid"><div><dt>Correo</dt><dd>@perfil.Correo</dd></div><div><dt>Teléfono</dt><dd>@(perfil.Telefono ?? "No indicado")</dd></div><div><dt>Responsabilidades</dt><dd>@(string.IsNullOrWhiteSpace(perfil.Responsabilidades) ? "Aún no hay responsabilidades registradas." : perfil.Responsabilidades)</dd></div></dl></section>
    <section class="djj-card" aria-labelledby="time-off-title"><div class="djj-card__header"><div><h2 id="time-off-title">Solicitar días libres</h2><p>La solicitud quedará pendiente de revisión administrativa.</p></div></div><form asp-action="RequestTimeOff" method="post" class="djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-alert djj-alert--danger" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="NuevaSolicitud.FechaInicio"></label><input asp-for="NuevaSolicitud.FechaInicio" name="FechaInicio" class="djj-input" type="date" /><span asp-validation-for="NuevaSolicitud.FechaInicio" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="NuevaSolicitud.FechaFin"></label><input asp-for="NuevaSolicitud.FechaFin" name="FechaFin" class="djj-input" type="date" /><span asp-validation-for="NuevaSolicitud.FechaFin" class="djj-field__error"></span></div></div><div class="djj-field"><label asp-for="NuevaSolicitud.TipoSolicitud"></label><select asp-for="NuevaSolicitud.TipoSolicitud" name="TipoSolicitud" class="djj-select"><option>Con goce salarial</option><option>Sin goce salarial</option></select></div><div class="djj-field"><label asp-for="NuevaSolicitud.Motivo"></label><textarea asp-for="NuevaSolicitud.Motivo" name="Motivo" class="djj-textarea" rows="4" maxlength="500"></textarea><span asp-validation-for="NuevaSolicitud.Motivo" class="djj-field__error"></span></div><button type="submit" class="djj-button djj-button--primary">Enviar solicitud</button></form></section>
</div>

<section class="djj-card djj-data-section" aria-labelledby="my-tasks-title"><header><div><h2 id="my-tasks-title">Mis tareas</h2><p>Actualizá el estado de cada actividad asignada.</p></div></header>@if (!Model.Tareas.Any()) { <div class="djj-empty-state"><h3>Sin tareas</h3><p>No tenés tareas asignadas.</p></div> } else { <ul class="djj-hr-list">@foreach (var tarea in Model.Tareas) { <li><div class="djj-hr-list__content"><div class="djj-cluster"><strong>@tarea.Titulo</strong><span class="djj-status-badge djj-status-badge--@PriorityTone(tarea.Prioridad)">Prioridad @tarea.Prioridad</span><span class="djj-status-badge djj-status-badge--@Tone(tarea.Estado)">@tarea.Estado</span></div><p>@(string.IsNullOrWhiteSpace(tarea.Descripcion) ? "Sin descripción." : tarea.Descripcion)</p>@if (tarea.FechaLimite.HasValue) { <small>Fecha límite: @tarea.FechaLimite.Value.ToString("dd/MM/yyyy")</small> }</div><form asp-action="UpdateMyTaskStatus" method="post" class="djj-inline-action">@Html.AntiForgeryToken()<input type="hidden" name="tareaId" value="@tarea.TareaId" /><label class="djj-sr-only" for="my-task-state-@tarea.TareaId">Estado de @tarea.Titulo</label><select id="my-task-state-@tarea.TareaId" name="estado" class="djj-select"><option selected="@(tarea.Estado == "Pendiente")">Pendiente</option><option selected="@(tarea.Estado == "En proceso")">En proceso</option><option selected="@(tarea.Estado == "Completada")">Completada</option></select><button type="submit" class="djj-button djj-button--outline djj-button--sm">Actualizar</button></form></li> }</ul> }</section>

<section class="djj-card djj-data-section" aria-labelledby="my-requests-title"><header><div><h2 id="my-requests-title">Mis solicitudes</h2><p>Seguimiento de los períodos solicitados y la respuesta administrativa.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Período</th><th>Tipo</th><th>Motivo</th><th>Estado</th><th>Respuesta</th></tr></thead><tbody>@if (!Model.Solicitudes.Any()) { <tr><td colspan="5"><div class="djj-empty-state"><h3>Sin solicitudes</h3><p>Todavía no registraste solicitudes.</p></div></td></tr> }@foreach (var item in Model.Solicitudes) { <tr><td class="djj-table__nowrap">@item.FechaInicio.ToString("dd/MM/yyyy") – @item.FechaFin.ToString("dd/MM/yyyy")</td><td>@item.TipoSolicitud</td><td>@item.Motivo</td><td><span class="djj-status-badge djj-status-badge--@Tone(item.Estado)">@item.Estado</span></td><td>@(string.IsNullOrWhiteSpace(item.RespuestaAdmin) ? "Pendiente de respuesta" : item.RespuestaAdmin)</td></tr> }</tbody></table></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
