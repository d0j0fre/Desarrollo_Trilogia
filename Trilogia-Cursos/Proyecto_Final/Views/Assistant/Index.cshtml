@{
    ViewData["Title"] = "Asistente virtual";
}

@section Styles {
    <style>
        .assistant-page {
            padding: 32px 0 55px;
            background: radial-gradient( circle at top right, rgba(190, 20, 35, .08), transparent 32% ), linear-gradient(180deg, #fafafa 0%, #f4f5f7 100%);
        }

        .assistant-container {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
        }

        /* Encabezado principal */

        .assistant-hero {
            position: relative;
            overflow: hidden;
            margin-bottom: 20px;
            padding: 28px 30px;
            color: #ffffff;
            background: linear-gradient( 120deg, #1d1012 0%, #401015 48%, #a50d1a 100% );
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 22px;
            box-shadow: 0 18px 45px rgba(65, 8, 15, .20);
        }

            .assistant-hero::before {
                position: absolute;
                top: -110px;
                right: -60px;
                width: 290px;
                height: 290px;
                content: "";
                background: rgba(255, 204, 68, .13);
                border-radius: 50%;
            }

            .assistant-hero::after {
                position: absolute;
                right: 160px;
                bottom: -100px;
                width: 210px;
                height: 210px;
                content: "";
                background: rgba(255, 255, 255, .06);
                border-radius: 50%;
            }

        .assistant-hero__content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .assistant-hero__icon {
            width: 68px;
            height: 68px;
            min-width: 68px;
            display: grid;
            place-items: center;
            color: #321012;
            background: linear-gradient(145deg, #ffe27b, #dba91e);
            border: 4px solid rgba(255, 255, 255, .16);
            border-radius: 21px;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .22);
            font-size: 29px;
        }

        .assistant-hero__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 6px;
            color: #f9d75d;
            font-size: .77rem;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .assistant-hero h1 {
            margin: 0 0 7px;
            color: #ffffff;
            font-size: clamp(1.65rem, 3vw, 2.25rem);
            font-weight: 800;
        }

        .assistant-hero p {
            max-width: 720px;
            margin: 0;
            color: rgba(255, 255, 255, .80);
            font-size: .98rem;
            line-height: 1.55;
        }

        /* Panel principal */

        .assistant-panel {
            overflow: hidden;
            background: #ffffff;
            border: 1px solid #e6e7ea;
            border-radius: 22px;
            box-shadow: 0 18px 50px rgba(25, 28, 35, .10);
        }

        .assistant-panel__header {
            min-height: 78px;
            padding: 15px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            background: linear-gradient( 90deg, #181818 0%, #242424 60%, #351216 100% );
            border-bottom: 3px solid #d6ad2d;
        }

        .assistant-identity {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .assistant-avatar {
            position: relative;
            width: 47px;
            height: 47px;
            min-width: 47px;
            display: grid;
            place-items: center;
            color: #2b1113;
            background: linear-gradient(145deg, #ffe17a, #d9a719);
            border-radius: 15px;
            font-size: 21px;
            box-shadow: 0 7px 18px rgba(0, 0, 0, .24);
        }

        .assistant-avatar__status {
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 13px;
            height: 13px;
            background: #37c975;
            border: 3px solid #222222;
            border-radius: 50%;
        }

        .assistant-identity__name {
            margin: 0;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
        }

        .assistant-identity__status {
            margin: 2px 0 0;
            color: rgba(255, 255, 255, .62);
            font-size: .77rem;
        }

        .assistant-data-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 11px;
            color: #ffe176;
            background: rgba(255, 255, 255, .07);
            border: 1px solid rgba(255, 225, 118, .24);
            border-radius: 999px;
            font-size: .76rem;
            font-weight: 700;
        }

        /* Conversación */

        .assistant-conversation {
            position: relative;
            height: min(55vh, 570px);
            min-height: 430px;
            overflow-y: auto;
            padding: 24px;
            background: radial-gradient( circle at 18px 18px, rgba(143, 13, 23, .035) 2px, transparent 2px ), #f5f6f8;
            background-size: 28px 28px;
            scroll-behavior: smooth;
        }

            .assistant-conversation::-webkit-scrollbar {
                width: 8px;
            }

            .assistant-conversation::-webkit-scrollbar-track {
                background: transparent;
            }

            .assistant-conversation::-webkit-scrollbar-thumb {
                background: #b6b8bd;
                border: 2px solid #f5f6f8;
                border-radius: 999px;
            }

        .assistant-message {
            display: flex;
            align-items: flex-end;
            gap: 9px;
            margin-bottom: 18px;
        }

            .assistant-message.user {
                justify-content: flex-end;
            }

            .assistant-message.bot {
                justify-content: flex-start;
            }

        .assistant-message__avatar {
            width: 31px;
            height: 31px;
            min-width: 31px;
            display: grid;
            place-items: center;
            color: #321012;
            background: #efc443;
            border-radius: 10px;
            font-size: 13px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, .12);
        }

        .assistant-bubble {
            max-width: min(74%, 680px);
            padding: 13px 15px;
            font-size: .91rem;
            line-height: 1.5;
            word-break: break-word;
            box-shadow: 0 6px 16px rgba(26, 29, 35, .08);
        }

        .assistant-message.bot .assistant-bubble {
            color: #242424;
            background: #ffffff;
            border: 1px solid #e2e4e8;
            border-radius: 17px 17px 17px 5px;
        }

        .assistant-message.user .assistant-bubble {
            color: #ffffff;
            background: linear-gradient( 135deg, #a70f1c 0%, #740b14 100% );
            border-radius: 17px 17px 5px 17px;
            box-shadow: 0 8px 20px rgba(139, 11, 23, .22);
        }

        .assistant-title {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 6px;
            color: #541017;
            font-weight: 800;
        }

        /* Botones rápidos */

        .assistant-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
        }

        .assistant-chip {
            min-height: 32px;
            padding: 6px 11px;
            color: #5b151a;
            background: #fff8e0;
            border: 1px solid #e8d692;
            border-radius: 999px;
            font-family: inherit;
            font-size: .77rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform .18s ease, color .18s ease, background .18s ease, border-color .18s ease;
        }

            .assistant-chip:hover,
            .assistant-chip:focus {
                color: #ffffff;
                background: #8f0d17;
                border-color: #8f0d17;
                outline: none;
                transform: translateY(-1px);
            }

        /* Formulario */

        .assistant-composer {
            padding: 17px 20px 19px;
            background: #ffffff;
            border-top: 1px solid #e3e4e7;
        }

        .assistant-composer__box {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 7px 7px 16px;
            background: #f7f7f8;
            border: 1px solid #d8dade;
            border-radius: 17px;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }

            .assistant-composer__box:focus-within {
                background: #ffffff;
                border-color: #c99b19;
                box-shadow: 0 0 0 4px rgba(209, 166, 38, .14);
            }

        .assistant-composer__icon {
            color: #909399;
            font-size: 15px;
        }

        .assistant-composer input {
            flex: 1;
            min-width: 0;
            padding: 9px 4px;
            color: #242424;
            background: transparent;
            border: none;
            outline: none;
            font-size: .93rem;
        }

            .assistant-composer input::placeholder {
                color: #999ca2;
            }

        .assistant-submit {
            min-width: 108px;
            min-height: 43px;
            padding: 9px 17px;
            color: #ffffff;
            background: linear-gradient( 135deg, #a90f1d, #770a13 );
            border: none;
            border-radius: 12px;
            font-size: .86rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 7px 16px rgba(131, 10, 21, .21);
            transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
        }

            .assistant-submit:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 22px rgba(131, 10, 21, .29);
            }

            .assistant-submit:disabled {
                cursor: not-allowed;
                opacity: .65;
                transform: none;
            }

        .assistant-composer__note {
            margin: 8px 3px 0;
            color: #8a8d93;
            font-size: .72rem;
        }

        @@media (max-width: 768px) {
            .assistant-page {
                padding-top: 18px;
            }

            .assistant-container {
                width: min(100% - 18px, 1120px);
            }

            .assistant-hero {
                padding: 22px 20px;
                border-radius: 18px;
            }

            .assistant-hero__content {
                align-items: flex-start;
            }

            .assistant-hero__icon {
                width: 54px;
                height: 54px;
                min-width: 54px;
                border-radius: 16px;
                font-size: 23px;
            }

            .assistant-data-badge {
                display: none;
            }

            .assistant-panel {
                border-radius: 18px;
            }

            .assistant-conversation {
                height: 58vh;
                min-height: 390px;
                padding: 17px 13px;
            }

            .assistant-bubble {
                max-width: 86%;
            }
        }

        @@media (max-width: 520px) {
            .assistant-hero__icon {
                display: none;
            }

            .assistant-panel__header {
                padding: 13px 15px;
            }

            .assistant-composer {
                padding: 12px;
            }

            .assistant-composer__box {
                align-items: stretch;
                flex-wrap: wrap;
                padding: 9px;
            }

            .assistant-composer__icon {
                display: none;
            }

            .assistant-composer input {
                width: 100%;
                flex-basis: 100%;
                padding: 9px;
            }

            .assistant-submit {
                width: 100%;
            }

            .assistant-bubble {
                max-width: 91%;
            }
        }
    </style>
}

<section class="assistant-page">
    <div class="assistant-container">

        <header class="assistant-hero">
            <div class="assistant-hero__content">

                <div class="assistant-hero__icon">
                    <i class="fa fa-robot"></i>
                </div>

                <div>
                    <span class="assistant-hero__eyebrow">
                        <i class="fa fa-sparkles"></i>
                        Asistencia inteligente
                    </span>

                    <h1>Asistente del negocio</h1>

                    <p>
                        Consulta indicadores de ventas, inventario, pedidos,
                        logística y personal, o solicita ayuda para utilizar
                        cualquiera de los módulos del sistema.
                    </p>
                </div>

            </div>
        </header>

        <section class="assistant-panel">

            <div class="assistant-panel__header">

                <div class="assistant-identity">

                    <div class="assistant-avatar">
                        <i class="fa fa-robot"></i>
                        <span class="assistant-avatar__status"></span>
                    </div>

                    <div>
                        <p class="assistant-identity__name">
                            Asistente virtual
                        </p>

                        <p class="assistant-identity__status">
                            Disponible para ayudarte
                        </p>
                    </div>

                </div>

                <span class="assistant-data-badge">
                    <i class="fa fa-database"></i>
                    Conectado a los datos del sistema
                </span>

            </div>

            @Html.AntiForgeryToken()

            <div id="assistantWindow"
                 class="assistant-conversation"
                 aria-live="polite">
            </div>

            <form id="assistantForm"
                  class="assistant-composer">

                <div class="assistant-composer__box">

                    <i class="fa fa-comment-dots assistant-composer__icon"></i>

                    <input type="text"
                           id="assistantInput"
                           autocomplete="off"
                           maxlength="500"
                           aria-label="Pregunta para el asistente"
                           placeholder="Escribe una consulta sobre el negocio o un módulo..." />

                    <button type="submit"
                            id="assistantSubmit"
                            class="assistant-submit">

                        <i class="fa fa-paper-plane mr-1"></i>
                        Enviar
                    </button>

                </div>

                <p class="assistant-composer__note">
                    Las respuestas y métricas disponibles dependen de los
                    permisos asignados a tu rol.
                </p>

            </form>

        </section>
    </div>
</section>

@section Scripts {
    <script>
        (function() {
            const askUrl = '@Url.Action("Ask", "Assistant")';

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value || '';

            const windowElement =
                document.getElementById('assistantWindow');

            const form =
                document.getElementById('assistantForm');

            const input =
                document.getElementById('assistantInput');

            const submitButton =
                document.getElementById('assistantSubmit');

            let lastMetricIntent = '';

            function escapeHtml(value) {
                const element = document.createElement('div');
                element.textContent = value ?? '';
                return element.innerHTML;
            }

            function scrollToBottom() {
                windowElement.scrollTop =
                    windowElement.scrollHeight;
            }

            function addUserMessage(text) {
                windowElement.insertAdjacentHTML(
                    'beforeend',
                    `
                            <div class="assistant-message user">
                                <div class="assistant-bubble">
                                    ${escapeHtml(text)}
                                </div>
                            </div>
                            `
                );

                scrollToBottom();
            }

            function sanitizeAssistantHtml(value) {
                const template = document.createElement('template');
                template.innerHTML = value ?? '';
                const allowedTags = new Set(['STRONG', 'BR', 'EM', 'UL', 'LI']);

                template.content.querySelectorAll('*').forEach(function(element) {
                    if (!allowedTags.has(element.tagName)) {
                        element.replaceWith(document.createTextNode(element.textContent || ''));
                        return;
                    }

                    Array.from(element.attributes).forEach(function(attribute) {
                        element.removeAttribute(attribute.name);
                    });
                });

                return template.innerHTML;
            }

            function addBotMessage(title, html, suggestions) {
                const chips = (suggestions || [])
                    .map(function(suggestion) {
                        return `
                                    <button type="button"
                                            class="assistant-chip"
                                            data-question="${escapeHtml(suggestion)}">
                                        ${escapeHtml(suggestion)}
                                    </button>
                                `;
                    })
                    .join('');

                const heading = title
                    ? `
                                <span class="assistant-title">
                                    <i class="fa fa-sparkles"></i>
                                    ${escapeHtml(title)}
                                </span>
                              `
                    : '';

                windowElement.insertAdjacentHTML(
                    'beforeend',
                    `
                            <div class="assistant-message bot">

                                <span class="assistant-message__avatar">
                                    <i class="fa fa-robot"></i>
                                </span>

                                <div class="assistant-bubble">
                                    ${heading}
                                    ${sanitizeAssistantHtml(html)}

                                    ${chips
                        ? `
                                            <div class="assistant-suggestions">
                                                ${chips}
                                            </div>
                                          `
                        : ''}
                                </div>

                            </div>
                            `
                );

                scrollToBottom();
            }

            function setLoading(isLoading) {
                input.disabled = isLoading;
                submitButton.disabled = isLoading;

                submitButton.innerHTML = isLoading
                    ? `
                                <i class="fa fa-spinner fa-spin mr-1"></i>
                                Procesando
                              `
                    : `
                                <i class="fa fa-paper-plane mr-1"></i>
                                Enviar
                              `;
            }

            async function sendQuestion(text) {
                const body = new URLSearchParams();

                body.append('pregunta', text);
                body.append('contexto', lastMetricIntent);
                body.append(
                    '__RequestVerificationToken',
                    token
                );

                setLoading(true);

                try {
                    const response = await fetch(
                        askUrl,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded'
                            },
                            body: body
                        }
                    );

                    if (!response.ok) {
                        throw new Error(
                            `HTTP ${response.status}`
                        );
                    }

                    const data = await response.json();

                    if (!data.ok) {
                        addBotMessage(
                            'No fue posible responder',
                            escapeHtml(
                                data.message ||
                                'Ocurrió un error inesperado.'
                            ),
                            []
                        );

                        return;
                    }

                    addBotMessage(
                        data.titulo,
                        data.respuesta,
                        data.sugerencias
                    );

                    if (data.tipo === 'metrica') {
                        lastMetricIntent = data.intent;
                    }
                } catch (error) {
                    console.error(
                        'Error consultando el asistente:',
                        error
                    );

                    addBotMessage(
                        'Sin conexión',
                        'No fue posible comunicarse con el asistente.',
                        []
                    );
                } finally {
                    setLoading(false);
                    input.focus();
                }
            }

            form.addEventListener(
                'submit',
                async function(event) {
                    event.preventDefault();

                    const text =
                        (input.value || '').trim();

                    if (!text) {
                        return;
                    }

                    addUserMessage(text);
                    input.value = '';

                    await sendQuestion(text);
                }
            );

            windowElement.addEventListener(
                'click',
                function(event) {
                    const chip =
                        event.target.closest('.assistant-chip');

                    if (!chip) {
                        return;
                    }

                    input.value =
                        chip.getAttribute('data-question') || '';

                    form.requestSubmit();
                }
            );

            addBotMessage(
                '¡Hola! ¿En qué puedo ayudarte?',
                `
                            Puedo consultar métricas del negocio y explicarte
                            cómo utilizar los diferentes módulos del sistema.
                            Selecciona una opción o escribe tu propia pregunta.
                        `,
                [
                    '¿Qué puedo preguntar?',
                    'Dame un resumen',
                    '¿Cuánto vendimos este mes?',
                    '¿Cómo está el inventario?',
                    '¿Cómo uso el módulo de rutas?'
                ]
            );

            input.focus();
        })();
    </script>
}
