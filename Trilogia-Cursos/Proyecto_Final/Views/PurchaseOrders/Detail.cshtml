@model Proyecto_Final.Models.Admin.PurchaseOrderDetailViewModel
@using Proyecto_Final.Models.Admin
@{ Layout="_WorkspaceLayout"; ViewData["Title"]=$"Orden #{Model.OrdenCompraId}"; string Tone(string status)=>status switch{PurchaseOrderStatus.Received=>"success",PurchaseOrderStatus.PartiallyReceived=>"warning",PurchaseOrderStatus.ClosedWithDiscrepancy=>"danger",PurchaseOrderStatus.Cancelled=>"neutral",_=>"info"}; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Compras · Recepción</span><h1>Orden #@Model.OrdenCompraId</h1><p>Proveedor: <strong>@Model.ProveedorNombre</strong></p></div><div class="djj-page-header__actions"><span class="djj-badge djj-badge--@Tone(Model.Estado)">@Model.Estado</span><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
@if(!string.IsNullOrWhiteSpace(Model.MotivoCierre)){<div class="djj-alert djj-alert--warning" role="status"><strong>Motivo de cierre:</strong> @Model.MotivoCierre</div>}
<section class="djj-card djj-data-section" aria-labelledby="receipt-lines"><header><div><h2 id="receipt-lines">Recepción de productos</h2><p>Compará lo ordenado, recibido y pendiente.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Ordenado</th><th class="djj-align-right">Recibido</th><th class="djj-align-right">Pendiente</th><th class="djj-align-right">Precio</th><th>Recepción</th></tr></thead><tbody>@foreach(var line in Model.Lineas){var tone=line.Pendiente==0?"success":"warning";<tr><td><strong>@line.ProductoNombre</strong></td><td class="djj-align-right">@line.CantidadOrdenada</td><td class="djj-align-right">@line.CantidadRecibida</td><td class="djj-align-right"><span class="djj-badge djj-badge--@tone">@line.Pendiente</span></td><td class="djj-align-right">₡@line.PrecioUnitario.ToString("N2")</td><td>@if(Model.PermiteRecepcion&&line.Pendiente>0){<form asp-action="Receive" method="post" class="djj-inline-action">@Html.AntiForgeryToken()<input type="hidden" name="OrdenCompraId" value="@Model.OrdenCompraId" /><input type="hidden" name="DetalleOrdenCompraId" value="@line.DetalleOrdenCompraId" /><input type="hidden" name="TokenOperacion" value="@Guid.NewGuid()" /><label class="djj-sr-only" for="receive-@line.DetalleOrdenCompraId">Cantidad a recibir de @line.ProductoNombre</label><input id="receive-@line.DetalleOrdenCompraId" type="number" name="CantidadRecibidaAhora" min="1" max="@line.Pendiente" value="@line.Pendiente" class="djj-input djj-line-input" /><button class="djj-button djj-button--success djj-button--sm">Recibir</button></form>}else{<span class="djj-page-header__meta">No disponible</span>}</td></tr>}</tbody></table></div></section>
@if(Model.PermiteCerrarConDiscrepancia||Model.PermiteCancelar){<section class="djj-card djj-workspace-form djj-workspace-form--narrow"><div class="djj-card__header"><div><h2>Finalizar sin recibir todo</h2><p>El motivo queda auditado; las unidades faltantes no ingresan al inventario.</p></div></div><form asp-action="@(Model.PermiteCancelar?"Cancel":"CloseWithDiscrepancy")" method="post" class="djj-workspace-form" data-djj-confirm="Finalizar la orden #@Model.OrdenCompraId con unidades pendientes. El motivo quedará auditado.">@Html.AntiForgeryToken()<input type="hidden" name="OrdenCompraId" value="@Model.OrdenCompraId" /><input type="hidden" name="TokenOperacion" value="@Guid.NewGuid()" /><div class="djj-field"><label for="purchase-reason">Motivo</label><textarea id="purchase-reason" name="Motivo" minlength="10" maxlength="500" required class="djj-textarea"></textarea></div><button class="djj-button @(Model.PermiteCancelar?"djj-button--danger":"djj-button--outline")">@(Model.PermiteCancelar?"Cancelar orden":"Cerrar con discrepancia")</button></form></section>}
