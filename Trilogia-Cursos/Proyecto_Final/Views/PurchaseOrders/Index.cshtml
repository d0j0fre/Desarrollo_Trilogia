@model List<Proyecto_Final.Models.Admin.PurchaseOrderListItemViewModel>
@{
    ViewData["Title"] = "Órdenes de compra";
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h2 class="mb-2">Órdenes de compra</h2>
                <p>Registro y seguimiento de compras a proveedores (CU-102).</p>
            </div>
            <a asp-controller="PurchaseOrders" asp-action="Suggestions" class="btn btn-outline-primary mr-2"><i class="fa fa-lightbulb mr-1"></i>Sugerencias de compra</a>
            <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-primary"><i class="fa fa-plus mr-1"></i>Nueva orden</a>
        </div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-12">
            <div class="admin-table-wrapper">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>#</th>
                                <th>Proveedor</th>
                                <th>Estado</th>
                                <th class="text-right">Monto total</th>
                                <th class="text-center">Recibido / Ordenado</th>
                                <th>Fecha</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">No hay órdenes de compra registradas.</td></tr>
                            }
                            else
                            {
                                @foreach (var o in Model)
                                {
                                    var badge = o.Estado switch
                                    {
                                        "Recibida" => "success",
                                        "RecibidaParcial" => "warning",
                                        "ConDiscrepancia" => "danger",
                                        _ => "secondary"
                                    };
                                    <tr>
                                        <td>@o.OrdenCompraId</td>
                                        <td>@o.ProveedorNombre</td>
                                        <td><span class="admin-badge-soft @badge">@o.Estado</span></td>
                                        <td class="text-right">₡@o.MontoTotal.ToString("N2")</td>
                                        <td class="text-center">@o.TotalRecibido / @o.TotalOrdenado</td>
                                        <td>@o.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                        <td class="text-right">
                                            <a asp-controller="PurchaseOrders" asp-action="Detail" asp-route-id="@o.OrdenCompraId" class="btn btn-sm btn-outline-primary">Ver</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>