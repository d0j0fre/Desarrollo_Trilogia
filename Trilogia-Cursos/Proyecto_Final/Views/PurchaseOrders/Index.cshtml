@model IReadOnlyList<Proyecto_Final.Models.Admin.PurchaseOrderListItemViewModel>
@using Proyecto_Final.Models.Admin
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Órdenes de compra"; var suppliers=ViewBag.Proveedores as IReadOnlyList<SupplierListItemViewModel>??[]; string Tone(string status)=>status switch{PurchaseOrderStatus.Received=>"success",PurchaseOrderStatus.PartiallyReceived=>"warning",PurchaseOrderStatus.ClosedWithDiscrepancy=>"danger",PurchaseOrderStatus.Cancelled=>"neutral",_=>"info"}; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Compras · Órdenes</span><h1>Órdenes de compra</h1><p>Seguimiento de abastecimiento, recepción y discrepancias.</p></div><div class="djj-page-header__actions"><a class="djj-button djj-button--outline" asp-action="Suggestions">Sugerencias</a><a class="djj-button djj-button--primary" asp-action="Create">Nueva orden</a></div></header>
<nav class="djj-domain-nav" aria-label="Secciones de compras"><a asp-controller="Suppliers" asp-action="Index">Proveedores</a><a aria-current="page" asp-action="Index">Órdenes</a><a asp-controller="PriceHistory" asp-action="Index">Histórico de precios</a></nav>
<section class="djj-card djj-filter-card"><form method="get" class="djj-filter-bar"><div class="djj-field"><label for="purchase-status">Estado</label><select id="purchase-status" name="estado" class="djj-select"><option value="">Todos</option>@foreach(var state in new[]{PurchaseOrderStatus.Pending,PurchaseOrderStatus.PartiallyReceived,PurchaseOrderStatus.Received,PurchaseOrderStatus.ClosedWithDiscrepancy,PurchaseOrderStatus.Cancelled}){<option value="@state" selected="@(ViewBag.Estado==state)">@state</option>}</select></div><div class="djj-field"><label for="purchase-supplier">Proveedor</label><select id="purchase-supplier" name="proveedorId" class="djj-select"><option value="">Todos</option>@foreach(var supplier in suppliers){<option value="@supplier.ProveedorId" selected="@(ViewBag.ProveedorId==supplier.ProveedorId)">@supplier.Nombre</option>}</select></div><button class="djj-button djj-button--outline">Filtrar</button></form></section>
<section class="djj-card djj-data-section">@if(!Model.Any()){<div class="djj-empty-state"><h3>Sin órdenes</h3><p>No hay órdenes para los filtros seleccionados.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Orden</th><th>Proveedor</th><th>Estado</th><th class="djj-align-right">Monto</th><th class="djj-align-right">Recibido</th><th>Fecha</th><th>Acción</th></tr></thead><tbody>@foreach(var order in Model){<tr><td><strong>#@order.OrdenCompraId</strong></td><td>@order.ProveedorNombre</td><td><span class="djj-badge djj-badge--@Tone(order.Estado)">@order.Estado</span></td><td class="djj-align-right">₡@order.MontoTotal.ToString("N2")</td><td class="djj-align-right">@order.TotalRecibido / @order.TotalOrdenado</td><td>@order.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td><a class="djj-button djj-button--outline djj-button--sm" asp-action="Detail" asp-route-id="@order.OrdenCompraId">Ver detalle</a></td></tr>}</tbody></table></div>}</section>
