@model Proyecto_Final.Models.Admin.PurchaseOrderFormViewModel
@{
    var fromSuggestions = Model.DesdeSugerencias;
    ViewData["Title"] = fromSuggestions ? "Sugerencias de compra" : "Nueva orden de compra";
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5"><div class="col-12">
        <h2>@ViewData["Title"]</h2>
        <p>@(fromSuggestions ? "Revise cantidades sugeridas y defina precios; ninguna compra se crea automáticamente." : "Seleccione proveedor, productos, cantidades y precios de compra.")</p>
    </div></div>
    <div class="row px-xl-5 pb-5"><div class="col-12">
        @if (fromSuggestions)
        {
            @* BUG-24-02: mismos parámetros y mismo cálculo que Inteligencia de inventario. *@
            <form asp-action="Suggestions" method="get" class="form-inline mb-3">
                <label class="mr-2" for="recentMonths">Meses para promedio</label>
                <input id="recentMonths" name="recentMonths" type="number" min="1" max="12" value="@Model.MesesPromedio" class="form-control form-control-sm mr-3" style="width:80px" />
                <label class="mr-2" for="coverageMonths">Meses de cobertura</label>
                <input id="coverageMonths" name="coverageMonths" type="number" min="1" max="12" value="@Model.MesesCobertura" class="form-control form-control-sm mr-3" style="width:80px" />
                <button type="submit" class="btn btn-ds-edit btn-sm"><i class="fa fa-sync mr-1"></i>Actualizar</button>
                <small class="text-muted ml-3">Mismo cálculo que Inteligencia de inventario.</small>
            </form>
        }
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="TokenOperacion" type="hidden" />
            <input asp-for="DesdeSugerencias" type="hidden" />
            <input asp-for="MesesPromedio" type="hidden" />
            <input asp-for="MesesCobertura" type="hidden" />
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            @if (fromSuggestions && !Model.Productos.Any())
            {
                <div class="alert alert-info">Ningún producto necesita reabastecerse con estos parámetros: el inventario cubre la demanda estimada. Para comprar de todos modos, use <a asp-action="Create">Nueva orden de compra</a>.</div>
            }
            <div class="form-row">
                <div class="form-group col-md-5"><label asp-for="ProveedorId">Proveedor activo</label><select asp-for="ProveedorId" class="form-control"><option value="">Seleccione</option>@foreach (var supplier in Model.Proveedores) { <option value="@supplier.ProveedorId">@supplier.Nombre</option> }</select><span asp-validation-for="ProveedorId" class="text-danger"></span></div>
                <div class="form-group col-md-7"><label asp-for="Notas"></label><input asp-for="Notas" class="form-control" /></div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead><tr><th></th><th>Producto</th><th>Stock</th><th>Promedio mensual</th><th>Cantidad</th><th>Precio compra</th><th>Último precio</th><th>Subtotal</th></tr></thead>
                    <tbody>
                    @for (var index = 0; index < Model.Productos.Count; index++)
                    {
                        <tr class="purchase-line">
                            <td><input asp-for="Productos[index].ProductoId" type="hidden" /><input asp-for="Productos[index].Nombre" type="hidden" /><input asp-for="Productos[index].StockActual" type="hidden" /><input asp-for="Productos[index].PromedioVentaMensual" type="hidden" /><input asp-for="Productos[index].DatosInsuficientes" type="hidden" /><input asp-for="Productos[index].Seleccionado" class="select-product" /></td>
                            <td>@Model.Productos[index].Nombre @if (Model.Productos[index].DatosInsuficientes) { <small class="d-block text-muted">Datos insuficientes: ingrese la cantidad manualmente</small> }</td>
                            <td>@Model.Productos[index].StockActual</td><td>@Model.Productos[index].PromedioVentaMensual.ToString("N2")</td>
                            <td><input asp-for="Productos[index].Cantidad" type="number" min="1" value="@(Model.Productos[index].Cantidad > 0 ? Model.Productos[index].Cantidad.ToString() : "")" class="form-control form-control-sm quantity" style="width:90px" />@if (fromSuggestions && !Model.Productos[index].DatosInsuficientes) { <small class="d-block text-muted">Sugerido: @Model.Productos[index].CantidadSugerida</small> }</td>
                            <td><input asp-for="Productos[index].PrecioUnitario" type="number" min="0.01" step="0.01" class="form-control form-control-sm price" data-last="@(Model.Productos[index].UltimoPrecioPagado?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" style="width:130px" /><small class="price-warning text-danger"></small></td>
                            <td>@(Model.Productos[index].UltimoPrecioPagado.HasValue ? $"₡{Model.Productos[index].UltimoPrecioPagado:N2}" : "—")</td><td class="line-total">₡0.00</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr><th colspan="7" class="text-right">Total</th><th id="order-total">₡0.00</th></tr></tfoot>
                </table>
            </div>
            <div class="d-flex justify-content-between"><a asp-action="Index" class="btn btn-ds-neutral">Volver</a><button type="submit" class="btn btn-ds-create">Crear orden</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const money = value => `₡${value.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            function recalculate() {
                let total = 0;
                document.querySelectorAll('.purchase-line').forEach(row => {
                    const selected = row.querySelector('.select-product').checked;
                    const quantity = Number(row.querySelector('.quantity').value) || 0;
                    row.querySelector('.quantity').required = selected;
                    const priceInput = row.querySelector('.price');
                    const price = Number(priceInput.value) || 0;
                    const subtotal = selected ? quantity * price : 0;
                    row.querySelector('.line-total').textContent = money(subtotal); total += subtotal;
                    const previous = Number(priceInput.dataset.last);
                    const variation = previous > 0 ? ((price - previous) / previous) * 100 : 0;
                    row.querySelector('.price-warning').textContent = selected && Math.abs(variation) > 15 ? `${variation.toFixed(1)}% vs. último precio` : '';
                });
                document.getElementById('order-total').textContent = money(total);
            }
            document.querySelectorAll('.purchase-line input').forEach(input => input.addEventListener('input', recalculate)); recalculate();
        })();

        // Antes de enviar, deshabilita los campos de productos no seleccionados para no superar el límite de campos del formulario
        document.querySelector('form').addEventListener('submit', () => {
            document.querySelectorAll('.purchase-line').forEach(row => {
                if (!row.querySelector('.select-product').checked) {
                    row.querySelectorAll('input:not(.select-product)').forEach(input => input.disabled = true);
                }
            });
        });
    </script>
}
