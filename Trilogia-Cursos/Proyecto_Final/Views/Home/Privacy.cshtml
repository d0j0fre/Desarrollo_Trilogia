@{ Layout = "_StorefrontLayout"; ViewData["Title"] = "Privacidad"; }
@section Styles { <link rel="stylesheet" href="~/css/stage2/public-surfaces.css" asp-append-version="true" /> }
<div class="djj-container djj-public-page djj-public-prose">
    <header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Información del sitio</span><h1>Privacidad</h1><p>Contenido pendiente de aprobación.</p></div></header>
    <section class="djj-card" aria-labelledby="privacy-pending"><h2 id="privacy-pending">Política aún no publicada</h2><p>El contenido definitivo requiere aprobación del responsable del proyecto. Esta página no constituye una política de privacidad.</p><div class="djj-surface-actions"><a asp-controller="Home" asp-action="Contact" class="djj-button djj-button--primary">Ir a contacto</a><a asp-controller="Home" asp-action="Index" class="djj-button djj-button--ghost">Ir al inicio</a></div></section>
</div>
