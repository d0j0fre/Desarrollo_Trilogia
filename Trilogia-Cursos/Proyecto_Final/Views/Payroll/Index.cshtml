@using Microsoft.AspNetCore.Http
@model Proyecto_Final.Models.Admin.PayrollIndexViewModel
@inject IRolePermissionService PermissionService
@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "Planilla configurable";
    var calculations = Model?.Calculos ?? new List<Proyecto_Final.Models.Admin.PayrollListItemViewModel>();
    var rule = Model?.Regla ?? new Proyecto_Final.Models.Admin.PayrollRuleFormViewModel();
    var period = Model?.Periodo ?? new Proyecto_Final.Models.Admin.PayrollPeriodFormViewModel();
    var calculation = Model?.Calculo ?? new Proyecto_Final.Models.Admin.PayrollCalculationRequestViewModel();
    var role = Context.Session.GetString("UserRole") ?? string.Empty;
    var isAdmin = string.Equals(role, "Administrador", StringComparison.OrdinalIgnoreCase);
    var permissions = isAdmin ? new HashSet<string>(StringComparer.OrdinalIgnoreCase) : await PermissionService.GetPermissionCodesAsync(role);
    bool Can(string code) => isAdmin || permissions.Contains(code);
    string Tone(string state) => state switch { "Aprobada" or "Pagada" => "success", "Revertida" => "danger", "Borrador" => "warning", _ => "neutral" };
}

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Personal · Planilla</span><h1>Planilla configurable</h1><p>Configurá reglas y períodos con trazabilidad, calculá y gestioná cada resultado según tu permiso.</p></div><div class="djj-page-header__actions">@if (Can("PLANILLA_BOLETAS_GESTIONAR")) { <a asp-controller="PaySlips" asp-action="Index" class="djj-button djj-button--outline">Gestionar boletas</a> }</div></header>
<div class="djj-alert djj-alert--warning" role="note"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-shield"></use></svg><div><strong>Configuración verificable</strong><p>Las tasas legales no están precargadas. Cada factor y regla requiere una fuente o aprobación responsable.</p></div></div>

<section class="djj-payroll-config" aria-label="Configuración y cálculo de planilla">
@if (Can("PLANILLA_CONFIGURAR"))
{
    <article class="djj-card"><div class="djj-card__header"><div><h2>Regla versionada</h2><p>Definí un ingreso o deducción con vigencia y evidencia.</p></div></div><form asp-action="ConfigureRule" method="post" class="djj-workspace-form" data-prevent-double-submit>@Html.AntiForgeryToken()<div class="djj-form-grid"><div class="djj-field"><label for="rule-code">Código</label><input id="rule-code" name="Codigo" value="@rule.Codigo" class="djj-input" maxlength="50" pattern="[A-Z0-9_]+" required /></div><div class="djj-field"><label for="rule-name">Nombre</label><input id="rule-name" name="Nombre" value="@rule.Nombre" class="djj-input" maxlength="150" required /></div><div class="djj-field"><label for="rule-type">Tipo</label><select id="rule-type" name="Tipo" class="djj-select" required><option value="Ingreso" selected="@(rule.Tipo == "Ingreso")">Ingreso</option><option value="Deduccion" selected="@(rule.Tipo == "Deduccion")">Deducción</option></select></div><div class="djj-field"><label for="rule-calculation">Cálculo</label><select id="rule-calculation" name="TipoCalculo" class="djj-select" required><option value="MontoFijo" selected="@(rule.TipoCalculo == "MontoFijo")">Monto fijo</option><option value="PorcentajeSalario" selected="@(rule.TipoCalculo == "PorcentajeSalario")">Porcentaje de salario</option><option value="PorHoraExtra" selected="@(rule.TipoCalculo == "PorHoraExtra")">Por hora extra</option><option value="PorcentajeBruto" selected="@(rule.TipoCalculo == "PorcentajeBruto")">Porcentaje bruto</option></select></div><div class="djj-field"><label for="rule-value">Valor</label><input id="rule-value" name="Valor" value="@rule.Valor.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="djj-input djj-number" inputmode="decimal" min="0" max="99999999" step="0.000001" required /><p class="djj-field__hint">Acepta punto o coma decimal.</p></div><div class="djj-field"><label for="rule-cap">Tope opcional</label><input id="rule-cap" name="Tope" value="@(rule.Tope?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="djj-input djj-money" inputmode="decimal" min="0" max="99999999" step="0.01" /></div><div class="djj-field"><label for="rule-from">Vigente desde</label><input id="rule-from" name="VigenteDesde" value="@(rule.VigenteDesde == default ? null : rule.VigenteDesde.ToString("yyyy-MM-dd"))" type="date" class="djj-input" required /></div><div class="djj-field"><label for="rule-to">Vigente hasta</label><input id="rule-to" name="VigenteHasta" value="@rule.VigenteHasta?.ToString("yyyy-MM-dd")" type="date" class="djj-input" /></div><div class="djj-field djj-form-grid__full"><label for="rule-source">Fuente o aprobación</label><textarea id="rule-source" name="Fuente" class="djj-textarea" maxlength="500" required>@rule.Fuente</textarea></div></div><button class="djj-button djj-button--primary" type="submit">Guardar regla</button><p class="djj-form-status" aria-live="polite"></p></form></article>
}
@if (Can("PLANILLA_GESTIONAR"))
{
    <article class="djj-card"><div class="djj-card__header"><div><h2>Crear período</h2><p>Abrí un período de hasta 31 días con factor documentado.</p></div></div><form asp-action="CreatePeriod" method="post" class="djj-workspace-form" data-prevent-double-submit>@Html.AntiForgeryToken()<div class="djj-form-grid"><div class="djj-field djj-form-grid__full"><label for="period-type">Frecuencia</label><select id="period-type" name="Tipo" class="djj-select" required><option value="Quincenal" selected="@(period.Tipo == "Quincenal")">Quincenal</option><option value="Mensual" selected="@(period.Tipo == "Mensual")">Mensual</option></select></div><div class="djj-field"><label for="period-from">Desde</label><input id="period-from" name="Desde" value="@(period.Desde == default ? null : period.Desde.ToString("yyyy-MM-dd"))" type="date" class="djj-input" required /></div><div class="djj-field"><label for="period-to">Hasta</label><input id="period-to" name="Hasta" value="@(period.Hasta == default ? null : period.Hasta.ToString("yyyy-MM-dd"))" type="date" class="djj-input" required /></div><div class="djj-field djj-form-grid__full"><label for="salary-factor">Factor salarial</label><input id="salary-factor" name="FactorSalario" value="@period.FactorSalario.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="djj-input djj-number" inputmode="decimal" min="0.000001" max="1" step="0.000001" required /><p class="djj-field__hint">Mayor que 0 y menor o igual que 1.</p></div><div class="djj-field djj-form-grid__full"><label for="factor-source">Fuente o aprobación del factor</label><textarea id="factor-source" name="FuenteConfiguracion" class="djj-textarea" maxlength="500" required>@period.FuenteConfiguracion</textarea></div></div><button class="djj-button djj-button--primary" type="submit">Crear período</button><p class="djj-form-status" aria-live="polite"></p></form></article>
}
@if (Can("PLANILLA_CALCULAR"))
{
    <article class="djj-card"><div class="djj-card__header"><div><h2>Calcular empleado</h2><p>Usá los identificadores vigentes y comisiones confirmadas.</p></div></div><form asp-action="Calculate" method="post" class="djj-workspace-form" data-prevent-double-submit>@Html.AntiForgeryToken()<input type="hidden" name="IdempotencyKey" value="@calculation.IdempotencyKey" /><div class="djj-field"><label for="period-id">ID del período</label><input id="period-id" name="PeriodoId" value="@(calculation.PeriodoId > 0 ? calculation.PeriodoId : null)" type="number" class="djj-input" min="1" step="1" required /></div><div class="djj-field"><label for="employee-id">ID del empleado</label><input id="employee-id" name="EmpleadoId" value="@(calculation.EmpleadoId > 0 ? calculation.EmpleadoId : null)" type="number" class="djj-input" min="1" step="1" required /></div><div class="djj-field"><label for="commission">Comisiones confirmadas</label><input id="commission" name="Comisiones" value="@calculation.Comisiones.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="djj-input djj-money" inputmode="decimal" min="0" max="99999999" step="0.01" required /><p class="djj-field__hint">Ingresá 0 cuando no existan comisiones.</p></div><button class="djj-button djj-button--neutral" type="submit">Calcular planilla</button><p class="djj-form-status" aria-live="polite"></p></form></article>
}
</section>

<section class="djj-card djj-data-section" aria-labelledby="payroll-results-title"><header><div><h2 id="payroll-results-title">Cálculos registrados</h2><p>Las transiciones disponibles respetan el estado y los permisos específicos.</p></div><span class="djj-page-header__meta">@calculations.Count registro(s)</span></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Período</th><th>Empleado</th><th class="djj-align-right">Bruto</th><th class="djj-align-right">Deducciones</th><th class="djj-align-right">Neto</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@if (!calculations.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin cálculos</h3><p>No hay resultados de planilla registrados.</p></div></td></tr> }
@foreach (var item in calculations) { var status = item.Estado?.Trim() ?? string.Empty; <tr><td>@(string.IsNullOrWhiteSpace(item.Periodo) ? "Sin período" : item.Periodo)</td><td>@(string.IsNullOrWhiteSpace(item.Empleado) ? "Empleado no disponible" : item.Empleado)</td><td class="djj-align-right">₡@item.TotalBruto.ToString("N2")</td><td class="djj-align-right">₡@item.TotalDeducciones.ToString("N2")</td><td class="djj-align-right"><strong>₡@item.TotalNeto.ToString("N2")</strong></td><td><span class="djj-status-badge djj-status-badge--@Tone(status)">@(string.IsNullOrWhiteSpace(status) ? "Sin estado" : status)</span></td><td><div class="djj-payroll-actions">@if (status == "Borrador" && Can("PLANILLA_APROBAR")) { <form asp-action="Approve" method="post" data-djj-confirm="Aprobar el cálculo #@item.CalculoId de @item.Empleado por un neto de ₡@item.TotalNeto.ToString("N2").">@Html.AntiForgeryToken()<input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" /><button class="djj-button djj-button--success djj-button--sm">Aprobar</button></form> }@if (status == "Aprobada" && Can("PLANILLA_PAGAR")) { <form asp-action="Pay" method="post" data-djj-confirm="Marcar como pagado el cálculo #@item.CalculoId de @item.Empleado por ₡@item.TotalNeto.ToString("N2").">@Html.AntiForgeryToken()<input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" /><button class="djj-button djj-button--primary djj-button--sm">Marcar pagada</button></form> }@if ((status is "Aprobada" or "Pagada") && Can("PLANILLA_REVERTIR")) { <form asp-action="Revert" method="post" class="djj-inline-action" data-djj-confirm="Revertir el cálculo #@item.CalculoId de @item.Empleado. El motivo quedará asociado al cambio de estado.">@Html.AntiForgeryToken()<input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" /><label class="djj-sr-only" for="reason-@item.CalculoId">Motivo de reversión</label><input id="reason-@item.CalculoId" name="Motivo" class="djj-input djj-payroll-reason" maxlength="500" required placeholder="Motivo de reversión" /><button class="djj-button djj-button--danger-outline djj-button--sm">Revertir</button></form> }</div></td></tr> }
</tbody></table></div></section>

@section Scripts { <script>document.querySelectorAll('[data-prevent-double-submit]').forEach(function(form){form.addEventListener('submit',function(){if(!form.checkValidity())return;var button=form.querySelector('button[type="submit"]');var status=form.querySelector('.djj-form-status');if(button){button.disabled=true;button.setAttribute('aria-busy','true');button.textContent='Procesando…';}if(status)status.textContent='La solicitud se está enviando…';});});</script> }
