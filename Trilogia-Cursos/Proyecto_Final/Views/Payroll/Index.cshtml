@model Proyecto_Final.Models.Admin.PayrollIndexViewModel
@{ ViewData["Title"] = "Planilla configurable"; }
<div class="container py-4">
    <h2>Planilla configurable</h2>
    <div class="alert alert-warning">Las tasas legales no están precargadas. Cada factor y regla exige una fuente o aprobación verificable.</div>
    <div class="row">
        <div class="col-lg-4">
            <form asp-action="ConfigureRule" method="post" class="card card-body mb-3">
                <h5>Regla versionada</h5>
                <input name="Codigo" class="form-control mb-2" placeholder="CÓDIGO" />
                <input name="Nombre" class="form-control mb-2" placeholder="Nombre" />
                <select name="Tipo" class="form-control mb-2"><option>Ingreso</option><option>Deduccion</option></select>
                <select name="TipoCalculo" class="form-control mb-2"><option>MontoFijo</option><option>PorcentajeSalario</option><option>PorHoraExtra</option><option>PorcentajeBruto</option></select>
                <input name="Valor" type="number" step="0.000001" min="0" class="form-control mb-2" placeholder="Valor decimal" />
                <input name="Tope" type="number" step="0.01" min="0" class="form-control mb-2" placeholder="Tope opcional" />
                <input name="VigenteDesde" type="date" class="form-control mb-2" />
                <input name="VigenteHasta" type="date" class="form-control mb-2" />
                <textarea name="Fuente" maxlength="500" class="form-control mb-2" placeholder="Fuente oficial o aprobación responsable"></textarea>
                <button class="btn btn-primary">Guardar regla</button>
            </form>
        </div>
        <div class="col-lg-4">
            <form asp-action="CreatePeriod" method="post" class="card card-body mb-3">
                <h5>Periodo</h5>
                <select name="Tipo" class="form-control mb-2"><option>Quincenal</option><option>Mensual</option></select>
                <input name="Desde" type="date" class="form-control mb-2" />
                <input name="Hasta" type="date" class="form-control mb-2" />
                <input name="FactorSalario" type="number" min="0.000001" max="1" step="0.000001" class="form-control mb-2" placeholder="Factor de salario configurado" />
                <textarea name="FuenteConfiguracion" maxlength="500" class="form-control mb-2" placeholder="Fuente o aprobación del factor"></textarea>
                <button class="btn btn-primary">Crear</button>
            </form>
        </div>
        <div class="col-lg-4">
            <form asp-action="Calculate" method="post" class="card card-body mb-3">
                <h5>Calcular empleado</h5>
                <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid()" />
                <input name="PeriodoId" type="number" min="1" class="form-control mb-2" placeholder="Periodo ID" />
                <input name="EmpleadoId" type="number" min="1" class="form-control mb-2" placeholder="Empleado ID" />
                <input name="Comisiones" type="number" min="0" step="0.01" class="form-control mb-2" placeholder="Comisiones confirmadas" />
                <button class="btn btn-primary">Calcular</button>
            </form>
        </div>
    </div>
    <table class="table table-striped">
        <thead><tr><th>Periodo</th><th>Empleado</th><th>Bruto</th><th>Deducciones</th><th>Neto</th><th>Estado</th><th>Transición</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Calculos)
        {
            <tr>
                <td>@item.Periodo</td><td>@item.Empleado</td><td>@item.TotalBruto</td><td>@item.TotalDeducciones</td><td>@item.TotalNeto</td><td>@item.Estado</td>
                <td>
                    <form method="post">
                        <input type="hidden" name="CalculoId" value="@item.CalculoId" />
                        <input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" />
                        <input name="Motivo" maxlength="500" placeholder="Motivo para reversión" />
                        <button asp-action="Approve" class="btn btn-sm btn-success">Aprobar</button>
                        <button asp-action="Pay" class="btn btn-sm btn-primary">Pagar</button>
                        <button asp-action="Revert" class="btn btn-sm btn-danger">Revertir</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
