@model Proyecto_Final.Models.Admin.PayrollIndexViewModel
@{
    ViewData["Title"] = "Planilla configurable";
    var calculations = Model?.Calculos ?? new List<Proyecto_Final.Models.Admin.PayrollListItemViewModel>();
    var rule = Model?.Regla ?? new Proyecto_Final.Models.Admin.PayrollRuleFormViewModel();
    var period = Model?.Periodo ?? new Proyecto_Final.Models.Admin.PayrollPeriodFormViewModel();
    var calculation = Model?.Calculo ?? new Proyecto_Final.Models.Admin.PayrollCalculationRequestViewModel();
    var ruleStart = rule.VigenteDesde == default ? string.Empty : rule.VigenteDesde.ToString("yyyy-MM-dd");
    var ruleEnd = rule.VigenteHasta?.ToString("yyyy-MM-dd") ?? string.Empty;
    var periodStart = period.Desde == default ? string.Empty : period.Desde.ToString("yyyy-MM-dd");
    var periodEnd = period.Hasta == default ? string.Empty : period.Hasta.ToString("yyyy-MM-dd");
}

@section Styles {
    <style>
        .payroll-page { padding: 1.5rem 0 3.5rem; }
        .payroll-shell { max-width: 1440px; }
        .payroll-hero {
            position: relative; overflow: hidden; padding: 2rem;
            color: #fff; border-radius: 24px;
            background: linear-gradient(125deg, #121214 0%, #28211a 56%, #78530e 145%);
            box-shadow: 0 20px 44px rgba(25, 22, 15, .22);
        }
        .payroll-hero::after { content: ""; position: absolute; width: 300px; height: 300px; right: -100px; bottom: -175px; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; }
        .payroll-hero > * { position: relative; z-index: 1; }
        .payroll-eyebrow { display: inline-flex; align-items: center; gap: .45rem; margin-bottom: .45rem; color: #f4d773; font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .payroll-hero h1 { margin: 0; color: #fff; font-size: clamp(1.65rem, 3vw, 2.35rem); font-weight: 800; }
        .payroll-hero p { max-width: 760px; margin: .55rem 0 0; color: rgba(255,255,255,.8); }
        .payroll-policy { display: flex; align-items: flex-start; gap: .7rem; margin-top: 1rem; padding: .85rem 1rem; color: #624b05; background: #fff3c9; border: 1px solid #f5df8f; border-radius: 14px; }
        .payroll-policy i { margin-top: .15rem; color: #a57808; }
        .payroll-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(285px, .78fr); gap: 1rem; margin-top: 1.25rem; align-items: start; }
        .payroll-card { height: 100%; border: 1px solid #e9e3d7; border-radius: 20px; background: #fff; box-shadow: 0 12px 28px rgba(20, 20, 22, .07); }
        .payroll-card__header { display: flex; gap: .75rem; align-items: flex-start; padding: 1.15rem 1.2rem .8rem; border-bottom: 1px solid #f0ebe2; }
        .payroll-card__icon { display: grid; flex: 0 0 38px; width: 38px; height: 38px; place-items: center; color: #6f5010; background: #fff5d8; border-radius: 12px; }
        .payroll-card h2 { margin: 0; color: #28292d; font-size: 1.05rem; font-weight: 800; }
        .payroll-card__header p { margin: .15rem 0 0; color: #6d737c; font-size: .82rem; line-height: 1.35; }
        .payroll-card__body { padding: 1rem 1.2rem 1.2rem; }
        .payroll-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
        .payroll-field--full { grid-column: 1 / -1; }
        .payroll-field label { display: block; margin: 0 0 .35rem; color: #39414b; font-size: .81rem; font-weight: 800; }
        .payroll-field .form-control { min-height: 42px; font-size: .9rem; }
        .payroll-field textarea.form-control { min-height: 74px; resize: vertical; }
        .payroll-help { display: block; margin-top: .3rem; color: #737b86; font-size: .73rem; line-height: 1.3; }
        .payroll-card .btn { width: 100%; margin-top: 1rem; }
        .payroll-table-card { margin-top: 1.25rem; overflow: hidden; border: 1px solid #e9e3d7; border-radius: 20px; background: #fff; box-shadow: 0 12px 28px rgba(20,20,22,.07); }
        .payroll-table-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.05rem 1.2rem; border-bottom: 1px solid #eee9df; }
        .payroll-table-heading h2 { margin: 0; color: #292b30; font-size: 1.1rem; font-weight: 800; }
        .payroll-table-heading span { color: #6e747d; font-size: .82rem; }
        .payroll-table-card .table { margin: 0; }
        .payroll-table-card th { color: #4b4435; background: #fbf7ec; border-top: 0; font-size: .78rem; letter-spacing: .02em; text-transform: uppercase; white-space: nowrap; }
        .payroll-table-card td { vertical-align: middle; color: #39414b; }
        .payroll-amount { display: block; color: #272a2f; font-weight: 800; white-space: nowrap; }
        .payroll-employee { min-width: 150px; max-width: 220px; overflow-wrap: anywhere; font-weight: 700; }
        .payroll-period { min-width: 145px; max-width: 200px; overflow-wrap: anywhere; }
        .payroll-status { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .6rem; border-radius: 999px; font-size: .76rem; font-weight: 800; white-space: nowrap; }
        .payroll-status--draft { color: #8a6306; background: #fff3cf; }
        .payroll-status--approved { color: #116534; background: #ddf8e8; }
        .payroll-status--paid { color: #125c80; background: #e0f3fc; }
        .payroll-status--reverted { color: #a62736; background: #ffe4e7; }
        .payroll-status--unknown { color: #5f6670; background: #edf0f3; }
        .payroll-row-actions { display: flex; min-width: 220px; flex-wrap: wrap; align-items: center; gap: .45rem; }
        .payroll-row-actions form { margin: 0; }
        .payroll-row-actions .btn { min-height: 34px; margin: 0; padding: .35rem .65rem; border-radius: 10px !important; font-size: .77rem; }
        .payroll-revert { display: flex; flex: 1 1 100%; gap: .45rem; align-items: center; }
        .payroll-revert .form-control { min-width: 145px; min-height: 34px; font-size: .77rem; }
        .payroll-empty { padding: 2.5rem 1.5rem; text-align: center; color: #6c737c; }
        .payroll-empty i { display: block; margin-bottom: .7rem; color: #d1a830; font-size: 2rem; }
        .payroll-empty h3 { margin: 0 0 .35rem; color: #34363a; font-size: 1.05rem; font-weight: 800; }
        .payroll-form-status { min-height: 1.15rem; margin: .55rem 0 0; color: #707782; font-size: .75rem; }
        @@media (max-width: 1199.98px) { .payroll-layout { grid-template-columns: repeat(2, minmax(0, 1fr)); } .payroll-layout > :last-child { grid-column: 1 / -1; } }
        @@media (max-width: 767.98px) { .payroll-page { padding-top: .75rem; } .payroll-hero { padding: 1.35rem; border-radius: 18px; } .payroll-layout { grid-template-columns: 1fr; } .payroll-layout > :last-child { grid-column: auto; } .payroll-form-grid { grid-template-columns: 1fr; } .payroll-field--full { grid-column: auto; } .payroll-card, .payroll-table-card { border-radius: 16px; } .payroll-table-heading { align-items: flex-start; flex-direction: column; } }
    </style>
}

<main class="container payroll-shell payroll-page">
    <header class="payroll-hero">
        <span class="payroll-eyebrow"><i class="fa fa-calculator"></i> Gestión de recursos humanos</span>
        <h1>Planilla configurable</h1>
        <p>Configure reglas y períodos con trazabilidad, luego calcule cada empleado de forma idempotente.</p>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success mt-3" role="status"><i class="fa fa-check-circle mr-2"></i>@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger mt-3" role="alert"><i class="fa fa-exclamation-circle mr-2"></i>@errorMessage</div>
    }

    <div class="payroll-policy" role="note">
        <i class="fa fa-shield-alt"></i>
        <div><strong>Configuración verificable.</strong> Las tasas legales no están precargadas: cada factor y regla requiere una fuente o aprobación responsable.</div>
    </div>

    <section class="payroll-layout" aria-label="Configuración y cálculo de planilla">
        <article class="payroll-card">
            <div class="payroll-card__header">
                <span class="payroll-card__icon"><i class="fa fa-list-alt"></i></span>
                <div><h2>Regla versionada</h2><p>Defina ingresos o deducciones con vigencia y evidencia.</p></div>
            </div>
            <div class="payroll-card__body">
                <form asp-action="ConfigureRule" method="post" data-prevent-double-submit>
                    @Html.AntiForgeryToken()
                    <div class="payroll-form-grid">
                        <div class="payroll-field"><label for="rule-code">Código</label><input id="rule-code" name="Codigo" value="@rule.Codigo" class="form-control text-uppercase" maxlength="50" pattern="[A-Z0-9_]+" required placeholder="EJ: BONO_MENSUAL" /></div>
                        <div class="payroll-field"><label for="rule-name">Nombre</label><input id="rule-name" name="Nombre" value="@rule.Nombre" class="form-control" maxlength="150" required placeholder="Nombre de la regla" /></div>
                        <div class="payroll-field"><label for="rule-type">Tipo</label><select id="rule-type" name="Tipo" class="form-control" required><option value="Ingreso" selected="@(rule.Tipo == "Ingreso")">Ingreso</option><option value="Deduccion" selected="@(rule.Tipo == "Deduccion")">Deducción</option></select></div>
                        <div class="payroll-field"><label for="rule-calculation">Cálculo</label><select id="rule-calculation" name="TipoCalculo" class="form-control" required><option value="MontoFijo" selected="@(rule.TipoCalculo == "MontoFijo")">Monto fijo</option><option value="PorcentajeSalario" selected="@(rule.TipoCalculo == "PorcentajeSalario")">% de salario</option><option value="PorHoraExtra" selected="@(rule.TipoCalculo == "PorHoraExtra")">Por hora extra</option><option value="PorcentajeBruto" selected="@(rule.TipoCalculo == "PorcentajeBruto")">% bruto</option></select></div>
                        <div class="payroll-field"><label for="rule-value">Valor</label><input id="rule-value" name="Valor" value="@rule.Valor.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" inputmode="decimal" min="0" max="99999999" step="0.000001" required placeholder="0,00" /><small class="payroll-help">Acepta punto o coma decimal.</small></div>
                        <div class="payroll-field"><label for="rule-cap">Tope opcional</label><input id="rule-cap" name="Tope" value="@(rule.Tope?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control" inputmode="decimal" min="0" max="99999999" step="0.01" placeholder="Sin tope" /></div>
                        <div class="payroll-field"><label for="rule-from">Vigente desde</label><input id="rule-from" name="VigenteDesde" value="@ruleStart" type="date" class="form-control" required /></div>
                        <div class="payroll-field"><label for="rule-to">Vigente hasta</label><input id="rule-to" name="VigenteHasta" value="@ruleEnd" type="date" class="form-control" /></div>
                        <div class="payroll-field payroll-field--full"><label for="rule-source">Fuente o aprobación</label><textarea id="rule-source" name="Fuente" class="form-control" maxlength="500" required placeholder="Normativa, enlace o aprobación responsable">@rule.Fuente</textarea></div>
                    </div>
                    <button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Guardar regla</button>
                    <p class="payroll-form-status" aria-live="polite"></p>
                </form>
            </div>
        </article>

        <article class="payroll-card">
            <div class="payroll-card__header">
                <span class="payroll-card__icon"><i class="fa fa-calendar-alt"></i></span>
                <div><h2>Período</h2><p>Abra un período de hasta 31 días con factor documentado.</p></div>
            </div>
            <div class="payroll-card__body">
                <form asp-action="CreatePeriod" method="post" data-prevent-double-submit>
                    @Html.AntiForgeryToken()
                    <div class="payroll-form-grid">
                        <div class="payroll-field payroll-field--full"><label for="period-type">Frecuencia</label><select id="period-type" name="Tipo" class="form-control" required><option value="Quincenal" selected="@(period.Tipo == "Quincenal")">Quincenal</option><option value="Mensual" selected="@(period.Tipo == "Mensual")">Mensual</option></select></div>
                        <div class="payroll-field"><label for="period-from">Desde</label><input id="period-from" name="Desde" value="@periodStart" type="date" class="form-control" required /></div>
                        <div class="payroll-field"><label for="period-to">Hasta</label><input id="period-to" name="Hasta" value="@periodEnd" type="date" class="form-control" required /></div>
                        <div class="payroll-field payroll-field--full"><label for="salary-factor">Factor salarial</label><input id="salary-factor" name="FactorSalario" value="@period.FactorSalario.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" inputmode="decimal" min="0.000001" max="1" step="0.000001" required placeholder="Ej: 0,500000" /><small class="payroll-help">Debe ser mayor que 0 y menor o igual a 1.</small></div>
                        <div class="payroll-field payroll-field--full"><label for="factor-source">Fuente o aprobación del factor</label><textarea id="factor-source" name="FuenteConfiguracion" class="form-control" maxlength="500" required placeholder="Documento, acuerdo o aprobación responsable">@period.FuenteConfiguracion</textarea></div>
                    </div>
                    <button class="btn btn-primary" type="submit"><i class="fa fa-plus-circle"></i> Crear período</button>
                    <p class="payroll-form-status" aria-live="polite"></p>
                </form>
            </div>
        </article>

        <article class="payroll-card">
            <div class="payroll-card__header">
                <span class="payroll-card__icon"><i class="fa fa-user-check"></i></span>
                <div><h2>Calcular empleado</h2><p>Use los identificadores vigentes del período y empleado.</p></div>
            </div>
            <div class="payroll-card__body">
                <form asp-action="Calculate" method="post" data-prevent-double-submit>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdempotencyKey" value="@calculation.IdempotencyKey" />
                    <div class="payroll-form-grid">
                        <div class="payroll-field payroll-field--full"><label for="period-id">ID del período</label><input id="period-id" name="PeriodoId" value="@(calculation.PeriodoId > 0 ? calculation.PeriodoId : "")" type="number" class="form-control" min="1" step="1" required placeholder="Ej: 12" /></div>
                        <div class="payroll-field payroll-field--full"><label for="employee-id">ID del empleado</label><input id="employee-id" name="EmpleadoId" value="@(calculation.EmpleadoId > 0 ? calculation.EmpleadoId : "")" type="number" class="form-control" min="1" step="1" required placeholder="Ej: 45" /></div>
                        <div class="payroll-field payroll-field--full"><label for="commission">Comisiones confirmadas</label><input id="commission" name="Comisiones" value="@calculation.Comisiones.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" inputmode="decimal" min="0" max="99999999" step="0.01" required placeholder="0,00" /><small class="payroll-help">Ingrese 0 si no hay comisiones.</small></div>
                    </div>
                    <button class="btn btn-dark" type="submit"><i class="fa fa-calculator"></i> Calcular planilla</button>
                    <p class="payroll-form-status" aria-live="polite"></p>
                </form>
            </div>
        </article>
    </section>

    <section class="payroll-table-card" aria-labelledby="payroll-results-heading">
        <div class="payroll-table-heading"><div><h2 id="payroll-results-heading">Cálculos registrados</h2><span>Las transiciones disponibles respetan el estado y la segregación de funciones.</span></div><span>@calculations.Count registro(s)</span></div>
        @if (calculations.Count == 0)
        {
            <div class="payroll-empty"><i class="fa fa-file-invoice-dollar"></i><h3>No hay cálculos registrados</h3><p class="mb-0">Cree un período y calcule un empleado para ver los resultados aquí.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th scope="col">Período</th><th scope="col">Empleado</th><th scope="col">Bruto</th><th scope="col">Deducciones</th><th scope="col">Neto</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var item in calculations)
                    {
                        var status = item.Estado?.Trim() ?? string.Empty;
                        var statusClass = status switch { "Borrador" => "draft", "Aprobada" => "approved", "Pagada" => "paid", "Revertida" => "reverted", _ => "unknown" };
                        <tr>
                            <td class="payroll-period">@(string.IsNullOrWhiteSpace(item.Periodo) ? "Sin período" : item.Periodo)</td>
                            <td class="payroll-employee">@(string.IsNullOrWhiteSpace(item.Empleado) ? "Empleado no disponible" : item.Empleado)</td>
                            <td><span class="payroll-amount">₡@item.TotalBruto.ToString("N2")</span></td>
                            <td><span class="payroll-amount">₡@item.TotalDeducciones.ToString("N2")</span></td>
                            <td><span class="payroll-amount">₡@item.TotalNeto.ToString("N2")</span></td>
                            <td><span class="payroll-status payroll-status--@statusClass"><i class="fa fa-circle"></i>@(string.IsNullOrWhiteSpace(status) ? "Sin estado" : status)</span></td>
                            <td>
                                <div class="payroll-row-actions">
                                @if (status == "Borrador")
                                {
                                    <form asp-action="Approve" method="post" data-prevent-double-submit><input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-success"><i class="fa fa-check"></i> Aprobar</button></form>
                                }
                                @if (status == "Aprobada")
                                {
                                    <form asp-action="Pay" method="post" data-prevent-double-submit><input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-money-bill-wave"></i> Pagar</button></form>
                                }
                                @if (status is "Aprobada" or "Pagada")
                                {
                                    <form asp-action="Revert" method="post" class="payroll-revert" data-prevent-double-submit><input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" />@Html.AntiForgeryToken()<label class="sr-only" for="reason-@item.CalculoId">Motivo de reversión</label><input id="reason-@item.CalculoId" name="Motivo" class="form-control" maxlength="500" required placeholder="Motivo de reversión" /><button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-undo"></i> Revertir</button></form>
                                }
                                @if (status is not ("Borrador" or "Aprobada" or "Pagada")) { <span class="text-muted small">Sin acciones disponibles</span> }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('[data-prevent-double-submit]').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    return;
                }

                var submitButton = form.querySelector('button[type="submit"]');
                var status = form.querySelector('.payroll-form-status');
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.dataset.originalText = submitButton.innerHTML;
                    submitButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Procesando';
                }
                if (status) {
                    status.textContent = 'La solicitud se está enviando…';
                }
            });
        });
    </script>
}
