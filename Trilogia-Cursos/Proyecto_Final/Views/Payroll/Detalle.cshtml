@model Proyecto_Final.Models.Admin.PayrollPeriodDetailViewModel
@{
    ViewData["Title"] = "Detalle de planilla";
    var p = Model.Periodo;
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    <h2 class="mb-2">Planilla — @p.TipoPeriodo</h2>
                    <p>@p.FechaInicio.ToString("dd/MM/yyyy") al @p.FechaFin.ToString("dd/MM/yyyy") · Estado: <strong>@p.Estado</strong></p>
                </div>
                <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-secondary mt-3 mt-md-0"><i class="fa fa-arrow-left mr-1"></i>Volver</a>
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-3">
        <div class="col-12">
            <div class="admin-card d-flex flex-wrap" style="gap:10px;">
                @if (p.Estado == "Abierto")
                {
                    <form asp-controller="Payroll" asp-action="Calcular" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="periodoId" value="@p.PeriodoPlanillaId" />
                        <button type="submit" class="btn btn-primary"><i class="fa fa-calculator mr-1"></i>Calcular planilla</button>
                    </form>
                }
                @if (p.Estado == "Calculado")
                {
                    <form asp-controller="Payroll" asp-action="Aprobar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="periodoId" value="@p.PeriodoPlanillaId" />
                        <button type="submit" class="btn btn-info"><i class="fa fa-check mr-1"></i>Aprobar planilla</button>
                    </form>
                }
                @if (p.Estado == "Aprobado")
                {
                    <form asp-controller="Payroll" asp-action="MarcarPagado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="periodoId" value="@p.PeriodoPlanillaId" />
                        <button type="submit" class="btn btn-success"><i class="fa fa-money-bill-wave mr-1"></i>Marcar como pagada</button>
                    </form>
                }
                @if (p.Estado == "Calculado" || p.Estado == "Aprobado")
                {
                    <button type="button" class="btn btn-outline-danger" data-toggle="modal" data-target="#revertirModal">
                        <i class="fa fa-undo mr-1"></i>Revertir
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-12">
            <div class="admin-table-wrapper">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Detalle por empleado</h5>
                    <span class="badge badge-dark">@Model.Detalles.Count boleta(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Empleado</th>
                                <th class="text-right">Salario base</th>
                                <th class="text-right">Horas extra</th>
                                <th class="text-right">Comisiones</th>
                                <th class="text-right">Bruto</th>
                                <th class="text-right">CCSS</th>
                                <th class="text-right">Renta</th>
                                <th class="text-right">Neto</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Detalles.Any())
                            {
                                <tr><td colspan="9" class="text-center text-muted py-4">Este período aún no tiene planilla calculada.</td></tr>
                            }
                            else
                            {
                                @foreach (var d in Model.Detalles)
                                {
                                    <tr>
                                        <td>@d.NombreCompleto</td>
                                        <td class="text-right">₡@d.SalarioBase.ToString("N2")</td>
                                        <td class="text-right">₡@d.MontoHorasExtra.ToString("N2")</td>
                                        <td class="text-right">₡@d.MontoComisiones.ToString("N2")</td>
                                        <td class="text-right">₡@d.SalarioBruto.ToString("N2")</td>
                                        <td class="text-right">-₡@d.DeduccionCcss.ToString("N2")</td>
                                        <td class="text-right">-₡@d.DeduccionRenta.ToString("N2")</td>
                                        <td class="text-right font-weight-bold">₡@d.SalarioNeto.ToString("N2")</td>
                                        <td class="text-right">
                                            <form asp-controller="Payroll" asp-action="EnviarBoleta" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="planillaDetalleId" value="@d.PlanillaDetalleId" />
                                                <input type="hidden" name="periodoId" value="@p.PeriodoPlanillaId" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa fa-envelope"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="revertirModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-controller="Payroll" asp-action="Revertir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PeriodoPlanillaId" value="@p.PeriodoPlanillaId" />
                <div class="modal-header">
                    <h5 class="modal-title">Revertir planilla</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p>Esta acción borra el detalle calculado y regresa el período a estado <strong>Abierto</strong>.</p>
                    <div class="form-group">
                        <label>Motivo de la reversión</label>
                        <textarea name="MotivoReversion" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Revertir</button>
                </div>
            </form>
        </div>
    </div>
</div>