@model Proyecto_Final.Models.Admin.InventoryIntelligenceViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Inteligencia de inventario"; var maxSales=Model.TendenciaEstacional.Any()?Model.TendenciaEstacional.Max(x=>x.TotalVendido):0m; string Tone(string risk)=>risk=="Alto"?"danger":risk=="Medio"?"warning":"info"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Inteligencia</span><h1>Inteligencia de inventario</h1><p>Abastecimiento, rotación y estacionalidad calculados con pedidos válidos.</p></div><span class="djj-page-header__meta">Generado @Model.GeneratedUtc.ToString("dd/MM/yyyy HH:mm") UTC</span></header>
<nav class="djj-domain-nav" aria-label="Secciones de inventario"><a asp-controller="Inventory" asp-action="Index">Productos</a><a asp-controller="Inventory" asp-action="Movements">Movimientos</a><a aria-current="page" asp-action="Index">Inteligencia</a></nav>
@if(TempData["ErrorMessage"] is string error){<div class="djj-alert djj-alert--danger" role="alert">@error</div>}<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div>
<section class="djj-card djj-filter-card" aria-labelledby="intelligence-filter-title"><h2 id="intelligence-filter-title">Parámetros del análisis</h2><form method="get" class="djj-filter-bar djj-filter-bar--wide"><div class="djj-field"><label asp-for="Filter.StartYear">Año inicial</label><input asp-for="Filter.StartYear" name="StartYear" type="number" min="2000" max="2100" class="djj-input" /></div><div class="djj-field"><label asp-for="Filter.EndYear">Año final</label><input asp-for="Filter.EndYear" name="EndYear" type="number" min="2000" max="2100" class="djj-input" /></div><div class="djj-field"><label asp-for="Filter.RecentMonths">Meses para promedio</label><input asp-for="Filter.RecentMonths" name="RecentMonths" type="number" min="1" max="12" class="djj-input" /></div><div class="djj-field"><label asp-for="Filter.CoverageMonths">Meses de cobertura</label><input asp-for="Filter.CoverageMonths" name="CoverageMonths" type="number" min="1" max="12" class="djj-input" /></div><div class="djj-field"><label asp-for="Filter.SlowWindowDays">Ventana sin rotación</label><input asp-for="Filter.SlowWindowDays" name="SlowWindowDays" type="number" min="30" max="365" class="djj-input" /></div><button class="djj-button djj-button--primary" type="submit">Actualizar</button></form></section>
<div class="djj-kpi-grid"><article class="djj-kpi-card"><span>Sugerencias de compra</span><strong>@Model.SugerenciasCompra.Count</strong></article><article class="djj-kpi-card"><span>Productos estancados</span><strong>@Model.ProductosEstancados.Count</strong></article><article class="djj-kpi-card"><span>Meses comparables</span><strong>@Model.TendenciaEstacional.Count / 12</strong></article></div>
<section class="djj-card djj-data-section" aria-labelledby="purchase-title"><header><div><h2 id="purchase-title">Sugerencias de abastecimiento</h2><p>Prioridad operativa según cobertura y demanda.</p></div></header>@if(!Model.SugerenciasCompra.Any()){<div class="djj-empty-state"><h3>Sin compras sugeridas</h3><p>El inventario cubre la demanda estimada.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Stock / mínimo</th><th class="djj-align-right">Venta ventana</th><th class="djj-align-right">Promedio mensual</th><th class="djj-align-right">Cobertura</th><th>Sugerencia</th></tr></thead><tbody>@foreach(var item in Model.SugerenciasCompra){<tr><td><strong>@item.Nombre</strong>@if(item.DatosInsuficientes){<small class="djj-table__note">Datos de venta insuficientes</small>}</td><td class="djj-align-right">@item.StockActual / @item.StockMinimo</td><td class="djj-align-right">@item.UnidadesVendidasVentana u.</td><td class="djj-align-right">@item.PromedioVentaMensual.ToString("N2") u.</td><td class="djj-align-right">@item.MesesCobertura mes(es)</td><td><span class="djj-badge djj-badge--success">Comprar @item.CantidadSugerida</span></td></tr>}</tbody></table></div>}</section>
<section class="djj-card djj-data-section" aria-labelledby="slow-title"><header><div><h2 id="slow-title">Productos sin rotación</h2><p>Existencias maduras fuera de la ventana seleccionada.</p></div></header>@if(!Model.ProductosEstancados.Any()){<div class="djj-empty-state"><h3>Sin productos estancados</h3><p>Ningún producto incumple la ventana seleccionada.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Stock</th><th>Última venta</th><th class="djj-align-right">Días</th><th class="djj-align-right">Venta ventana</th><th>Riesgo</th></tr></thead><tbody>@foreach(var item in Model.ProductosEstancados){<tr><td><strong>@item.Nombre</strong><small class="djj-table__note">Creado @item.FechaCreacion.ToString("dd/MM/yyyy")</small></td><td class="djj-align-right">@item.Stock</td><td>@(item.UltimaVenta?.ToString("dd/MM/yyyy")??"Sin ventas")</td><td class="djj-align-right">@item.DiasSinMovimiento</td><td class="djj-align-right">@item.VendidoEnVentana</td><td><span class="djj-badge djj-badge--@Tone(item.NivelRiesgo)">@item.NivelRiesgo</span></td></tr>}</tbody></table></div>}</section>
<section class="djj-card djj-data-section" aria-labelledby="seasonal-title"><header><div><h2 id="seasonal-title">Tendencia estacional @Model.Filter.StartYear–@Model.Filter.EndYear</h2><p>Ventas y unidades comparadas por mes.</p></div></header><div class="djj-seasonal-chart" aria-label="Gráfico de ventas por mes">@foreach(var point in Model.TendenciaEstacional){var height=maxSales>0?Math.Max(2,(int)Math.Round(point.TotalVendido/maxSales*100m)):2;var label=point.NombreMes.Length<=3?point.NombreMes:point.NombreMes[..3];<div class="djj-seasonal-column"><div class="djj-seasonal-track"><div class="djj-seasonal-bar" style="--djj-chart-height:@(height)%" role="img" aria-label="@point.NombreMes, @point.TotalVendido.ToString("N2") colones, @point.UnidadesVendidas unidades"></div></div><small>@label</small></div>}</div><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Mes</th><th class="djj-align-right">Total vendido</th><th class="djj-align-right">Unidades</th></tr></thead><tbody>@foreach(var point in Model.TendenciaEstacional){<tr><td>@point.NombreMes</td><td class="djj-align-right">₡@point.TotalVendido.ToString("N2")</td><td class="djj-align-right">@point.UnidadesVendidas</td></tr>}</tbody></table></div></section>
