@model IReadOnlyList<Proyecto_Final.Models.Admin.PaySlipListItemViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Boletas de pago"; string Tone(string state) => state switch { "Pagada" or "Aprobada" => "success", "Revertida" => "danger", "Borrador" => "warning", _ => "neutral" }; }

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Personal · Comprobantes</span><h1>Boletas de pago</h1><p>Consultá, descargá o notificá boletas pagadas. El correo contiene solo un enlace HTTPS al portal privado.</p></div><div class="djj-page-header__actions"><a asp-controller="Payroll" asp-action="Index" class="djj-button djj-button--ghost">Volver a planilla</a></div></header>
<div class="djj-alert" role="note"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-shield"></use></svg><div><strong>Contenido privado</strong><p>El desglose no se adjunta al correo ni se publica fuera del portal autenticado.</p></div></div>
<section class="djj-card djj-data-section" aria-labelledby="payslip-list-title"><header><div><h2 id="payslip-list-title">Boletas disponibles</h2><p>@Model.Count registro(s).</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Período</th><th>Empleado</th><th class="djj-align-right">Bruto</th><th class="djj-align-right">Deducciones</th><th class="djj-align-right">Neto</th><th>Estado / envío</th><th class="djj-align-right">Acciones</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin boletas</h3><p>No hay comprobantes de pago disponibles para gestionar.</p></div></td></tr> }
@foreach (var item in Model) { <tr><td>@item.Periodo</td><td>@item.Empleado</td><td class="djj-align-right">₡@item.TotalBruto.ToString("N2")</td><td class="djj-align-right">₡@item.TotalDeducciones.ToString("N2")</td><td class="djj-align-right"><strong>₡@item.TotalNeto.ToString("N2")</strong></td><td><span class="djj-status-badge djj-status-badge--@Tone(item.Estado)">@item.Estado</span><small class="djj-table__note">@(item.UltimoEnvio ?? "Sin envío")</small></td><td><div class="djj-row-actions"><a asp-action="Details" asp-route-id="@item.CalculoId" class="djj-button djj-button--outline djj-button--sm">Ver</a><a asp-action="Download" asp-route-id="@item.CalculoId" class="djj-button djj-button--ghost djj-button--sm">Descargar</a><form asp-action="Send" method="post" data-djj-confirm="Notificar a @item.Empleado que la boleta del período @item.Periodo está disponible en el portal privado.">@Html.AntiForgeryToken()<input type="hidden" name="CalculoId" value="@item.CalculoId" /><input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid()" /><button class="djj-button djj-button--primary djj-button--sm" disabled="@(item.Estado != "Pagada")">Notificar</button></form></div></td></tr> }
</tbody></table></div></section>
