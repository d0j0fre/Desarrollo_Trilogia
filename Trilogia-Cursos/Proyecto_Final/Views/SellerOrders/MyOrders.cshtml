@model List<Proyecto_Final.Models.Admin.SellerMyOrderViewModel>
@using Proyecto_Final.Models.Presentation
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Mis pedidos"; var culture = System.Globalization.CultureInfo.GetCultureInfo("es-CR"); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Ventas · Seguimiento</span><h1>Mis pedidos</h1><p>Pedidos registrados por tu usuario, con el estado y la factura disponibles. Se muestran los últimos 20 pedidos.</p></div><a asp-action="Index" class="djj-button djj-button--primary">Nuevo pedido</a></header>
<section class="djj-card djj-data-section" aria-labelledby="my-orders-title"><header><div><h2 id="my-orders-title">Pedidos registrados</h2><p>@Model.Count pedido(s) en este listado.</p></div></header><div class="djj-table-wrap" tabindex="0" role="region" aria-label="Mis pedidos; desplazamiento horizontal"><table class="djj-table djj-table--compact"><caption class="djj-sr-only">Pedidos del vendedor, importes y seguimiento</caption><thead><tr><th scope="col">Pedido</th><th scope="col">Cliente</th><th scope="col">Fecha</th><th scope="col" class="djj-align-right">Total</th><th scope="col">Estado</th><th scope="col">Factura</th><th scope="col">Actualizado</th><th scope="col">Acciones</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="8"><div class="djj-empty-state"><h3>Sin pedidos registrados</h3><p>Los pedidos que registres aparecerán aquí.</p></div></td></tr> }
@foreach (var pedido in Model)
{
    <tr><th scope="row" class="djj-table__primary">#@pedido.PedidoId</th><td>@pedido.Cliente</td><td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td><td class="djj-align-right djj-order-money">₡@pedido.Total.ToString("N2", culture)</td><td><span class="djj-badge djj-badge--@OrderStatusPresentation.Tone(pedido.Estado)">@pedido.Estado</span></td><td>@(pedido.TieneFactura ? pedido.NumeroFactura : "—")</td><td>@(pedido.FechaActualizacion?.ToString("dd/MM/yy HH:mm") ?? "—")</td><td><div class="djj-row-actions"><a asp-action="@(pedido.EsRetenido ? "RetainedConfirmation" : "Confirmation")" asp-route-id="@pedido.PedidoId" class="djj-button djj-button--ghost djj-button--sm">Ver estado</a><partial name="_OrderWorkflowDetailLink" model="pedido.PedidoId" /></div></td></tr>
    @if (pedido.EsRechazado && !string.IsNullOrWhiteSpace(pedido.MotivoRechazo)) { <tr><td colspan="8"><div class="djj-alert djj-alert--danger"><strong>Motivo de rechazo del pedido #@pedido.PedidoId:</strong> @pedido.MotivoRechazo</div></td></tr> }
    @if (pedido.EsRetenido) { <tr><td colspan="8"><div class="djj-alert djj-alert--warning">Pedido #@pedido.PedidoId retenido y pendiente de revisión por el Gerente.</div></td></tr> }
}
</tbody></table></div></section>
