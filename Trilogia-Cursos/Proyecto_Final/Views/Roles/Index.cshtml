@model IEnumerable<Proyecto_Final.Models.Admin.RoleListItemViewModel>
@using Microsoft.AspNetCore.Http
@inject IRolePermissionService PermissionService
@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "Roles";
    var role = Context.Session.GetString("UserRole") ?? string.Empty;
    var admin = string.Equals(role, "Administrador", StringComparison.OrdinalIgnoreCase);
    var buscar = ViewBag.Buscar as string;
    var canManage = admin || await PermissionService.HasCodePermissionAsync(role, "ROLES_CREAR_EDITAR");
}
<section class="djj-security"><partial name="_SecurityNavigation" />
<header class="djj-page-header"><div class="djj-page-header__copy"><h1>Roles de usuario</h1><p>Información general, usuarios asociados y estado de los roles.</p></div>@if (canManage) { <a asp-controller="Roles" asp-action="Create" class="djj-button djj-button--primary">Nuevo rol</a> }</header>
<form asp-action="Index" method="get" class="djj-filter-bar"><div class="djj-field"><label for="buscar">Buscar rol</label><input id="buscar" name="buscar" value="@buscar" class="djj-input" maxlength="100" placeholder="Nombre o descripción" /></div><button class="djj-button djj-button--primary" type="submit">Buscar</button><a asp-action="Index" class="djj-button djj-button--secondary">Limpiar</a></form>

<div class="djj-table-scroll" role="region" aria-label="Roles de usuario" tabindex="0"><table class="djj-table djj-security-table"><caption class="djj-sr-only">Roles, usuarios asociados y acciones disponibles</caption><thead><tr><th scope="col">ID</th><th scope="col">Rol</th><th scope="col">Descripción</th><th scope="col">Usuarios</th><th scope="col">Fecha creación</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="7">No se encontraron roles. @if (!string.IsNullOrWhiteSpace(buscar)) { <span>Búsqueda: @buscar</span> }</td></tr> }
@foreach (var item in Model) {
<tr><td>#@item.PerfilId</td><td><strong>@item.Nombre</strong>@if (item.EsRolBase) { <small class="djj-table__note">Rol base</small> }</td><td>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</td><td>@item.TotalUsuarios</td><td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td><td><span class="djj-badge djj-badge--@(item.Activo ? "success" : "neutral")">@(item.Activo ? "Activo" : "Inactivo")</span></td><td><div class="djj-row-actions"><a asp-action="Edit" asp-route-id="@item.PerfilId" class="djj-button djj-button--secondary">@(canManage ? "Editar" : "Consultar")</a>
@if (canManage) {
 if (item.BloqueaInactivacion && item.Activo) { <span class="djj-badge djj-badge--neutral">Estado protegido</span> }
 else { <form asp-controller="Roles" asp-action="ToggleStatus" method="post" data-djj-confirm="¿Desea cambiar el estado de este rol?">@Html.AntiForgeryToken()<input type="hidden" name="perfilId" value="@item.PerfilId" /><input type="hidden" name="buscar" value="@buscar" /><button type="submit" class="djj-button djj-button--secondary">@(item.Activo ? "Inactivar" : "Activar")</button></form> }
}
</div></td></tr>
}
</tbody></table></div></section>
