@model Proyecto_Final.Models.Admin.SalesReportViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Facturación"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Ventas · Facturación administrativa</span><h1>Facturación y ventas</h1><p>Resumen financiero, facturas generadas y comportamiento de ventas.</p></div></header>
<nav class="djj-domain-nav" aria-label="Pedidos y facturación"><a asp-controller="OrdersAdmin" asp-action="Index">Pedidos</a><a asp-action="Index" aria-current="page">Facturación</a></nav>
<div class="djj-kpi-grid djj-kpi-grid--four"><article class="djj-card djj-kpi-card"><span>Ventas totales</span><strong>₡@Model.VentasTotales.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Ventas del mes</span><strong>₡@Model.VentasMesActual.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Total facturas</span><strong>@Model.TotalFacturas</strong><small>@Model.FacturasMesActual del mes actual</small></article><article class="djj-card djj-kpi-card"><span>Pedidos entregados</span><strong>@Model.PedidosEntregados</strong></article></div>
<section class="djj-card djj-data-section"><header><div><h2>Facturas generadas</h2><p>Documentos emitidos por el sistema.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Factura</th><th>Pedido</th><th>Cliente</th><th>Fecha</th><th class="djj-align-right">Subtotal</th><th class="djj-align-right">Impuesto</th><th class="djj-align-right">Total</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@if (!Model.Facturas.Any()) { <tr><td colspan="9"><div class="djj-empty-state"><h3>Sin facturas</h3><p>No hay facturas registradas.</p></div></td></tr> }@foreach (var item in Model.Facturas) { <tr><td><strong>@item.NumeroFactura</strong><small class="djj-table__note">ID @item.FacturaId</small></td><td>#@item.PedidoId</td><td>@item.Cliente</td><td class="djj-table__nowrap">@item.FechaFactura.ToString("dd/MM/yyyy HH:mm")</td><td class="djj-align-right">₡@item.Subtotal.ToString("N2")</td><td class="djj-align-right">₡@item.Impuesto.ToString("N2")</td><td class="djj-align-right"><strong>₡@item.Total.ToString("N2")</strong></td><td><span class="djj-badge djj-badge--@(item.Estado == "Generada" ? "success" : "neutral")">@item.Estado</span></td><td><a asp-action="Detail" asp-route-id="@item.FacturaId" class="djj-button djj-button--outline djj-button--sm">Ver detalle</a></td></tr> }</tbody></table></div></section>
<div class="djj-financial-panels"><section class="djj-card djj-data-section"><header><div><h2>Productos más vendidos</h2><p>Ranking real por cantidad y monto.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Cantidad</th><th class="djj-align-right">Monto</th></tr></thead><tbody>@if (!Model.ProductosMasVendidos.Any()) { <tr><td colspan="3"><div class="djj-empty-state"><p>No hay datos disponibles.</p></div></td></tr> }@foreach (var item in Model.ProductosMasVendidos) { <tr><td><strong>@item.Producto</strong></td><td class="djj-align-right">@item.CantidadVendida</td><td class="djj-align-right">₡@item.MontoVendido.ToString("N2")</td></tr> }</tbody></table></div></section><section class="djj-card djj-data-section"><header><div><h2>Ventas por mes</h2><p>Tendencia disponible en el reporte.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Período</th><th class="djj-align-right">Total</th></tr></thead><tbody>@if (!Model.VentasPorMes.Any()) { <tr><td colspan="2"><div class="djj-empty-state"><p>No hay datos mensuales.</p></div></td></tr> }@foreach (var item in Model.VentasPorMes) { <tr><td><strong>@item.Periodo</strong></td><td class="djj-align-right">₡@item.Total.ToString("N2")</td></tr> }</tbody></table></div></section></div>
