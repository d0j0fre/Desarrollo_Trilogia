@model Proyecto_Final.Models.Admin.InvoiceDetailViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Detalle de factura"; }
@section Styles { <style>@@media print{.djj-workspace-sidebar,.djj-workspace-topbar,.djj-breadcrumb,.djj-workspace-messages,.djj-invoice-actions{display:none}.djj-workspace-main{margin:0}.djj-workspace-content{max-width:none;padding:0}.djj-card{box-shadow:none;break-inside:avoid}.djj-table tr{break-inside:avoid}@@page{margin:12mm}}</style> }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Factura · @Model.NumeroFactura</span><h1>Detalle de factura</h1><p>Pedido #@Model.PedidoId · @Model.Cliente</p></div><div class="djj-page-header__actions djj-invoice-actions"><span class="djj-badge djj-badge--@(Model.Estado == "Generada" ? "success" : "neutral")">@Model.Estado</span><button type="button" class="djj-button djj-button--primary" data-djj-print>Imprimir</button><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
<div class="djj-detail-layout"><section class="djj-card"><div class="djj-card__header"><div><h2>Información general</h2><p>@Company.Value.BrandName · @Company.Value.BrandSubtitle</p></div></div><dl class="djj-detail-grid"><div><dt>ID factura</dt><dd>@Model.FacturaId</dd></div><div><dt>Pedido asociado</dt><dd>#@Model.PedidoId</dd></div><div><dt>Número de factura</dt><dd><strong>@Model.NumeroFactura</strong></dd></div><div><dt>Fecha de emisión</dt><dd>@Model.FechaFactura.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Cliente</dt><dd>@Model.Cliente</dd></div><div><dt>Correo</dt><dd>@Model.Correo</dd></div><div><dt>Subtotal</dt><dd class="djj-money">₡@Model.Subtotal.ToString("N2")</dd></div><div><dt>Impuesto</dt><dd class="djj-money">₡@Model.Impuesto.ToString("N2")</dd></div><div><dt>Total</dt><dd class="djj-money djj-money--dominant">₡@Model.Total.ToString("N2")</dd></div></dl></section><partial name="_InvoiceEmailActions" model="Model" /></div>
<section class="djj-card djj-data-section"><header><div><h2>Líneas facturadas</h2><p>Importes registrados. El subtotal de cada línea puede incluir un descuento agregado y no se obtiene repartiendo centavos entre unidades.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Cantidad</th><th class="djj-align-right">Precio unitario</th><th class="djj-align-right">Subtotal</th></tr></thead><tbody>@if (!Model.Detalles.Any()) { <tr><td colspan="4"><div class="djj-empty-state"><h3>Sin líneas</h3><p>No hay líneas registradas en esta factura.</p></div></td></tr> }@foreach (var item in Model.Detalles) { <tr><td><strong>@item.Producto</strong></td><td class="djj-align-right">@item.Cantidad</td><td class="djj-align-right">₡@item.PrecioUnitario.ToString("N2")</td><td class="djj-align-right">₡@item.Subtotal.ToString("N2")</td></tr> }</tbody><tfoot><tr><th colspan="3" class="djj-align-right">Subtotal</th><th class="djj-align-right">₡@Model.Subtotal.ToString("N2")</th></tr><tr><th colspan="3" class="djj-align-right">Impuesto</th><th class="djj-align-right">₡@Model.Impuesto.ToString("N2")</th></tr><tr><th colspan="3" class="djj-align-right">Total</th><th class="djj-align-right">₡@Model.Total.ToString("N2")</th></tr></tfoot></table></div></section>
