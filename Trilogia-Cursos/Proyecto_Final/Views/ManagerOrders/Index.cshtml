@model List<Proyecto_Final.Models.Admin.RetainedOrderListItemViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Pedidos retenidos"; var buscar = ViewBag.Buscar as string ?? string.Empty; var culture = System.Globalization.CultureInfo.GetCultureInfo("es-CR"); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Pedidos · Autorización gerencial</span><h1>Pedidos retenidos</h1><p>Revisá el detalle y la disponibilidad antes de aprobar o rechazar.</p></div><span class="djj-badge djj-badge--warning">@Model.Count pedido(s) en el listado</span></header>
<section class="djj-card djj-filter-card" aria-labelledby="retained-search-title"><h2 id="retained-search-title">Buscar pedidos</h2><form asp-action="Index" method="get" class="djj-filter-bar"><div class="djj-field"><label for="retained-search">Cliente, vendedor o número de pedido</label><input id="retained-search" type="search" name="buscar" value="@buscar" class="djj-input" /></div><div class="djj-filter-bar__actions"><button type="submit" class="djj-button djj-button--neutral">Buscar</button><a asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div></form></section>
<section class="djj-card djj-data-section" aria-labelledby="retained-list-title"><header><div><h2 id="retained-list-title">Bandeja de revisión</h2><p>El servicio devuelve únicamente pedidos en estado Retenido.</p></div></header><div class="djj-table-wrap" tabindex="0" role="region" aria-label="Pedidos retenidos; desplazamiento horizontal"><table class="djj-table djj-table--compact"><caption class="djj-sr-only">Pedidos retenidos, responsables, importes y revisión</caption><thead><tr><th scope="col">Pedido</th><th scope="col">Cliente</th><th scope="col">Vendedor</th><th scope="col">Fecha</th><th scope="col">Canal y entrega</th><th scope="col" class="djj-align-right">Líneas</th><th scope="col" class="djj-align-right">Total</th><th scope="col">Estado</th><th scope="col">Acción</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="9"><div class="djj-empty-state"><h3>Sin pedidos para revisar</h3><p>@(string.IsNullOrWhiteSpace(buscar) ? "No hay pedidos retenidos en este momento." : "La búsqueda no devolvió resultados.")</p></div></td></tr> }
@foreach (var p in Model) { <tr><th scope="row" class="djj-table__primary">#@p.PedidoId</th><td>@p.Cliente<small class="djj-table__note">@p.Correo</small></td><td>@p.VendedorNombre</td><td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td><td>@(string.IsNullOrWhiteSpace(p.CanalPedido) ? "—" : p.CanalPedido)<small class="djj-table__note">@p.TipoEntrega</small></td><td class="djj-align-right">@p.TotalLineas</td><td class="djj-align-right djj-order-money">₡@p.Total.ToString("N2", culture)</td><td><span class="djj-badge djj-badge--warning">Retenido</span></td><td><div class="djj-row-actions"><a asp-action="Review" asp-route-id="@p.PedidoId" class="djj-button djj-button--neutral djj-button--sm">Revisar</a></div></td></tr> }
</tbody></table></div></section>
