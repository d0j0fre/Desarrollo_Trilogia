@model Proyecto_Final.Models.Admin.ManagerOrderReviewViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = $"Revisar pedido #{Model.Pedido.PedidoId}"; ViewData["OrderWorkflowShowStock"] = true; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Pedidos · Revisión gerencial</span><h1>Revisar pedido #@Model.Pedido.PedidoId</h1><p>Verificá cliente, productos, importes y disponibilidad antes de decidir.</p></div><a asp-action="Index" class="djj-button djj-button--ghost">Volver a retenidos</a></header>
<div class="djj-order-sections"><partial name="_OrderWorkflowSummary" model="Model.Pedido" /><partial name="_OrderWorkflowLines" model="Model.Pedido" /></div>
@if (Model.Pedido.Detalles.Any(d => d.StockActual < d.Cantidad)) { <div class="djj-alert djj-alert--warning" role="status"><strong>Disponibilidad insuficiente en uno o más productos.</strong><p>El servidor volverá a validar el stock en tiempo real antes de aprobar.</p></div> }
<div class="djj-order-decisions">
    <section class="djj-card djj-form-card" aria-labelledby="approve-title"><h2 id="approve-title">Aprobar y facturar</h2><p>La aprobación libera el pedido, descuenta inventario y genera la factura automáticamente.</p><form asp-action="Approve" method="post" data-djj-confirm="¿Confirma la aprobación del pedido #@Model.Pedido.PedidoId? Se descontará el inventario y se generará la factura.">@Html.AntiForgeryToken()<input type="hidden" name="pedidoId" value="@Model.Pedido.PedidoId" /><button type="submit" class="djj-button djj-button--primary">Aprobar y facturar</button></form></section>
    <section class="djj-card djj-form-card" aria-labelledby="reject-title"><h2 id="reject-title">Rechazar pedido</h2><p>El pedido pasa a Rechazado. El motivo queda disponible para el vendedor y no se descuenta inventario.</p><form asp-action="Reject" method="post" class="djj-form-grid" data-djj-confirm="¿Confirma el rechazo del pedido #@Model.Pedido.PedidoId con el motivo indicado?">@Html.AntiForgeryToken()<input type="hidden" asp-for="RechazarForm.PedidoId" /><div asp-validation-summary="All" class="djj-validation-summary" data-djj-validation-summary role="alert" tabindex="-1"></div><div class="djj-field"><label asp-for="RechazarForm.MotivoRechazo"></label><textarea asp-for="RechazarForm.MotivoRechazo" class="djj-textarea" rows="4" aria-describedby="reject-reason-error" placeholder="Explicá el motivo de la decisión"></textarea><span id="reject-reason-error" asp-validation-for="RechazarForm.MotivoRechazo" class="djj-field-error"></span></div><div class="djj-form-actions"><button type="submit" class="djj-button djj-button--danger-outline">Rechazar pedido</button></div></form></section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
