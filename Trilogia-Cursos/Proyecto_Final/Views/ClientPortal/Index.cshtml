@model Proyecto_Final.Models.Store.ClientPortalIndexViewModel
@{ Layout = "_StorefrontLayout"; ViewData["Title"] = "Mis pedidos"; }
<main class="djj-container djj-store-page"><partial name="_ClientPortalNav" />
<header class="djj-store-heading"><div class="djj-store-heading__copy"><span class="djj-page-header__eyebrow">Portal del cliente</span><h1>Hola, @Model.Cliente.NombreCompleto</h1><p>Consultá pedidos, crédito y datos de tu cuenta.</p></div></header>
<section class="djj-portal-kpis" aria-label="Resumen de cuenta"><article class="djj-card"><span>Pedidos</span><strong>@Model.Cliente.TotalPedidos</strong><small>Último: @(Model.Cliente.UltimoPedido?.ToString("dd/MM/yyyy") ?? "Sin pedidos")</small></article><article class="djj-card"><span>Total comprado</span><strong>₡@Model.Cliente.TotalComprado.ToString("N0")</strong><small>Historial registrado</small></article><article class="djj-card"><span>Crédito disponible</span><strong>@(Model.Credito == null ? "Sin crédito" : $"₡{Model.Credito.CreditoDisponible:N0}")</strong><small>@(Model.Credito == null ? "No asignado" : Model.Credito.CreditoBloqueado ? "Bloqueado" : Model.Credito.CreditoActivo ? "Activo" : "Inactivo")</small></article></section>
<section class="djj-card djj-portal-profile" aria-labelledby="profile-summary-title"><div><h2 id="profile-summary-title">Datos de contacto</h2><p>@Model.Cliente.Correo · @(Model.Cliente.Telefono ?? "Sin teléfono")</p><p>@(Model.Cliente.Direccion ?? "Sin dirección registrada")</p></div><a class="djj-button djj-button--outline djj-button--sm" asp-controller="Profile" asp-action="Edit">Editar perfil</a></section>
<section class="djj-card djj-portal-table" aria-labelledby="orders-title"><div class="djj-card__header"><div><h2 id="orders-title">Pedidos recientes</h2><p>@Model.Pedidos.Count registro(s)</p></div></div><div class="djj-table-wrap"><table class="djj-table"><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th>Entrega</th><th>Total</th><th><span class="djj-sr-only">Acciones</span></th></tr></thead><tbody>@if(!Model.Pedidos.Any()){<tr><td colspan="6"><div class="djj-state"><h3>No hay pedidos registrados</h3><p>Tu historial aparecerá aquí después de comprar.</p></div></td></tr>}else{@foreach(var order in Model.Pedidos){var tone=order.Estado=="Pendiente"?"warning":order.Estado=="Entregado"?"success":order.Estado=="Cancelado"?"danger":"neutral";<tr><td><strong>#@order.PedidoId</strong></td><td>@order.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td><td><span class="djj-status-badge djj-status-badge--@tone">@order.Estado</span></td><td>@(order.TipoEntrega ?? "No indicado")</td><td><strong>₡@order.Total.ToString("N0")</strong></td><td><a class="djj-button djj-button--outline djj-button--sm" asp-action="Detail" asp-route-id="@order.PedidoId">Ver detalle</a></td></tr>}}</tbody></table></div></section>
</main>
