@model Proyecto_Final.Models.Store.WarrantyRequestFormViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Solicitar garantía"; }
<main class="djj-container djj-store-page djj-form-page"><partial name="_ClientPortalNav" /><header class="djj-store-heading"><div class="djj-store-heading__copy"><span class="djj-page-header__eyebrow">Pedido #@Model.PedidoId</span><h1>Solicitar garantía</h1><p>@Model.Producto</p></div></header><form asp-action="Warranty" method="post" class="djj-card djj-standard-form">@Html.AntiForgeryToken()<input asp-for="PedidoDetalleId" type="hidden" /><input asp-for="PedidoId" type="hidden" /><input asp-for="Producto" type="hidden" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-field"><label asp-for="Motivo" class="djj-field__label"></label><select asp-for="Motivo" class="djj-select"><option value="">Seleccioná un motivo</option><option>Producto defectuoso</option><option>Producto dañado</option><option>Falla de funcionamiento</option><option>Piezas faltantes</option><option>Otro</option></select><span asp-validation-for="Motivo" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Descripcion" class="djj-field__label"></label><textarea asp-for="Descripcion" class="djj-textarea" rows="5"></textarea><span asp-validation-for="Descripcion" class="djj-field__error"></span></div><div class="djj-form-actions"><a class="djj-button djj-button--ghost" asp-action="Detail" asp-route-id="@Model.PedidoId">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Enviar solicitud</button></div></form></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
