@model List<Proyecto_Final.Models.Store.ClientWarrantyListItemViewModel>

@{
    ViewData["Title"] = "Mis garantías";
}

@section Styles {
    @* El portal no trae variante azul para «En revisión»: se define solo para esta vista. *@
    <style>
        .s4-client-status-pill.info {
            background: #dbeafe;
            color: #1e3a8a;
        }
    </style>
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Mis solicitudes de garantía</h2>

            <p class="text-muted mb-0">
                Consulte el estado de todas sus solicitudes de garantía.
            </p>
        </div>

        <a asp-controller="ClientPortal"
           asp-action="Index"
           class="btn btn-ds-neutral">
            <i class="fa fa-arrow-left"></i>
            Volver a mis pedidos
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i>
            No tiene solicitudes de garantía registradas.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover table-bordered mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Solicitud</th>
                                <th>Pedido</th>
                                <th>Producto</th>
                                <th>Fecha</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var solicitud in Model)
                            {
                                <tr>

                                    <td>
                                        #@solicitud.GarantiaId
                                    </td>

                                    <td>
                                        #@solicitud.PedidoId
                                    </td>

                                    <td>
                                        @solicitud.Producto
                                    </td>

                                    <td>
                                        @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @solicitud.Motivo
                                    </td>

                                    <td>
                                        @{
                                            // Misma pastilla que Mis pedidos: fondo suave con texto oscuro del mismo tono.
                                            var claseEstado = solicitud.Estado switch
                                            {
                                                "Pendiente" => "warning",
                                                "En revisión" => "info",
                                                "Aprobada" => "success",
                                                "Rechazada" => "danger",
                                                _ => "dark",
                                            };
                                        }
                                        <span class="s4-client-status-pill @claseEstado">@solicitud.Estado</span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>