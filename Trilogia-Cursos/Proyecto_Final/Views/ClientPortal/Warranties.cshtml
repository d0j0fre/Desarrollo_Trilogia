@model List<Proyecto_Final.Models.Store.ClientWarrantyListItemViewModel>
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Mis garantías"; }
<main class="djj-container djj-store-page"><partial name="_ClientPortalNav" /><header class="djj-store-heading"><div class="djj-store-heading__copy"><span class="djj-page-header__eyebrow">Portal del cliente</span><h1>Mis garantías</h1><p>Consultá el estado de tus solicitudes.</p></div></header>@if(TempData["SuccessMessage"]!=null){<div class="djj-alert djj-alert--success" role="status">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"]!=null){<div class="djj-alert djj-alert--danger" role="alert">@TempData["ErrorMessage"]</div>}<section class="djj-card djj-portal-table"><div class="djj-table-wrap"><table class="djj-table"><thead><tr><th>Solicitud</th><th>Pedido</th><th>Producto</th><th>Fecha</th><th>Motivo</th><th>Estado</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6"><div class="djj-state"><h2>No hay garantías registradas</h2><p>Las solicitudes que enviés aparecerán aquí.</p></div></td></tr>}else{@foreach(var request in Model){var tone=request.Estado=="Pendiente"?"warning":request.Estado=="Aprobada"?"success":request.Estado=="Rechazada"?"danger":"info";<tr><td>#@request.GarantiaId</td><td><a asp-action="Detail" asp-route-id="@request.PedidoId">#@request.PedidoId</a></td><td>@request.Producto</td><td>@request.FechaSolicitud.ToString("dd/MM/yyyy")</td><td>@request.Motivo</td><td><span class="djj-status-badge djj-status-badge--@tone">@request.Estado</span></td></tr>}}</tbody></table></div></section></main>
