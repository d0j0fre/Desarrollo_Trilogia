@model Proyecto_Final.Models.Store.ClientPortalInvoiceViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Comprobante de pedido"; ViewData["BodyClass"]="djj-print-document-page"; var tone=Model.Estado=="Generada"?"success":"neutral"; }
<main class="djj-container djj-store-page"><div class="djj-document-toolbar djj-no-print"><div><span class="djj-page-header__eyebrow">Portal del cliente</span><h1>Comprobante de pedido</h1></div><div><a class="djj-button djj-button--ghost" asp-action="Detail" asp-route-id="@Model.PedidoId">Volver al pedido</a><button class="djj-button djj-button--primary" type="button" data-djj-print>Imprimir / guardar PDF</button></div></div>
<article class="djj-card djj-document"><header class="djj-document__header"><img src="~/brand/stage2/logo_stage2-identity_horizontal_20260821_color.svg" alt="Distribuidora JJ — Licorera - Distribuidora" width="220" height="64" /><div><span>Comprobante @Model.NumeroFactura</span><strong>Pedido #@Model.PedidoId</strong><small>@Model.FechaFactura.ToString("dd/MM/yyyy HH:mm")</small></div></header><section class="djj-document__grid"><div><h2>Cliente</h2><p><strong>@Model.Cliente</strong><br />@Model.Correo</p><span class="djj-status-badge djj-status-badge--@tone">@Model.Estado</span><p class="djj-muted">Comprobante del portal. No sustituye una factura electrónica oficial.</p></div><dl><div><dt>Subtotal</dt><dd>₡@Model.Subtotal.ToString("N0")</dd></div><div><dt>Impuesto</dt><dd>₡@Model.Impuesto.ToString("N0")</dd></div><div><dt>Total</dt><dd>₡@Model.Total.ToString("N0")</dd></div></dl></section><section class="djj-document__table"><h2>Productos</h2><div class="djj-table-wrap"><table class="djj-table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>@if(!Model.Lineas.Any()){<tr><td colspan="4">No hay productos registrados.</td></tr>}else{@foreach(var item in Model.Lineas){<tr><td>@item.Producto</td><td>@item.Cantidad</td><td>₡@item.PrecioUnitario.ToString("N0")</td><td>₡@item.Subtotal.ToString("N0")</td></tr>}}</tbody></table></div></section></article></main>
