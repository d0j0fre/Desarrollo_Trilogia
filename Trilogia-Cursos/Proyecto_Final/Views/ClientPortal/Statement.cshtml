@model Proyecto_Final.Models.Store.ClientPortalStatementViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Estado de cuenta"; ViewData["BodyClass"]="djj-print-document-page"; }
<main class="djj-container djj-store-page"><div class="djj-document-toolbar djj-no-print"><div><span class="djj-page-header__eyebrow">Portal del cliente</span><h1>Estado de cuenta</h1></div><div><a class="djj-button djj-button--ghost" asp-action="Index">Mis pedidos</a><button class="djj-button djj-button--primary" type="button" data-djj-print>Imprimir / guardar PDF</button></div></div>
<article class="djj-card djj-document"><header class="djj-document__header"><img src="~/brand/stage2/logo_stage2-identity_horizontal_20260821_color.svg" alt="Distribuidora JJ — Licorera - Distribuidora" width="220" height="64" /><div><span>Estado de cuenta</span><strong>@Model.Cliente.NombreCompleto</strong><small>Generado: @Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</small></div></header><section class="djj-document__grid"><div><h2>Resumen de compras</h2><p>@Model.Cliente.TotalPedidos pedido(s)<br /><strong>₡@Model.Cliente.TotalComprado.ToString("N0") comprados</strong></p></div><dl>@if(Model.Credito==null){<div><dt>Crédito</dt><dd>No asignado</dd></div>}else{<div><dt>Límite</dt><dd>₡@Model.Credito.LimiteCredito.ToString("N0")</dd></div><div><dt>Deuda</dt><dd>₡@Model.Credito.DeudaActual.ToString("N0")</dd></div><div><dt>Disponible</dt><dd>₡@Model.Credito.CreditoDisponible.ToString("N0")</dd></div>}</dl></section><section class="djj-document__table"><h2>Historial de pedidos</h2><div class="djj-table-wrap"><table class="djj-table"><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th>Entrega</th><th>Total</th></tr></thead><tbody>@if(!Model.Pedidos.Any()){<tr><td colspan="5">No hay pedidos registrados.</td></tr>}else{@foreach(var order in Model.Pedidos){<tr><td>#@order.PedidoId</td><td>@order.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td><td>@order.Estado</td><td>@(order.TipoEntrega ?? "No indicado")</td><td>₡@order.Total.ToString("N0")</td></tr>}}</tbody></table></div></section></article></main>
