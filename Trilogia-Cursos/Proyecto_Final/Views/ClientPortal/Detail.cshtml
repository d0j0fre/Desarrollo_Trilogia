@model Proyecto_Final.Models.Store.ClientPortalOrderDetailViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]=$"Pedido #{Model.PedidoId}"; var tone=Model.Estado=="Pendiente"?"warning":Model.Estado=="Entregado"?"success":Model.Estado=="Cancelado"?"danger":"neutral"; }
<main class="djj-container djj-store-page"><partial name="_ClientPortalNav" /><nav class="djj-store-page__breadcrumb" aria-label="Migas de pan"><ol class="djj-breadcrumb"><li><a asp-action="Index">Mis pedidos</a></li><li aria-hidden="true"><svg class="djj-icon djj-icon--sm"><use href="#djj-icon-caret-right"></use></svg></li><li aria-current="page">Pedido #@Model.PedidoId</li></ol></nav>
<header class="djj-store-heading"><div class="djj-store-heading__copy"><span class="djj-page-header__eyebrow">Detalle de pedido</span><h1>Pedido #@Model.PedidoId</h1><p>Productos, entrega y estado actual.</p></div><span class="djj-status-badge djj-status-badge--@tone">@Model.Estado</span></header>
<div class="djj-portal-detail"><div><section class="djj-card djj-portal-facts"><h2>Información general</h2><dl><div><dt>Fecha</dt><dd>@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Entrega</dt><dd>@(Model.TipoEntrega ?? "No indicado")</dd></div><div><dt>Dirección</dt><dd>@(Model.DireccionEntrega ?? "No registrada")</dd></div><div><dt>Observaciones</dt><dd>@(Model.Observaciones ?? "Sin observaciones")</dd></div></dl></section>
<section class="djj-card djj-portal-table"><div class="djj-card__header"><div><h2>Productos</h2><p>@Model.Lineas.Count línea(s)</p></div></div><div class="djj-table-wrap"><table class="djj-table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th><th>Garantía</th></tr></thead><tbody>@foreach(var line in Model.Lineas){<tr><td>@line.Producto</td><td>@line.Cantidad</td><td>₡@line.PrecioUnitario.ToString("N0")</td><td>₡@line.Subtotal.ToString("N0")</td><td>@if(!line.IsCombo && string.Equals(Model.Estado,"Entregado",StringComparison.OrdinalIgnoreCase)){<a class="djj-button djj-button--outline djj-button--sm" asp-action="Warranty" asp-route-id="@line.PedidoDetalleId">Solicitar garantía</a>}else{<span class="djj-muted">No disponible</span>}</td></tr>}</tbody></table></div></section></div>
<aside class="djj-card djj-portal-actions"><span>Total del pedido</span><strong>₡@Model.Total.ToString("N0")</strong>@if(Model.HasInvoice){<a class="djj-button djj-button--primary" asp-action="Invoice" asp-route-id="@Model.PedidoId">Ver comprobante</a>}@if(Model.CanCancel){<form asp-action="Cancel" method="post" data-djj-confirm="¿Cancelar este pedido pendiente?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.PedidoId" /><button class="djj-button djj-button--danger" type="submit">Cancelar pedido</button></form>}else{<p>@Model.CancelStatusMessage</p>}<a class="djj-button djj-button--ghost" asp-action="Index">Volver</a></aside></div></main>
