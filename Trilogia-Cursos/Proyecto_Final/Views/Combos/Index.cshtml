@model IReadOnlyList<Proyecto_Final.Models.Admin.ComboListItemViewModel>
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Combos"; var active=Model.Count(x=>x.Activo); var available=Model.Count(x=>x.PuedeVenderse); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Combos</span><h1>Combos comerciales</h1><p>Ofertas con disponibilidad calculada desde sus componentes.</p></div><a asp-action="Create" class="djj-button djj-button--primary">Nuevo combo</a></header><nav class="djj-domain-nav" aria-label="Secciones de inventario"><a asp-controller="Inventory" asp-action="Index">Productos</a><a asp-controller="Inventory" asp-action="Movements">Movimientos</a><a asp-controller="InventoryIntelligence" asp-action="Index">Inteligencia</a><a aria-current="page" asp-action="Index">Combos</a><a asp-controller="Returns" asp-action="Index">Devoluciones</a></nav>
<div class="djj-kpi-grid"><article class="djj-kpi-card"><span>Total</span><strong>@Model.Count</strong></article><article class="djj-kpi-card"><span>Activos</span><strong>@active</strong></article><article class="djj-kpi-card"><span>Vendibles hoy</span><strong>@available</strong></article></div>
<section class="djj-card djj-data-section">@if(!Model.Any()){<div class="djj-empty-state"><h3>Aún no hay combos</h3><p>Definí una oferta con al menos un componente.</p><a asp-action="Create" class="djj-button djj-button--primary">Crear primer combo</a></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Combo</th><th class="djj-align-right">Precio</th><th class="djj-align-right">Componentes</th><th class="djj-align-right">Disponibles</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var combo in Model){<tr><td><a asp-action="Detail" asp-route-id="@combo.ComboId"><strong>@combo.Nombre</strong></a><small class="djj-table__note">Creado @combo.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy") por @combo.RegistradoPorNombre</small></td><td class="djj-align-right">₡@combo.Precio.ToString("N2")</td><td class="djj-align-right">@combo.CantidadProductos</td><td class="djj-align-right"><span class="djj-badge djj-badge--@(combo.PuedeVenderse?"success":"danger")">@combo.StockDisponibleCombo</span></td><td><span class="djj-badge djj-badge--@(combo.PuedeVenderse?"success":"neutral")">@combo.EstadoDisponibilidad</span></td><td><div class="djj-row-actions"><a asp-action="Detail" asp-route-id="@combo.ComboId" class="djj-button djj-button--outline djj-button--sm">Detalle</a><form asp-action="ToggleStatus" asp-route-id="@combo.ComboId" method="post" data-djj-confirm="@(combo.Activo?"Inactivar":"Activar") el combo @combo.Nombre.">@Html.AntiForgeryToken()<button type="submit" class="djj-button djj-button--ghost djj-button--sm">@(combo.Activo?"Inactivar":"Activar")</button></form></div></td></tr>}</tbody></table></div>}</section>
