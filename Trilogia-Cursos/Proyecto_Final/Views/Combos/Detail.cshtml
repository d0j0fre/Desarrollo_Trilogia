@model Proyecto_Final.Models.Admin.ComboDetailViewModel
@{ ViewData["Title"] = Model.Nombre; }

<div class="container-fluid py-4 px-xl-5 backoffice-page s4-admin-page">
    <header class="d-flex flex-wrap justify-content-between align-items-start mb-4">
        <div class="s4-page-header">
            <span class="s4-eyebrow"><i class="fa fa-box-open"></i> Combo #@Model.ComboId</span>
            <h2>@Model.Nombre</h2>
            <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción comercial." : Model.Descripcion)</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa fa-arrow-left mr-1"></i>Volver</a>
    </header>

    <div class="s4-kpi-grid mb-4">
        <article class="s4-kpi"><span class="s4-kpi__label">Precio de venta</span><strong class="s4-kpi__value">₡@Model.Precio.ToString("N2")</strong></article>
        <article class="s4-kpi s4-kpi--@(Model.StockDisponibleCombo > 0 ? "success" : "danger")"><span class="s4-kpi__label">Disponibilidad real</span><strong class="s4-kpi__value">@Model.StockDisponibleCombo</strong></article>
        <article class="s4-kpi"><span class="s4-kpi__label">Componentes</span><strong class="s4-kpi__value">@Model.Componentes.Count</strong></article>
        <article class="s4-kpi"><span class="s4-kpi__label">Estado</span><strong class="s4-kpi__value">@(Model.Activo ? "Activo" : "Inactivo")</strong></article>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <section class="card mb-4" aria-labelledby="component-title">
                <div class="card-header" id="component-title">Composición y cobertura</div>
                <div class="table-responsive"><table class="table">
                    <thead><tr><th>Producto</th><th>Requerido por combo</th><th>Stock actual</th><th>Combos posibles</th></tr></thead>
                    <tbody>@foreach (var line in Model.Componentes) { var coverage = line.Cantidad > 0 ? line.StockDisponible / line.Cantidad : 0; <tr><td><strong>@line.ProductoNombre</strong></td><td>@line.Cantidad</td><td>@line.StockDisponible</td><td><span class="badge badge-@(coverage > 0 ? "success" : "danger")">@coverage</span></td></tr> }</tbody>
                </table></div>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="card mb-4">
                <div class="card-header">Trazabilidad</div>
                <div class="card-body"><p><small class="text-muted d-block">Registrado por</small><strong>@Model.RegistradoPorNombre</strong></p><p class="mb-0"><small class="text-muted d-block">Fecha</small><strong>@Model.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></p></div>
            </section>
            <div class="alert alert-info"><i class="fa fa-calculator mr-1"></i>La disponibilidad es el mínimo entero de stock dividido entre cantidad requerida. El checkout la recalcula y bloquea inventario.</div>
        </div>
    </div>
</div>
