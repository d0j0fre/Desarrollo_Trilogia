@model Proyecto_Final.Models.Admin.DriverRouteViewModel
@{
    Layout = "_FieldLayout";
    ViewData["Title"] = $"Ruta {Model.Codigo}";
    var editable = Model.Estado == "Despachada";
    string BadgeEntrega(string e) => e switch { "EnRuta" => "info", "Entregado" => "success", "Fallido" => "danger", _ => "warning" };
    string TextoEntrega(string e) => e switch { "EnRuta" => "En ruta", _ => e };
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Coord(decimal? lat, decimal? lng) => $"{lat.GetValueOrDefault().ToString(inv)},{lng.GetValueOrDefault().ToString(inv)}";
    string WazeUrl(decimal? lat, decimal? lng) => $"https://waze.com/ul?ll={lat.GetValueOrDefault().ToString(inv)}%2C{lng.GetValueOrDefault().ToString(inv)}&navigate=yes";
    string MapsStopUrl(decimal? lat, decimal? lng) => $"https://www.google.com/maps/dir/?api=1&destination={Coord(lat, lng)}&travelmode=driving";
    var paradasNav = Model.Entregas.Where(e => e.Latitud.HasValue && e.Longitud.HasValue).ToList();
    string? rutaCompletaUrl = null;
    if (paradasNav.Count > 0) { var destino = paradasNav[paradasNav.Count - 1]; rutaCompletaUrl = $"https://www.google.com/maps/dir/?api=1&destination={Coord(destino.Latitud, destino.Longitud)}&travelmode=driving"; if (paradasNav.Count > 1) { var waypoints = paradasNav.Take(paradasNav.Count - 1).Select(s => Coord(s.Latitud, s.Longitud)); rutaCompletaUrl += "&waypoints=" + Uri.EscapeDataString(string.Join("|", waypoints)); } }
    var total = Model.Entregas.Count;
    var completadas = Model.Entregas.Count(e => e.EstadoEntrega == "Entregado");
    var progreso = total == 0 ? 0 : completadas * 100 / total;
    var routeStopsJson = System.Text.Json.JsonSerializer.Serialize(Model.Entregas
        .Where(x => x.Latitud.HasValue && x.Longitud.HasValue)
        .Select(d => new { seq = d.Secuencia, cliente = d.Cliente, dir = d.DireccionEntrega, estado = d.EstadoEntrega, lat = d.Latitud, lng = d.Longitud }));
}

@section Styles { <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /> }

<header class="djj-page-header djj-field-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">@Model.Zona · @Model.VehiculoPlaca</span><h1>Ruta @Model.Codigo</h1><p>@(editable ? "Actualiza la siguiente entrega y registra evidencia cuando corresponda." : $"La ruta está {Model.Estado.ToLowerInvariant()}; sus entregas no se pueden actualizar.")</p></div><span class="djj-status-badge djj-status-badge--@(editable ? "info" : "neutral")">@Model.Estado</span></header>

<section class="djj-field-route-summary djj-card" aria-label="Progreso de la ruta"><div><strong>@completadas de @total</strong><span>entregas completadas</span></div><div class="djj-field-progress"><div class="djj-field-progress__track"><span style="--djj-progress-value:@progreso%"></span></div></div><div class="djj-field-sync-status" id="connectionBadge" role="status" aria-live="polite" data-djj-delivery-connection>Comprobando conexión</div><span class="djj-field-sync-queue" hidden>Pendientes de sincronizar: <strong id="pendingSyncBadge">0</strong></span></section>

<div id="driverToast" class="djj-field-toast" role="status" aria-live="polite" hidden></div>
@if (!editable) { <div class="djj-alert djj-alert--info" role="status"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-info"></use></svg><div>Esta ruta está <strong>@Model.Estado</strong>. Solo se actualizan entregas de rutas despachadas.</div></div> }

<section class="djj-field-map djj-card" aria-labelledby="route-map-title"><div class="djj-field-section-head"><div><h2 id="route-map-title">Ruta sugerida</h2><p>La dirección de cada entrega también está disponible abajo.</p></div><div class="djj-field-inline-actions">@if (rutaCompletaUrl != null) { <a href="@rutaCompletaUrl" target="_blank" rel="noopener" class="djj-button djj-button--secondary djj-button--sm">Abrir navegación</a> }<button type="button" id="refreshRouteBtn" class="djj-button djj-button--ghost djj-button--sm">Actualizar</button></div></div><div id="mapOfflineBanner" class="djj-alert djj-alert--warning" hidden><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-wifi"></use></svg><div>Sin conexión: se muestra la última ruta descargada. Los datos podrían no estar actualizados.</div></div><div id="noCoordsBanner" class="djj-alert djj-alert--info" hidden><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-info"></use></svg><div>Aún no hay coordenadas para esta ruta. Contactá a logística para secuenciarla.</div></div><div id="routeMap" aria-label="Mapa de la ruta"></div></section>

@Html.AntiForgeryToken()
<section class="djj-field-deliveries" aria-labelledby="delivery-list-title"><header class="djj-field-section-head"><div><h2 id="delivery-list-title">Entregas</h2><p>Qué entregar, dónde y qué acción requiere cada parada.</p></div></header>@foreach (var d in Model.Entregas) { <article class="djj-field-delivery-card delivery-card" data-rutapedidoid="@d.RutaPedidoId" data-estado="@d.EstadoEntrega"><div class="djj-field-card__head"><div><span class="djj-field-card__eyebrow">Parada @d.Secuencia · Pedido #@d.PedidoId</span><h3>@d.Cliente</h3></div><span class="djj-status-badge djj-status-badge--@BadgeEntrega(d.EstadoEntrega)"><span class="delivery-status-label">@TextoEntrega(d.EstadoEntrega)</span></span></div><dl class="djj-field-delivery-details"><div><dt>Dirección</dt><dd>@d.DireccionEntrega</dd></div>@if (!string.IsNullOrWhiteSpace(d.Telefono)) { <div><dt>Teléfono</dt><dd><a href="tel:@d.Telefono">@d.Telefono</a></dd></div> }<div><dt>Total del pedido</dt><dd>₡@d.Total.ToString("N2")</dd></div></dl>@if (d.Latitud.HasValue && d.Longitud.HasValue) { <div class="djj-field-inline-actions"><a href="@WazeUrl(d.Latitud, d.Longitud)" target="_blank" rel="noopener" class="djj-button djj-button--secondary djj-button--sm">Abrir Waze</a><a href="@MapsStopUrl(d.Latitud, d.Longitud)" target="_blank" rel="noopener" class="djj-button djj-button--ghost djj-button--sm">Google Maps</a></div> } else { <p class="djj-field-helper"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-info"></use></svg>Sin coordenada: pedí a logística que ubique esta parada.</p> }
@if (editable && d.EstadoEntrega != "Entregado" && d.EstadoEntrega != "Fallido") { <div class="djj-field-delivery-actions"><button type="button" class="djj-button djj-button--secondary djj-button--block" data-action="Entregado"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-check"></use></svg>Marcar entregado</button><button type="button" class="djj-button djj-button--ghost" data-action="EnRuta">En ruta</button><button type="button" class="djj-button djj-button--danger-outline" data-action="Fallido">Reportar incidencia</button></div><div class="fallido-box djj-field-inline-form" hidden><label for="fallido-@d.RutaPedidoId">Motivo de la incidencia</label><input id="fallido-@d.RutaPedidoId" type="text" class="djj-input fallido-motivo" maxlength="300" /><button type="button" class="djj-button djj-button--danger" data-action="Fallido-confirm">Confirmar incidencia</button></div> }
@if (d.EstadoEntrega == "Fallido" && !string.IsNullOrWhiteSpace(d.MotivoFallo)) { <p class="djj-field-helper djj-field-helper--danger"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-warning"></use></svg>Motivo: @d.MotivoFallo</p> }
@if (editable) { <details class="djj-field-evidence"><summary>Registrar evidencia <span>(@d.TotalEvidencias)</span></summary><div class="djj-field-evidence__body"><form asp-action="RegisterEvidence" method="post" enctype="multipart/form-data" class="djj-field-form"><h4>Foto</h4>@Html.AntiForgeryToken()<input type="hidden" name="pedidoId" value="@d.PedidoId" /><input type="hidden" name="rutaId" value="@Model.RutaId" /><input type="hidden" name="tipo" value="Foto" /><label for="photo-@d.RutaPedidoId">Archivo de foto</label><input id="photo-@d.RutaPedidoId" type="file" name="archivo" accept="image/*" capture="environment" class="djj-input" required data-file-label="photo-label-@d.RutaPedidoId" /><small id="photo-label-@d.RutaPedidoId">Ningún archivo seleccionado</small><label for="photo-note-@d.RutaPedidoId">Observaciones <span>(opcional)</span></label><input id="photo-note-@d.RutaPedidoId" type="text" name="observaciones" class="djj-input" maxlength="300" /><button type="submit" class="djj-button djj-button--primary djj-button--block">Guardar foto</button></form><form asp-action="RegisterEvidence" method="post" class="sig-form djj-field-form"><h4>Firma</h4>@Html.AntiForgeryToken()<input type="hidden" name="pedidoId" value="@d.PedidoId" /><input type="hidden" name="rutaId" value="@Model.RutaId" /><input type="hidden" name="tipo" value="Firma" /><input type="hidden" name="firmaBase64" class="sig-data" /><canvas class="sig-canvas" width="320" height="140" aria-label="Área para capturar firma"></canvas><label for="sign-note-@d.RutaPedidoId">Observaciones <span>(opcional)</span></label><input id="sign-note-@d.RutaPedidoId" type="text" name="observaciones" class="djj-input" maxlength="300" /><div class="djj-field-inline-actions"><button type="button" class="djj-button djj-button--ghost sig-clear">Limpiar</button><button type="submit" class="djj-button djj-button--primary">Guardar firma</button></div></form></div></details> } else if (d.TotalEvidencias > 0) { <p class="djj-field-helper djj-field-helper--success"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-check"></use></svg>@d.TotalEvidencias evidencia(s) registrada(s)</p> }</article> }</section>

@section Scripts {
    <script>window.driverDeliveriesConfig = { updateUrl: '@Url.Action("UpdateStatus", "DriverDeliveries")', token: document.querySelector('input[name="__RequestVerificationToken"]').value };</script>
    <script src="~/js/driver-deliveries.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            var routeId = @Model.RutaId, storageScope = 'driver-route-v2:' + routeId, storageTtlMs = 12 * 60 * 60 * 1000, offlineStorage = window.DistribuidoraJJOfflineStorage;
            var liveStops = @Html.Raw(routeStopsJson), offline = !navigator.onLine, stops = liveStops;
            if (offline) { try { var cached = offlineStorage ? offlineStorage.read(storageScope) : null; if (cached && cached.length) { stops = cached; document.getElementById('mapOfflineBanner').hidden = false; } } catch (e) { } }
            else if (liveStops.length) { try { if (offlineStorage) offlineStorage.write(storageScope, liveStops, storageTtlMs); } catch (e) { } }
            stops.sort(function (a, b) { return a.seq - b.seq; });
            if (!stops.length) { document.getElementById('noCoordsBanner').hidden = false; return; }
            var map = L.map('routeMap'), accent = getComputedStyle(document.documentElement).getPropertyValue('--djj-color-primary').trim();
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map);
            var latlngs = [];
            stops.forEach(function (s) { var ll = [s.lat, s.lng]; latlngs.push(ll); var icon = L.divIcon({ className: '', html: '<div class="djj-field-route-pin">' + s.seq + '</div>', iconSize: [26, 26], iconAnchor: [13, 13] }); L.marker(ll, { icon: icon }).addTo(map).bindPopup('<strong>#' + s.seq + ' · ' + s.cliente + '</strong><br>' + s.dir + '<br><em>' + s.estado + '</em>'); });
            if (latlngs.length > 1) L.polyline(latlngs, { color: accent, weight: 3, opacity: .7 }).addTo(map);
            map.fitBounds(L.latLngBounds(latlngs).pad(.2));
            document.getElementById('refreshRouteBtn').addEventListener('click', function () { location.reload(); });
            window.addEventListener('online', function () { location.reload(); });
        })();
    </script>
    <script>
        (function () { document.querySelectorAll('.sig-form').forEach(function (form) { var canvas = form.querySelector('.sig-canvas'); if (!canvas) return; var ctx = canvas.getContext('2d'), drawing = false, dirty = false; ctx.lineWidth = 2; ctx.lineCap = 'round'; ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--djj-color-text').trim(); function pos(e) { var rect = canvas.getBoundingClientRect(), t = e.touches ? e.touches[0] : e; return { x: (t.clientX - rect.left) * (canvas.width / rect.width), y: (t.clientY - rect.top) * (canvas.height / rect.height) }; } function start(e) { drawing = true; dirty = true; var p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); e.preventDefault(); } function move(e) { if (!drawing) return; var p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); e.preventDefault(); } function end() { drawing = false; } canvas.addEventListener('mousedown', start); canvas.addEventListener('mousemove', move); window.addEventListener('mouseup', end); canvas.addEventListener('touchstart', start); canvas.addEventListener('touchmove', move); canvas.addEventListener('touchend', end); form.querySelector('.sig-clear')?.addEventListener('click', function () { ctx.clearRect(0, 0, canvas.width, canvas.height); dirty = false; }); form.addEventListener('submit', function (e) { if (!dirty) { e.preventDefault(); canvas.focus(); } }); }); })();
    </script>
}
