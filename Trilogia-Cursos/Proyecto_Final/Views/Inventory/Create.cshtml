@model Proyecto_Final.Models.Admin.ProductFormViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Crear producto"; var categories=ViewBag.Categorias as List<string>??new(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Producto</span><h1>Crear producto</h1><p>Agregá un producto y su inventario inicial.</p></div></header>
<div class="djj-form-layout"><form asp-action="Create" method="post" enctype="multipart/form-data" class="djj-card djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><fieldset><legend>Información comercial</legend><div class="djj-field"><label asp-for="Nombre" class="djj-field__label"></label><input asp-for="Nombre" class="djj-input" /><span asp-validation-for="Nombre" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Categoria" class="djj-field__label"></label>@if(categories.Any()){<select asp-for="Categoria" class="djj-select"><option value="">Seleccioná una categoría</option>@foreach(var category in categories){<option value="@category">@category</option>}</select>}else{<input asp-for="Categoria" class="djj-input" />}<span asp-validation-for="Categoria" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Descripcion" class="djj-field__label"></label><textarea asp-for="Descripcion" class="djj-textarea" rows="3"></textarea><span asp-validation-for="Descripcion" class="djj-field__error"></span></div></fieldset><fieldset><legend>Precio y existencias</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="Precio" class="djj-field__label">Precio (₡)</label><input asp-for="Precio" class="djj-input" inputmode="decimal" /><span asp-validation-for="Precio" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Stock" class="djj-field__label">Stock inicial</label><input asp-for="Stock" class="djj-input" inputmode="numeric" /><span asp-validation-for="Stock" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="StockMinimo" class="djj-field__label"></label><input asp-for="StockMinimo" class="djj-input" inputmode="numeric" aria-describedby="stock-min-help" /><small id="stock-min-help" class="djj-field__hint">Activa la alerta cuando el stock sea igual o menor.</small><span asp-validation-for="StockMinimo" class="djj-field__error"></span></div></div></fieldset><fieldset><legend>Presentación en tienda</legend><div class="djj-field"><label asp-for="ImagenArchivo" class="djj-field__label"></label><input asp-for="ImagenArchivo" class="djj-input" type="file" accept=".jpg,.jpeg,.png,.webp" aria-describedby="image-help" /><small id="image-help" class="djj-field__hint">JPG, JPEG, PNG o WEBP; máximo 2 MB.</small><span asp-validation-for="ImagenArchivo" class="djj-field__error"></span></div><label class="djj-check"><input asp-for="Activo" />Producto activo</label><label class="djj-check"><input asp-for="EsDestacado" />Mostrar como destacado</label></fieldset><div class="djj-form-actions"><a class="djj-button djj-button--ghost" asp-action="Index">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Guardar producto</button></div></form><aside class="djj-card djj-form-guidance"><h2>Antes de guardar</h2><ul><li>El SKU se asigna automáticamente.</li><li>El stock inicial genera trazabilidad cuando es mayor a cero.</li><li>Los campos con validación deben conservar valores válidos.</li></ul></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
