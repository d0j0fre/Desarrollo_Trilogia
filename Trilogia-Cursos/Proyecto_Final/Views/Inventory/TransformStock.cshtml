@model Proyecto_Final.Models.Admin.StockTransformationFormViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Transformar stock"; var products=ViewBag.Productos as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>??new(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Transformación</span><h1>Transformar stock</h1><p>Convertí existencias entre presentaciones relacionadas.</p></div></header><form asp-action="TransformStock" method="post" class="djj-card djj-workspace-form djj-workspace-form--narrow">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><fieldset><legend>Producto de origen</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="ProductoOrigenId" class="djj-field__label"></label><select asp-for="ProductoOrigenId" asp-items="products" class="djj-select"><option value="">Seleccioná el origen</option></select><span asp-validation-for="ProductoOrigenId" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="CantidadOrigen" class="djj-field__label"></label><input asp-for="CantidadOrigen" class="djj-input" type="number" min="1" /><span asp-validation-for="CantidadOrigen" class="djj-field__error"></span></div></div></fieldset><fieldset><legend>Producto de destino</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="ProductoDestinoId" class="djj-field__label"></label><select asp-for="ProductoDestinoId" asp-items="products" class="djj-select"><option value="">Seleccioná el destino</option></select><span asp-validation-for="ProductoDestinoId" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="CantidadDestino" class="djj-field__label"></label><input asp-for="CantidadDestino" class="djj-input" type="number" min="1" /><span asp-validation-for="CantidadDestino" class="djj-field__error"></span></div></div></fieldset><div class="djj-field"><label asp-for="Motivo" class="djj-field__label"></label><textarea asp-for="Motivo" class="djj-textarea" rows="3"></textarea><span asp-validation-for="Motivo" class="djj-field__error"></span></div><div class="djj-form-actions"><a class="djj-button djj-button--ghost" asp-action="Movements">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Transformar stock</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
