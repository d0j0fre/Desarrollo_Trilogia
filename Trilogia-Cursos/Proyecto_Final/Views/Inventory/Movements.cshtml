@model IEnumerable<Proyecto_Final.Models.Admin.InventoryMovementViewModel>
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Movimientos de inventario"; var rows=Model.ToList(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Trazabilidad</span><h1>Movimientos</h1><p>Entradas, salidas, ajustes y transformaciones registradas.</p></div><div class="djj-page-header__actions"><a class="djj-button djj-button--outline" asp-action="TransformStock">Transformar stock</a><a class="djj-button djj-button--primary" asp-action="RegisterMovement">Registrar movimiento</a></div></header><nav class="djj-domain-nav" aria-label="Inventario"><a asp-action="Index">Productos</a><a asp-action="Movements" aria-current="page">Movimientos</a><a asp-controller="InventoryIntelligence" asp-action="Index">Inteligencia</a></nav>
<section class="djj-card djj-operational-table"><div class="djj-card__header"><div><h2>Historial</h2><p>@rows.Count movimiento(s)</p></div></div><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><caption class="djj-sr-only">Historial de movimientos de inventario</caption><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th class="djj-table__number">Cantidad</th><th class="djj-table__number">Anterior</th><th class="djj-table__number">Nuevo</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody>@if(!rows.Any()){<tr><td colspan="8"><div class="djj-state"><h3>Sin movimientos</h3><p>Los cambios de inventario aparecerán aquí.</p></div></td></tr>}else{@foreach(var item in rows){var tone=item.TipoMovimiento=="Entrada"?"success":item.TipoMovimiento=="Salida"?"danger":"warning";<tr><td class="djj-table__nowrap">@item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@item.Producto</strong></td><td><span class="djj-status-badge djj-status-badge--@tone">@item.TipoMovimiento</span></td><td class="djj-table__number">@item.Cantidad</td><td class="djj-table__number">@item.StockAnterior</td><td class="djj-table__number">@item.StockNuevo</td><td>@(item.Motivo??"Sin motivo")</td><td>@item.Usuario</td></tr>}}</tbody></table></div></section>
