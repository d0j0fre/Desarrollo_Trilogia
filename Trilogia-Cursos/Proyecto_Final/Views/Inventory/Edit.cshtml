@model Proyecto_Final.Models.Admin.ProductFormViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Editar producto"; var categories=ViewBag.Categorias as List<string>??new(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · SKU-@Model.ProductoId.ToString("D5")</span><h1>Editar @Model.Nombre</h1><p>Actualizá información, existencias y visibilidad.</p></div></header>
<div class="djj-form-layout"><form asp-action="Edit" method="post" enctype="multipart/form-data" class="djj-card djj-workspace-form">@Html.AntiForgeryToken()<input asp-for="ProductoId" type="hidden" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><fieldset><legend>Información comercial</legend><div class="djj-field"><label class="djj-field__label" for="product-sku">Código SKU</label><input id="product-sku" class="djj-input" value="SKU-@Model.ProductoId.ToString("D5")" readonly /></div><div class="djj-field"><label asp-for="Nombre" class="djj-field__label"></label><input asp-for="Nombre" class="djj-input" /><span asp-validation-for="Nombre" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Categoria" class="djj-field__label"></label>@if(categories.Any()){<select asp-for="Categoria" class="djj-select">@foreach(var category in categories){<option value="@category">@category</option>}</select>}else{<input asp-for="Categoria" class="djj-input" />}<span asp-validation-for="Categoria" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Descripcion" class="djj-field__label"></label><textarea asp-for="Descripcion" class="djj-textarea" rows="3"></textarea><span asp-validation-for="Descripcion" class="djj-field__error"></span></div></fieldset><fieldset><legend>Precio y existencias</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="Precio" class="djj-field__label">Precio (₡)</label><input asp-for="Precio" class="djj-input" inputmode="decimal" /><span asp-validation-for="Precio" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Stock" class="djj-field__label"></label><input asp-for="Stock" class="djj-input" inputmode="numeric" /><span asp-validation-for="Stock" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="StockMinimo" class="djj-field__label"></label><input asp-for="StockMinimo" class="djj-input" inputmode="numeric" /><span asp-validation-for="StockMinimo" class="djj-field__error"></span></div></div></fieldset><fieldset><legend>Presentación en tienda</legend>@if(!string.IsNullOrWhiteSpace(Model.ImagenUrl)){<img class="djj-product-preview" src="@Url.Content(Model.ImagenUrl)" alt="Imagen actual de @Model.Nombre" width="112" height="112" />}<div class="djj-field"><label asp-for="ImagenArchivo" class="djj-field__label">Reemplazar imagen</label><input asp-for="ImagenArchivo" class="djj-input" type="file" accept=".jpg,.jpeg,.png,.webp" /><span asp-validation-for="ImagenArchivo" class="djj-field__error"></span></div><label class="djj-check"><input asp-for="Activo" />Producto activo</label><label class="djj-check"><input asp-for="EsDestacado" />Mostrar como destacado</label></fieldset><div class="djj-form-actions"><a class="djj-button djj-button--ghost" asp-action="Index">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Guardar cambios</button></div></form><aside class="djj-form-guidance">@if(!string.IsNullOrWhiteSpace(Model.ImagenUrl)){<form asp-action="RemoveImage" method="post" data-djj-confirm="Retirar la imagen actual de @Model.Nombre.">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@Model.ProductoId" /><button class="djj-button djj-button--danger" type="submit">Retirar imagen actual</button></form>}<div class="djj-card"><h2>Trazabilidad</h2><p>Modificar el stock registra un ajuste en el historial.</p></div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
