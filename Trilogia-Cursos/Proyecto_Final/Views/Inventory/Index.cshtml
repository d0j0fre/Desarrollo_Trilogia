@model IEnumerable<Proyecto_Final.Models.Admin.ProductAdminViewModel>
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Inventario"; var filtro=ViewBag.Filtro as string; var products=Model.ToList(); var alerts=products.Where(x=>x.Stock<=x.StockMinimo).ToList(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Productos</span><h1>Inventario</h1><p>Productos, existencias y disponibilidad del catálogo.</p></div><div class="djj-page-header__actions"><a class="djj-button djj-button--primary" asp-action="Create"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-package"></use></svg>Nuevo producto</a></div></header>
<nav class="djj-domain-nav" aria-label="Inventario"><a asp-action="Index" aria-current="page">Productos</a><a asp-action="Movements">Movimientos</a><a asp-controller="InventoryIntelligence" asp-action="Index">Inteligencia</a><a asp-controller="Combos" asp-action="Index">Combos</a><a asp-controller="Returns" asp-action="Index">Devoluciones</a></nav>
<form method="get" class="djj-filter-bar" role="search"><div class="djj-field djj-filter-bar__search"><label class="djj-field__label" for="inventory-search">Buscar productos</label><input id="inventory-search" class="djj-input" type="search" name="filtro" value="@filtro" placeholder="Nombre o categoría" /></div><button class="djj-button djj-button--outline" type="submit"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-search"></use></svg>Buscar</button>@if(!string.IsNullOrWhiteSpace(filtro)){<a class="djj-button djj-button--ghost" asp-action="Index">Limpiar</a>}<span class="djj-filter-bar__result" aria-live="polite">@products.Count resultado(s)</span></form>
@if(alerts.Any()){<div class="djj-alert djj-alert--warning" role="status"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-warning"></use></svg><div><strong>@alerts.Count producto(s) requieren atención</strong><p>El stock está agotado o alcanzó el mínimo configurado.</p></div></div>}
<section class="djj-card djj-operational-table" aria-labelledby="inventory-table-title"><div class="djj-card__header"><div><h2 id="inventory-table-title">Productos</h2><p>Datos actuales del inventario.</p></div></div><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><caption class="djj-sr-only">Listado de productos, existencias, estado y acciones</caption><thead><tr><th>Producto</th><th>Categoría</th><th class="djj-table__number">Precio</th><th class="djj-table__number">Stock</th><th class="djj-table__number">Mínimo</th><th>Disponibilidad</th><th>Catálogo</th><th class="djj-table__actions">Acciones</th></tr></thead><tbody>@if(!products.Any()){<tr><td colspan="8"><div class="djj-state"><span class="djj-state__icon"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-package"></use></svg></span><h3>@(string.IsNullOrWhiteSpace(filtro)?"No hay productos registrados":"No hay coincidencias")</h3><p>@(string.IsNullOrWhiteSpace(filtro)?"Creá el primer producto para comenzar.":"Probá con otro nombre o categoría.")</p></div></td></tr>}else{@foreach(var item in products){var image=string.IsNullOrWhiteSpace(item.ImagenUrl)?Url.Content("~/img/whisky-premium.webp"):Url.Content(item.ImagenUrl); var stockTone=item.Stock<=0?"danger":item.Stock<=item.StockMinimo?"warning":"success"; var stockText=item.Stock<=0?"Agotado":item.Stock<=item.StockMinimo?"Stock bajo":"Disponible";<tr><td class="djj-table__primary"><img class="djj-table-product-image" src="@image" alt="" width="48" height="48" loading="lazy" /><span><strong>@item.Nombre</strong><small>SKU-@item.ProductoId.ToString("D5")</small></span></td><td>@item.Categoria</td><td class="djj-table__number">₡@item.Precio.ToString("N2")</td><td class="djj-table__number">@item.Stock</td><td class="djj-table__number">@item.StockMinimo</td><td><span class="djj-status-badge djj-status-badge--@stockTone"><svg class="djj-icon djj-icon--sm" aria-hidden="true"><use href="#djj-icon-@(stockTone=="success"?"check":"warning")"></use></svg>@stockText</span></td><td><span class="djj-status-badge djj-status-badge--@(item.Activo?"success":"neutral")">@(item.Activo?"Activo":"Inactivo")</span>@if(item.EsDestacado){<small class="djj-table-note">Destacado</small>}</td><td class="djj-table__actions"><div class="djj-row-actions"><a class="djj-button djj-button--outline djj-button--sm" asp-action="Edit" asp-route-id="@item.ProductoId">Editar</a><details class="djj-action-menu"><summary class="djj-icon-button" aria-label="Más acciones para @item.Nombre"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-menu"></use></svg></summary><div><form asp-action="ToggleFeatured" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@item.ProductoId" /><input type="hidden" name="filtro" value="@filtro" /><button type="submit">@(item.EsDestacado?"Quitar destacado":"Marcar destacado")</button></form><form asp-action="ToggleStatus" method="post" data-djj-confirm="@(item.Activo?$"Inactivar {item.Nombre}. Dejará de mostrarse en el catálogo.":$"Reactivar {item.Nombre}. Volverá a mostrarse en el catálogo.")">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@item.ProductoId" /><input type="hidden" name="filtro" value="@filtro" /><button type="submit">@(item.Activo?"Inactivar":"Reactivar")</button></form><form asp-action="DeletePermanent" method="post" data-djj-confirm="Eliminar definitivamente @item.Nombre. Solo continuará si no tiene registros asociados.">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@item.ProductoId" /><input type="hidden" name="filtro" value="@filtro" /><button class="djj-action-menu__danger" type="submit">Eliminar definitivamente</button></form></div></details></div></td></tr>}}</tbody></table></div></section>
