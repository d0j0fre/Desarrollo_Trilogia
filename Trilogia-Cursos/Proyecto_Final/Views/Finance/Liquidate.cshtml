@using Proyecto_Final.Models.Admin
@model CashSettlementFormViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Liquidar cobros"; var prep = ViewBag.Prepare as CashSettlementPrepareViewModel; var esperadoTotal = Model.EsperadoEfectivo + Model.EsperadoOtros; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Ruta @Model.RutaCodigo</span><h1>Liquidar cobros</h1><p>Registrá el efectivo y los comprobantes entregados por el chofer.</p></div><div class="djj-page-header__actions"><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
<div class="djj-kpi-grid"><article class="djj-card djj-kpi-card"><span>Esperado en efectivo</span><strong>₡@Model.EsperadoEfectivo.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Otros medios</span><strong>₡@Model.EsperadoOtros.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Total esperado</span><strong>₡@esperadoTotal.ToString("N2")</strong></article></div>
<div class="djj-detail-layout"><form asp-action="Liquidate" method="post" class="djj-card djj-workspace-form" data-djj-confirm="Registrar la liquidación de la ruta @Model.RutaCodigo. Los montos quedarán asociados al cierre financiero.">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><input type="hidden" asp-for="RutaId" /><input type="hidden" asp-for="RutaCodigo" /><input type="hidden" asp-for="EsperadoEfectivo" /><input type="hidden" asp-for="EsperadoOtros" />
<fieldset><legend>Montos recibidos</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="MontoEfectivoRecibido" class="djj-field__label">Efectivo recibido (₡)</label><input asp-for="MontoEfectivoRecibido" type="number" step="0.01" min="0" inputmode="decimal" class="djj-input" /><span asp-validation-for="MontoEfectivoRecibido" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="MontoComprobantes" class="djj-field__label">Total en comprobantes (₡)</label><input asp-for="MontoComprobantes" type="number" step="0.01" min="0" inputmode="decimal" class="djj-input" /><span asp-validation-for="MontoComprobantes" class="djj-field__error"></span></div></div><div class="djj-field"><label asp-for="Observaciones" class="djj-field__label"></label><textarea asp-for="Observaciones" class="djj-textarea" rows="3"></textarea></div></fieldset>
<fieldset><legend>Detalle de comprobantes <span class="djj-page-header__meta">(opcional)</span></legend>@for (var i = 0; i < 3; i++) { <div class="djj-form-grid djj-financial-line"><div class="djj-field"><label for="voucher-type-@i" class="djj-field__label">Tipo</label><select id="voucher-type-@i" name="Comprobantes[@i].Tipo" class="djj-select"><option value="">Seleccioná</option><option value="SINPE">SINPE</option><option value="Transferencia">Transferencia</option><option value="Depósito">Depósito</option><option value="Cheque">Cheque</option><option value="Otro">Otro</option></select></div><div class="djj-field"><label for="voucher-ref-@i" class="djj-field__label">Referencia</label><input id="voucher-ref-@i" name="Comprobantes[@i].Referencia" class="djj-input" /></div><div class="djj-field"><label for="voucher-amount-@i" class="djj-field__label">Monto (₡)</label><input id="voucher-amount-@i" name="Comprobantes[@i].Monto" type="number" step="0.01" min="0" value="0" inputmode="decimal" class="djj-input" /></div></div> }</fieldset>
<div class="djj-form-actions"><a asp-action="Index" class="djj-button djj-button--ghost">Cancelar</a><button type="submit" class="djj-button djj-button--primary">Registrar liquidación</button></div></form><aside class="djj-card djj-form-guidance"><h2>Antes de registrar</h2><p>Verificá que efectivo y comprobantes coincidan con lo entregado. Una diferencia quedará visible en el historial.</p><dl class="djj-detail-grid"><div><dt>Ruta</dt><dd>@Model.RutaCodigo</dd></div><div><dt>Total esperado</dt><dd class="djj-money">₡@esperadoTotal.ToString("N2")</dd></div></dl></aside></div>
@if (prep != null && prep.Pedidos.Any()) { <section class="djj-card djj-data-section" aria-labelledby="delivered-orders"><header><div><h2 id="delivered-orders">Pedidos entregados</h2><p>Base documental de esta liquidación.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Pedido</th><th>Cliente</th><th>Método de pago</th><th class="djj-align-right">Total</th></tr></thead><tbody>@foreach (var item in prep.Pedidos) { <tr><td><strong>#@item.PedidoId</strong></td><td>@item.Cliente</td><td>@item.MetodoPago</td><td class="djj-align-right">₡@item.Total.ToString("N2")</td></tr> }</tbody></table></div></section> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
