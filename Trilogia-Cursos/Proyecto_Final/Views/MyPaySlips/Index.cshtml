@model IReadOnlyList<Proyecto_Final.Models.Admin.PaySlipListItemViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Mis boletas"; }

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Mi portal · Comprobantes</span><h1>Mis boletas de pago</h1><p>Consultá el desglose privado de tus comprobantes y descargá una copia HTML.</p></div><div class="djj-page-header__actions"><a asp-controller="EmployeePortal" asp-action="Index" class="djj-button djj-button--ghost">Volver a mi portal</a></div></header>
<section class="djj-card djj-data-section" aria-labelledby="my-payslip-title"><header><div><h2 id="my-payslip-title">Comprobantes disponibles</h2><p>@Model.Count registro(s) asociados a tu perfil.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Período</th><th class="djj-align-right">Bruto</th><th class="djj-align-right">Deducciones</th><th class="djj-align-right">Neto</th><th class="djj-align-right">Acciones</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="5"><div class="djj-empty-state"><h3>Sin boletas</h3><p>Todavía no tenés comprobantes disponibles.</p></div></td></tr> }@foreach (var item in Model) { <tr><td>@item.Periodo</td><td class="djj-align-right">₡@item.TotalBruto.ToString("N2")</td><td class="djj-align-right">₡@item.TotalDeducciones.ToString("N2")</td><td class="djj-align-right"><strong>₡@item.TotalNeto.ToString("N2")</strong></td><td><div class="djj-row-actions"><a asp-action="Details" asp-route-id="@item.CalculoId" class="djj-button djj-button--outline djj-button--sm">Ver desglose</a><a asp-action="Download" asp-route-id="@item.CalculoId" class="djj-button djj-button--ghost djj-button--sm">Descargar</a></div></td></tr> }</tbody></table></div></section>
