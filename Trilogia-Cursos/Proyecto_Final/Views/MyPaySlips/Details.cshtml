@model Proyecto_Final.Models.Admin.PaySlipViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Boleta de pago"; string Tone(string state) => state switch { "Pagada" or "Aprobada" => "success", "Revertida" => "danger", "Borrador" => "warning", _ => "neutral" }; }

<article class="djj-payslip" data-djj-print-document>
    <header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Distribuidora JJ · Licorera - Distribuidora</span><h1>Boleta de pago</h1><p>Comprobante privado #@Model.CalculoId</p></div><div class="djj-page-header__actions" data-djj-screen-only><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a><a asp-action="Download" asp-route-id="@Model.CalculoId" class="djj-button djj-button--outline">Descargar HTML</a><button type="button" class="djj-button djj-button--primary" onclick="window.print()">Imprimir</button></div></header>
    <section class="djj-card" aria-labelledby="payslip-summary"><div class="djj-card__header"><div><h2 id="payslip-summary">Resumen</h2><p>@Model.Empleado · @Model.Periodo</p></div><span class="djj-status-badge djj-status-badge--@Tone(Model.Estado)">@Model.Estado</span></div><dl class="djj-detail-grid djj-detail-grid--four"><div><dt>Empleado</dt><dd>@Model.Empleado</dd></div><div><dt>Período</dt><dd>@Model.Periodo</dd></div><div><dt>Horas ordinarias</dt><dd class="djj-number">@Model.HorasOrdinarias.ToString("N2") h</dd></div><div><dt>Horas extra</dt><dd class="djj-number">@Model.HorasExtra.ToString("N2") h</dd></div></dl></section>
    <section class="djj-card djj-data-section" aria-labelledby="payslip-lines"><header><div><h2 id="payslip-lines">Conceptos</h2><p>Desglose generado desde el cálculo registrado.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Código</th><th>Concepto</th><th>Tipo</th><th class="djj-align-right">Monto</th></tr></thead><tbody>@if (!Model.Lineas.Any()) { <tr><td colspan="4"><div class="djj-empty-state"><h3>Sin conceptos</h3><p>Esta boleta no contiene líneas de desglose.</p></div></td></tr> }@foreach (var line in Model.Lineas) { <tr><td>@line.Codigo</td><td>@line.Nombre</td><td>@line.Tipo</td><td class="djj-align-right">₡@line.Monto.ToString("N2")</td></tr> }</tbody></table></div></section>
    <section class="djj-payslip-totals" aria-label="Totales de la boleta"><div><span>Salario base</span><strong>₡@Model.SalarioBase.ToString("N2")</strong></div><div><span>Comisiones</span><strong>₡@Model.Comisiones.ToString("N2")</strong></div><div><span>Total bruto</span><strong>₡@Model.TotalBruto.ToString("N2")</strong></div><div><span>Deducciones</span><strong>₡@Model.TotalDeducciones.ToString("N2")</strong></div><div class="djj-payslip-totals__net"><span>Total neto</span><strong>₡@Model.TotalNeto.ToString("N2")</strong></div></section>
</article>
