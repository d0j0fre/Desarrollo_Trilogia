@using Proyecto_Final.Services
@model Proyecto_Final.Models.Admin.PaySlipViewModel
@{ ViewData["Title"]="Boleta de pago"; }
<div class="container py-4"><h2>Boleta de pago</h2><dl class="row"><dt class="col-sm-3">Empleado</dt><dd class="col-sm-9">@Model.Empleado</dd><dt class="col-sm-3">Período</dt><dd class="col-sm-9">@RrhhFormat.PeriodText(Model.Periodo)</dd><dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.Estado</dd></dl>
<div class="table-responsive">
<table class="table"><thead><tr><th>Código</th><th>Concepto</th><th>Tipo</th><th class="text-right">Monto</th></tr></thead><tbody>@foreach(var line in Model.Lineas){<tr><td>@line.Codigo</td><td>@line.Nombre</td><td>@RrhhFormat.ConceptType(line.Tipo)</td><td class="text-right">@RrhhFormat.Money(line.Monto)</td></tr>}</tbody></table></div>
<dl class="row"><dt class="col-sm-3">Salario base</dt><dd class="col-sm-9">@RrhhFormat.Money(Model.SalarioBase)</dd><dt class="col-sm-3">Total bruto</dt><dd class="col-sm-9">@RrhhFormat.Money(Model.TotalBruto)</dd><dt class="col-sm-3">Deducciones</dt><dd class="col-sm-9">@RrhhFormat.Money(Model.TotalDeducciones)</dd><dt class="col-sm-3">Total neto</dt><dd class="col-sm-9"><strong>@RrhhFormat.Money(Model.TotalNeto)</strong></dd></dl><a asp-action="Download" asp-route-id="@Model.CalculoId" class="btn btn-ds-view">Descargar PDF privado</a></div>
