@model Proyecto_Final.Models.Admin.InventoryReportViewModel
@using Proyecto_Final.Models.Admin
@{
    ViewData["Title"] = "Reporte de inventario";
    string Clase(string estado) => estado switch { "Agotado" => "danger", "Bajo" => "warning", _ => "success" };
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    @*(CU-133)*@
                    <h2 class="mb-2">Reporte de inventario</h2>
                    <p class="mb-0">Existencias y valor del inventario al día de hoy.</p>
                </div>
                <div class="mt-3 mt-md-0">
                    <button type="button" id="exportInventoryXlsx" class="btn btn-ds-view mr-2"@(Model.TotalProductos == 0 ? " disabled" : "")>
                        <i class="fa fa-file-excel mr-1"></i>Exportar Excel
                    </button>
                    <a asp-controller="Inventory" asp-action="Index" class="btn btn-ds-neutral"><i class="fa fa-boxes mr-1"></i>Ir al inventario</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-3">
        <div class="col-12">
            <form method="get" class="admin-filter-bar form-row align-items-end">
                <div class="form-group col-md-4">
                    <label for="filtro">Producto, SKU o categoría</label>
                    <input id="filtro" type="text" name="filtro" value="@Model.Filtro" class="form-control" placeholder="Buscar..." />
                </div>
                <div class="form-group col-md-3">
                    <label for="estado">Estado de existencias</label>
                    <select id="estado" name="estado" class="form-control">
                        <option value="todos" selected="@(Model.Estado == InventoryReportViewModel.AllStatuses)">Todos</option>
                        <option value="agotado" selected="@(Model.Estado == InventoryReportViewModel.OutStatus)">Agotados</option>
                        <option value="bajo" selected="@(Model.Estado == InventoryReportViewModel.LowStatus)">Stock bajo</option>
                        <option value="normal" selected="@(Model.Estado == InventoryReportViewModel.OkStatus)">Normal</option>
                    </select>
                </div>
                <div class="form-group col-md-3">
                    <div class="custom-control custom-checkbox mb-2">
                        <input type="checkbox" class="custom-control-input" id="incluirInactivos" name="incluirInactivos" value="true" checked="@Model.IncluirInactivos" />
                        <label class="custom-control-label" for="incluirInactivos">Incluir productos inactivos</label>
                    </div>
                </div>
                <div class="form-group col-md-2">
                    <button type="submit" class="btn btn-ds-search btn-block"><i class="fa fa-filter mr-1"></i>Consultar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row px-xl-5 mb-4">
        <div class="col-md-3 mb-3"><div class="card"><div class="card-body"><small>Productos</small><h4>@Model.TotalProductos</h4></div></div></div>
        <div class="col-md-3 mb-3"><div class="card"><div class="card-body"><small>Unidades en existencia</small><h4>@Model.TotalUnidades.ToString("N0")</h4></div></div></div>
        <div class="col-md-3 mb-3"><div class="card"><div class="card-body"><small>Valor a precio de venta</small><h4>₡@Model.ValorInventario.ToString("N2")</h4></div></div></div>
        <div class="col-md-3 mb-3"><div class="card"><div class="card-body"><small>Agotados / stock bajo</small><h4>@Model.Agotados / @Model.StockBajo</h4></div></div></div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-12 table-responsive">
            <table class="table table-hover" id="inventoryReportTable">
                <thead class="thead-light">
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-right">Existencias</th>
                        <th class="text-right">Mínimo</th>
                        <th class="text-right">Precio</th>
                        <th class="text-right">Valor</th>
                        <th>Estado</th>
                        <th>Vence</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Filas.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay productos para los filtros seleccionados.</td></tr>
                    }
                    @foreach (var f in Model.Filas)
                    {
                        <tr>
                            <td>@f.Nombre@if (!f.Activo) { <span class="badge badge-secondary ml-1">Inactivo</span> }</td>
                            <td>@f.Categoria</td>
                            <td class="text-right">@f.Stock.ToString("N0")</td>
                            <td class="text-right">@f.StockMinimo.ToString("N0")</td>
                            <td class="text-right">₡@f.Precio.ToString("N2")</td>
                            <td class="text-right">₡@f.ValorInventario.ToString("N2")</td>
                            <td><span class="admin-badge-soft @Clase(f.Estado)">@f.Estado</span></td>
                            <td>@(f.FechaVencimiento.HasValue ? f.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/xlsx-export.js" asp-append-version="true"></script>
    <script>
        (function () {
            const button = document.getElementById('exportInventoryXlsx');
            if (!button) return;
            const data = @Json.Serialize(new
            {
                resumen = new
                {
                    productos = Model.TotalProductos.ToString(),
                    unidades = Model.TotalUnidades.ToString("N0"),
                    valor = Model.ValorInventario.ToString("N2"),
                    agotados = Model.Agotados.ToString(),
                    bajos = Model.StockBajo.ToString()
                },
                filas = Model.Filas.Select(f => new
                {
                    producto = f.Nombre,
                    categoria = f.Categoria,
                    stock = f.Stock.ToString(),
                    minimo = f.StockMinimo.ToString(),
                    precio = f.Precio.ToString("N2"),
                    valor = f.ValorInventario.ToString("N2"),
                    estado = f.Estado + (f.Activo ? "" : " (inactivo)"),
                    vence = f.FechaVencimiento.HasValue ? f.FechaVencimiento.Value.ToString("dd/MM/yyyy") : ""
                })
            });
            button.addEventListener('click', function () {
                const bold = window.XlsxExport.STYLE.bold;
                const rows = [];
                const row = function () { rows.push(Array.prototype.map.call(arguments, function (v) { return { text: String(v == null ? '' : v) }; })); };
                const head = function () { rows.push(Array.prototype.map.call(arguments, function (v) { return { text: String(v), style: bold }; })); };
                head('Reporte de inventario', new Date().toLocaleDateString('es-CR'));
                row('Productos', data.resumen.productos);
                row('Unidades en existencia', data.resumen.unidades);
                row('Valor a precio de venta (₡)', data.resumen.valor);
                row('Agotados', data.resumen.agotados);
                row('Stock bajo', data.resumen.bajos);
                row();
                head('Producto', 'Categoría', 'Existencias', 'Mínimo', 'Precio (₡)', 'Valor (₡)', 'Estado', 'Vence');
                data.filas.forEach(function (f) { row(f.producto, f.categoria, f.stock, f.minimo, f.precio, f.valor, f.estado, f.vence); });
                window.XlsxExport.download('inventario-' + new Date().toISOString().slice(0, 10) + '.xlsx', 'Inventario', rows, [36, 20, 13, 10, 14, 16, 18, 12]);
            });
        })();
    </script>
}
