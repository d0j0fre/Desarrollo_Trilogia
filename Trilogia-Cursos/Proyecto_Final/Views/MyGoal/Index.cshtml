@model Proyecto_Final.Models.Admin.MetaProgresoViewModel
@{
    ViewData["Title"] = "Mi progreso";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    // CU-212 escenario 2: sin ventas/meta el indicador se muestra en 0%.
    var barraClase = Model.PorcentajeBarra >= 100 ? "success" : Model.PorcentajeBarra >= 70 ? "warning" : "danger";
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
    <style>
        .progreso-bar-track { background: #e9ecef; border-radius: 8px; height: 28px; }
        .progreso-bar-fill { border-radius: 8px; height: 28px; transition: width .4s ease; }
        .progreso-valor { font-size: 2rem; font-weight: 700; }
    </style>
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header">
                <h2 class="mb-2">Mi progreso</h2>
                <p>Meta de ventas — @meses[Model.Mes] @Model.Anio (CU-212).</p>
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-4">
        <div class="col-12">
            <div class="admin-card p-4">
                @if (Model.SinMetaDefinida)
                {
                    <div class="alert alert-info mb-0">
                        Todavía no tenés una meta asignada para este mes. Consultá con tu gerente de ventas.
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="progreso-valor">@Model.PorcentajeCumplimiento.ToString("0.##")%</span>
                        <span class="text-muted">Meta: ₡@Model.MontoMeta.ToString("N2")</span>
                    </div>

                    <div class="progreso-bar-track mb-3">
                        <div class="progreso-bar-fill bg-@barraClase" style="width:@Model.PorcentajeBarra.ToString("0.##")%"></div>
                    </div>

                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="text-muted small">Vendido</div>
                            <div class="h5">₡@Model.VentasReales.ToString("N2")</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Pendiente</div>
                            <div class="h5">₡@Model.MontoPendiente.ToString("N2")</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Meta mensual</div>
                            <div class="h5">₡@Model.MontoMeta.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>