@model Proyecto_Final.Models.Admin.ReturnsIndexViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Devoluciones"; var productos=ViewBag.Productos as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>??new(); string Tone(string state)=>state=="Reintegrada"?"success":state=="Descartada"?"danger":"warning"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Devoluciones</span><h1>Devoluciones de productos</h1><p>Toda mercadería devuelta pasa a cuarentena antes de reintegrarse.</p></div><a asp-action="Quarantine" class="djj-button djj-button--outline">Ver cuarentena</a></header>
<div class="djj-detail-layout"><section class="djj-card"><div class="djj-card__header"><div><h2>Registrar devolución</h2><p>Indicá el producto y el motivo.</p></div></div><form asp-action="Create" method="post" class="djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="djj-validation-summary" role="alert" tabindex="-1"></div><div class="djj-field"><label asp-for="Nueva.ProductoId">Producto</label><select asp-for="Nueva.ProductoId" class="djj-select" asp-items="productos"><option value="">Seleccioná un producto</option></select><span asp-validation-for="Nueva.ProductoId" class="djj-field__error"></span></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="Nueva.Cantidad">Cantidad</label><input asp-for="Nueva.Cantidad" class="djj-input" type="number" min="1" /><span asp-validation-for="Nueva.Cantidad" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Nueva.PedidoId">Pedido asociado (opcional)</label><input asp-for="Nueva.PedidoId" class="djj-input" type="number" min="1" /><span asp-validation-for="Nueva.PedidoId" class="djj-field__error"></span></div></div><div class="djj-field"><label asp-for="Nueva.ClienteInfo">Cliente / referencia (opcional)</label><input asp-for="Nueva.ClienteInfo" class="djj-input" /><span asp-validation-for="Nueva.ClienteInfo" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Nueva.Motivo">Motivo</label><textarea asp-for="Nueva.Motivo" class="djj-textarea" rows="3"></textarea><span asp-validation-for="Nueva.Motivo" class="djj-field__error"></span></div><button type="submit" class="djj-button djj-button--primary">Registrar devolución</button></form></section>
<section class="djj-card djj-data-section"><form asp-action="Index" method="get" class="djj-filter-bar djj-padded"><div class="djj-field"><label for="return-search">Buscar</label><input id="return-search" name="buscar" value="@Model.Buscar" class="djj-input" /></div><div class="djj-field"><label for="return-state">Estado</label><select id="return-state" name="estado" class="djj-select"><option value="">Todos</option>@foreach(var state in new[]{"EnCuarentena","Reintegrada","Descartada"}){<option value="@state" selected="@(Model.Estado==state)">@state</option>}</select></div><button class="djj-button djj-button--outline">Filtrar</button></form>@if(!Model.Devoluciones.Any()){<div class="djj-empty-state"><h3>Sin devoluciones</h3><p>No hay registros para este filtro.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Cantidad</th><th>Motivo</th><th>Estado</th><th>Fecha</th></tr></thead><tbody>@foreach(var item in Model.Devoluciones){<tr><td><strong>@item.ProductoNombre</strong></td><td class="djj-align-right">@item.Cantidad</td><td>@item.Motivo</td><td><span class="djj-badge djj-badge--@Tone(item.Estado)">@(item.Estado=="EnCuarentena"?"En cuarentena":item.Estado)</span></td><td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div>}</section></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
