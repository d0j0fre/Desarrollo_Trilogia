@model IEnumerable<Proyecto_Final.Models.Admin.ReturnListItemViewModel>
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Cuarentena"; var buscar=ViewBag.Buscar as string; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Inventario · Cuarentena</span><h1>Productos en cuarentena</h1><p>Liberá para reintegrar al inventario o descartá de forma definitiva.</p></div><a asp-action="Index" class="djj-button djj-button--ghost">Volver a devoluciones</a></header><section class="djj-card djj-filter-card"><form asp-action="Quarantine" method="get" class="djj-filter-bar"><div class="djj-field"><label for="quarantine-search">Buscar</label><input id="quarantine-search" name="buscar" value="@buscar" class="djj-input" /></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--primary">Buscar</button><a asp-action="Quarantine" class="djj-button djj-button--ghost">Limpiar</a></div><span class="djj-filter-bar__results">@(Model?.Count()??0) registros</span></form></section>
<section class="djj-card djj-data-section">@if(Model==null||!Model.Any()){<div class="djj-empty-state"><h3>Cuarentena vacía</h3><p>No hay productos retenidos.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Producto</th><th class="djj-align-right">Cantidad</th><th>Motivo</th><th>Registrado por</th><th>Fecha</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.ProductoNombre</strong></td><td class="djj-align-right">@item.Cantidad</td><td>@item.Motivo</td><td>@item.RegistradoPorNombre</td><td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td><td><div class="djj-row-actions"><form asp-action="Release" method="post" data-djj-confirm="Liberar @item.Cantidad unidad(es) de @item.ProductoNombre y reintegrarlas al inventario.">@Html.AntiForgeryToken()<input type="hidden" name="devolucionId" value="@item.DevolucionId" /><button class="djj-button djj-button--success djj-button--sm">Liberar</button></form><form asp-action="Discard" method="post" data-djj-confirm="Descartar @item.Cantidad unidad(es) de @item.ProductoNombre. No se reintegrarán al inventario.">@Html.AntiForgeryToken()<input type="hidden" name="devolucionId" value="@item.DevolucionId" /><button class="djj-button djj-button--danger djj-button--sm">Descartar</button></form></div></td></tr>}</tbody></table></div>}</section>
