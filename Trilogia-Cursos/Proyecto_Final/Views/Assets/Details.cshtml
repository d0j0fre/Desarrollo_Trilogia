@model Proyecto_Final.Models.Admin.AssetDetailViewModel
@using Proyecto_Final.Models.Presentation
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Detalle de activo"; var a = Model.Activo; }
<div class="djj-assets djj-stack">
    <partial name="_AssetsNavigation" />
    <header class="djj-page-header"><div><h1>Activo @a.CodigoActivo</h1><p>@a.Nombre</p></div><div class="djj-filter-bar__actions"><a asp-action="Edit" asp-route-id="@a.ActivoId" class="djj-button djj-button--primary">Editar activo</a><a asp-action="Index" class="djj-button djj-button--outline">Volver</a></div></header>
    <section class="djj-card djj-padded"><h2>Identidad y préstamo actual</h2><dl class="djj-assets-facts"><div><dt>Código de activo</dt><dd>@a.CodigoActivo</dd></div><div><dt>Tipo</dt><dd>@a.Tipo</dd></div><div><dt>Estado</dt><dd><span class="djj-badge djj-badge--@AssetPresentation.AssetTone(a.Estado)">@a.Estado</span></dd></div><div><dt>Prestado a</dt><dd>@(string.IsNullOrWhiteSpace(a.ClientePrestamo) ? "Sin préstamo registrado" : a.ClientePrestamo)</dd></div><div class="djj-form-grid__full"><dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(a.Descripcion) ? "Sin descripción" : a.Descripcion)</dd></div></dl></section>
    <section class="djj-card djj-data-section"><header><div><h2>Historial de comodatos</h2><p>@Model.Historial.Count asignación(es) registrada(s).</p></div></header><div class="djj-table-wrap" tabindex="0" aria-label="Historial de comodatos desplazable"><table class="djj-table"><caption class="djj-sr-only">Clientes, fechas, estado y observaciones del historial de préstamo</caption><thead><tr><th scope="col">Comodato / cliente</th><th scope="col">Asignado</th><th scope="col">Devuelto</th><th scope="col">Estado</th><th scope="col">Destino</th><th scope="col">Observaciones</th></tr></thead><tbody>
    @if (!Model.Historial.Any()) { <tr><td colspan="6">Este activo no tiene comodatos registrados.</td></tr> }
    @foreach (var h in Model.Historial) { <tr><th scope="row">#@h.ComodatoId<small class="djj-table__note">@h.ClienteNombre</small></th><td class="djj-table__nowrap">@h.FechaAsignacion.ToString("dd/MM/yyyy")</td><td class="djj-table__nowrap">@(h.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "Sin devolución registrada")</td><td><span class="djj-badge djj-badge--@AssetPresentation.ComodatoTone(h.Estado)">@h.Estado</span></td><td>@(string.IsNullOrWhiteSpace(h.DestinoDevolucion) ? "Sin destino registrado" : h.DestinoDevolucion)</td><td>@(string.IsNullOrWhiteSpace(h.Observaciones) ? "Sin observaciones" : h.Observaciones)</td></tr> }
    </tbody></table></div></section>
</div>
