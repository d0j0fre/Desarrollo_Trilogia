@model IEnumerable<Proyecto_Final.Models.Admin.UserNotificationViewModel>
@{
    ViewData["Title"] = "Notificaciones";
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    <h2 class="mb-2"><i class="fa fa-bell mr-2"></i>Notificaciones</h2>
                    <p class="mb-0">Avisos de tu cuenta, como las rutas que te asignan o te reasignan.</p>
                </div>
                @if (Model != null && Model.Any(n => !n.Leida))
                {
                    <form asp-action="MarkAllRead" method="post" class="mt-3 mt-md-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ds-view"><i class="fa fa-check-double mr-2"></i>Marcar todas como leídas</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-12">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">No tienes notificaciones.</div>
            }
            else
            {
                <div class="admin-table-wrapper p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var n in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start @(n.Leida ? "" : "font-weight-bold")">
                                <div class="mr-3">
                                    <div>
                                        @if (!n.Leida)
                                        {
                                            <span class="badge badge-danger mr-1">Nueva</span>
                                        }
                                        @n.Titulo
                                    </div>
                                    <small class="d-block font-weight-normal">@n.Mensaje</small>
                                    <small class="text-muted font-weight-normal">@n.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <form asp-action="Open" asp-route-id="@n.NotificacionId" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-ds-view">
                                        @(n.EntidadTipo == "Ruta" ? "Ver ruta" : "Marcar leída")
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
