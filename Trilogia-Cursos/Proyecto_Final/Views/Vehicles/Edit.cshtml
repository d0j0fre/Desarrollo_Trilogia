@model Proyecto_Final.Models.Admin.VehicleFormViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Editar vehículo"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Logística · Flota</span><h1>Editar vehículo</h1><p>Actualizá sus datos operativos sin alterar las rutas existentes.</p></div></header>
<section class="djj-card djj-form-card" aria-labelledby="vehicle-form-title"><h2 id="vehicle-form-title">Datos del vehículo</h2><form asp-action="Edit" method="post" class="djj-form-grid">@Html.AntiForgeryToken()<input type="hidden" asp-for="VehiculoId" /><div asp-validation-summary="All" class="djj-validation-summary" data-djj-validation-summary tabindex="-1"></div><div class="djj-field"><label asp-for="Placa"></label><input asp-for="Placa" class="djj-input" /><span asp-validation-for="Placa" class="djj-field-error"></span></div><div class="djj-field"><label asp-for="Marca"></label><input asp-for="Marca" class="djj-input" /><span asp-validation-for="Marca" class="djj-field-error"></span></div><div class="djj-field djj-form-grid__full"><label asp-for="Descripcion"></label><input asp-for="Descripcion" class="djj-input" /><span asp-validation-for="Descripcion" class="djj-field-error"></span></div><div class="djj-field"><label asp-for="Capacidad">Capacidad (unidades/cajas)</label><input asp-for="Capacidad" class="djj-input" type="number" min="0" /><span asp-validation-for="Capacidad" class="djj-field-error"></span></div><div class="djj-checkbox-field"><input asp-for="Activo" /><label asp-for="Activo">Disponible para asignación</label></div><div class="djj-form-actions djj-form-grid__full"><button type="submit" class="djj-button djj-button--primary">Guardar cambios</button><a asp-action="Index" class="djj-button djj-button--ghost">Cancelar</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
