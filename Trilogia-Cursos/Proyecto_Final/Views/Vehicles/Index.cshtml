@model IEnumerable<Proyecto_Final.Models.Admin.VehicleListItemViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Vehículos"; var buscar = ViewBag.Buscar as string; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Logística · Flota</span><h1>Vehículos</h1><p>Disponibilidad y capacidad para las rutas de reparto.</p></div><a asp-action="Create" class="djj-button djj-button--primary">Nuevo vehículo</a></header>
<section class="djj-card djj-filter-card" aria-labelledby="vehicle-filters"><h2 id="vehicle-filters">Buscar vehículos</h2><form asp-action="Index" method="get" class="djj-filter-bar"><div class="djj-field"><label for="vehicle-search">Placa o descripción</label><input id="vehicle-search" type="search" name="buscar" value="@buscar" class="djj-input" /></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--neutral">Buscar</button><a asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div></form></section>
<section class="djj-card djj-data-section" aria-labelledby="vehicle-list"><header><div><h2 id="vehicle-list">Flota registrada</h2><p>@(Model?.Count() ?? 0) vehículo(s).</p></div></header><div class="djj-table-wrap"><table class="djj-table"><thead><tr><th>Vehículo</th><th>Descripción</th><th class="djj-align-right">Capacidad</th><th class="djj-align-right">Odómetro</th><th class="djj-align-right">Rutas abiertas</th><th>Estado</th><th><span class="djj-sr-only">Acciones</span></th></tr></thead><tbody>@if (Model == null || !Model.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin vehículos registrados</h3><p>Registrá un vehículo cuando esté disponible para reparto.</p></div></td></tr> } else { @foreach (var v in Model) { <tr><td><strong class="djj-table__primary">@v.Placa</strong><small class="djj-table__note">@(string.IsNullOrWhiteSpace(v.Marca) ? "Marca sin registrar" : v.Marca)</small></td><td>@v.Descripcion</td><td class="djj-align-right">@v.Capacidad</td><td class="djj-align-right">@v.KilometrajeActual km</td><td class="djj-align-right">@v.RutasAbiertas</td><td><span class="djj-status-badge djj-status-badge--@(v.Activo ? "success" : "danger")">@(v.Activo ? "Activo" : "Inactivo")</span></td><td><div class="djj-row-actions"><a asp-action="Edit" asp-route-id="@v.VehiculoId" class="djj-button djj-button--ghost djj-button--sm">Editar</a><form asp-action="ToggleStatus" method="post" data-djj-confirm="¿Cambiar el estado del vehículo @v.Placa?"><input type="hidden" name="vehiculoId" value="@v.VehiculoId" /><input type="hidden" name="buscar" value="@buscar" />@Html.AntiForgeryToken()<button type="submit" class="djj-button djj-button--@(v.Activo ? "danger-outline" : "success") djj-button--sm">@(v.Activo ? "Inactivar" : "Activar")</button></form></div></td></tr> } }</tbody></table></div></section>
