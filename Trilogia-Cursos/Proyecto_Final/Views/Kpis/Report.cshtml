@model Proyecto_Final.Models.Admin.KpiReportViewModel
@using Proyecto_Final.Models.Presentation
@using System.Globalization
@inject IRolePermissionService PermissionService
@{
    Layout = "_WorkspaceLayout";
    var role = Context.Session.GetString("UserRole") ?? string.Empty;
    var canNavigate = string.Equals(role, "Administrador", StringComparison.OrdinalIgnoreCase) || await PermissionService.HasCodePermissionAsync(role, "METAS_GESTIONAR");
    ViewData["Title"] = "Reporte de cumplimiento de KPIs";
    var culture = CultureInfo.GetCultureInfo("es-CR");
    var period = new DateTime(Model.Anio, Model.Mes, 1).ToString("MMMM yyyy", culture);
}
@{
    string StatusText(string s) => s switch { "Cumplida" => "Cumplida", "EnRiesgo" => "En riesgo", "Incumplida" => "Incumplida", _ => "Sin meta" };
    string StatusClass(string s) => s switch { "Cumplida" => "success", "EnRiesgo" => "warning", "Incumplida" => "danger", _ => "neutral" };
    var chart = new AnalyticsChartViewModel { Title = "Meta frente a venta por vendedor", Context = period, TargetLabel = "Meta", ValueLabel = "Venta real", Rows = Model.Items.Select(i => new AnalyticsChartRow(i.VendedorNombre, i.VentasReales, i.MontoMeta)).ToList() };
}
<div class="djj-analytics">
<header class="djj-page-header">
<div>
<h1>Cumplimiento global de KPIs</h1>
<p>Rendimiento del equipo · @period.</p>
</div>@if (canNavigate) { <a asp-controller="Kpis" asp-action="Index" asp-route-anio="@Model.Anio" asp-route-mes="@Model.Mes" class="djj-button djj-button--secondary">Gestionar metas</a> }</header>
<form asp-controller="Kpis" asp-action="Report" method="get" class="djj-card djj-analytics-filter djj-filter-bar djj-filter-bar--analytics" data-djj-screen-only aria-label="Período de metas">
<div class="djj-field">
<label for="kpi-anio">Año</label>
<input id="kpi-anio" type="number" name="anio" value="@Model.Anio" min="2000" max="2100" class="djj-input" />
</div>
<div class="djj-field">
<label for="kpi-mes">Mes</label>
<select id="kpi-mes" name="mes" class="djj-select">@for (int i = 1; i <= 12; i++) { <option value="@i" selected="@(Model.Mes == i)">@culture.DateTimeFormat.GetMonthName(i)</option> }</select>
</div>
<div>
<button type="submit" class="djj-button djj-button--primary">Generar reporte</button>
</div>
</form>

<section class="djj-analytics-kpis" aria-label="Resumen global de metas">
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Meta global</p>
<p class="djj-kpi-card__value">₡@Model.MetaGlobal.ToString("N2")</p>
<small>@Model.VendedoresConMeta vendedor(es) con meta</small>
</article>
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Venta global</p>
<p class="djj-kpi-card__value">₡@Model.VentaGlobal.ToString("N2")</p>
<small>Ingresos facturados del equipo · @period</small>
</article>
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Cumplimiento global</p>
<p class="djj-kpi-card__value">@(Model.MetaGlobal > 0 ? Model.PorcentajeGlobal.ToString("N1") + "%" : "Sin meta")</p>
<small>Venta global frente a meta global</small>
</article>
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Metas cumplidas</p>
<p class="djj-kpi-card__value">@Model.Items.Count(i => i.Clasificacion == "Cumplida") / @Model.Items.Count(i => i.Clasificacion != "SinMeta")</p>
<small>Vendedores que alcanzaron su objetivo</small>
</article>
</section>
<partial name="_AnalyticsChart" model="chart" />
<section class="djj-card djj-data-section" aria-labelledby="kpi-detail">
<header>
<div>
<h2 id="kpi-detail">Detalle por vendedor</h2>
<p>@period · Incluye vendedores con meta o ventas.</p>
</div>
</header>
<div class="djj-table-wrap" tabindex="0" role="region" aria-label="Detalle de cumplimiento por vendedor">
<table class="djj-table djj-table--compact">
<caption>Cumplida: ≥100%; en riesgo: ≥70% y &lt;100%; incumplida: &lt;70%. Clasificación del reporte existente.</caption>
<thead>
<tr>
<th scope="col">Vendedor</th>
<th scope="col">Meta</th>
<th scope="col">Venta real</th>
<th scope="col">Facturas</th>
<th scope="col">Cumplimiento</th>
<th scope="col">Restante</th>
<th scope="col">Estado</th>
</tr>
</thead>
<tbody>
@if (!Model.HayDatos) { <tr>
<td colspan="7">
<div class="djj-empty-state">
<p>No hay metas ni ventas por vendedor en este período.</p>
</div>
</td>
</tr> }
@foreach (var item in Model.Items) {
<tr>
<th scope="row">@item.VendedorNombre</th>
<td class="djj-number">@(item.MontoMeta > 0 ? "₡" + item.MontoMeta.ToString("N2") : "—")</td>
<td class="djj-number">₡@item.VentasReales.ToString("N2")</td>
<td class="djj-number">@item.Facturas</td>
<td>@if (item.PorcentajeCumplimiento.HasValue) { <span class="djj-number">@item.PorcentajeCumplimiento.Value.ToString("N1")%</span>
<progress class="djj-progress" max="100" value="@Math.Clamp(item.PorcentajeCumplimiento.Value, 0m, 100m).ToString(CultureInfo.InvariantCulture)" aria-label="Cumplimiento de @item.VendedorNombre">@item.PorcentajeCumplimiento.Value.ToString("N1")%</progress> } else { <span>—</span> }</td>
<td class="djj-number">@(item.MontoMeta > 0 ? "₡" + Math.Max(0m, item.MontoMeta - item.VentasReales).ToString("N2") : "—")</td>
<td>
<span class="djj-badge djj-badge--@StatusClass(item.Clasificacion)">@StatusText(item.Clasificacion)</span>
</td>
</tr>
}
</tbody>
</table>
</div>
</section>
</div>
