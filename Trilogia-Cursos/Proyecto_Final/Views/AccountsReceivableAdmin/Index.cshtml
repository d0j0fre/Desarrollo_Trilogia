@model IEnumerable<Proyecto_Final.Models.Admin.ClientCreditListItemViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Cuentas por cobrar"; var buscarActual = ViewBag.Buscar as string; var estadoActual = ViewBag.EstadoCredito as string; var cuentas = Model?.ToList() ?? new(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Cobro</span><h1>Cuentas por cobrar</h1><p>Consultá deuda, crédito disponible y estado actual de cada cuenta.</p></div></header>
<nav class="djj-domain-nav" aria-label="Crédito y clientes"><a asp-controller="Credits" asp-action="Index">Crédito</a><a asp-action="Index" aria-current="page">Cuentas por cobrar</a><a asp-controller="Clients" asp-action="Index">Clientes</a></nav>
<section class="djj-card djj-filter-card" aria-labelledby="receivable-filters"><h2 id="receivable-filters">Filtrar cuentas</h2><form asp-action="Index" method="get" class="djj-filter-bar djj-filter-bar--wide"><div class="djj-field"><label for="receivable-search" class="djj-field__label">Cliente</label><input id="receivable-search" type="search" name="buscar" value="@buscarActual" class="djj-input" placeholder="Nombre, correo o teléfono" /></div><div class="djj-field"><label for="receivable-status" class="djj-field__label">Estado del crédito</label><select id="receivable-status" name="estadoCredito" class="djj-select"><option value="">Todos</option><option value="Activo" selected="@(estadoActual == "Activo")">Activo</option><option value="Bloqueado" selected="@(estadoActual == "Bloqueado")">Bloqueado</option><option value="Inactivo" selected="@(estadoActual == "Inactivo")">Inactivo</option><option value="ConDeuda" selected="@(estadoActual == "ConDeuda")">Con deuda</option></select></div><div class="djj-filter-bar__actions"><button type="submit" class="djj-button djj-button--primary">Filtrar</button><a asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div><span class="djj-filter-bar__results">@cuentas.Count cuenta(s)</span></form></section>
<section class="djj-card djj-data-section" aria-labelledby="receivable-table"><header><div><h2 id="receivable-table">Cartera de clientes</h2><p>Priorizá las cuentas con deuda o crédito bloqueado.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Cliente</th><th>Contacto</th><th class="djj-align-right">Límite</th><th class="djj-align-right">Deuda</th><th class="djj-align-right">Disponible</th><th>Estado</th><th class="djj-align-right">Movimientos</th><th>Último movimiento</th><th>Acción</th></tr></thead><tbody>
@if (!cuentas.Any()) { <tr><td colspan="9"><div class="djj-empty-state"><h3>Sin cuentas</h3><p>No se encontraron cuentas por cobrar.</p></div></td></tr> }
@foreach (var item in cuentas) { var state = !item.CreditoActivo ? "Inactivo" : item.CreditoBloqueado ? "Bloqueado" : item.DeudaActual > 0 ? "Con deuda" : "Disponible"; var tone = !item.CreditoActivo ? "neutral" : item.CreditoBloqueado ? "danger" : item.DeudaActual > 0 ? "warning" : "success"; <tr><td><strong>@item.NombreCompleto</strong></td><td><span class="djj-table__primary">@item.Correo</span><small class="djj-table__note">@(string.IsNullOrWhiteSpace(item.Telefono) ? "Sin teléfono" : item.Telefono)</small></td><td class="djj-align-right">₡@item.LimiteCredito.ToString("N2")</td><td class="djj-align-right"><strong>₡@item.DeudaActual.ToString("N2")</strong></td><td class="djj-align-right">@(item.CreditoDisponible < 0 ? "−" : string.Empty)₡@Math.Abs(item.CreditoDisponible).ToString("N2")</td><td><span class="djj-badge djj-badge--@tone">@state</span></td><td class="djj-align-right">@item.TotalMovimientos</td><td class="djj-table__nowrap">@(item.UltimoMovimiento?.ToString("dd/MM/yyyy HH:mm") ?? "Sin movimientos")</td><td><a asp-action="Detail" asp-route-id="@item.UsuarioId" class="djj-button djj-button--outline djj-button--sm">Ver cuenta</a></td></tr> }
</tbody></table></div></section>
