@model Proyecto_Final.Models.Admin.ClientCreditDetailViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Cuenta por cobrar"; var tone = Model.CreditoBloqueado ? "danger" : Model.CreditoActivo ? "success" : "neutral"; var state = Model.CreditoBloqueado ? "Bloqueado" : Model.CreditoActivo ? "Activo" : "Inactivo"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Cuenta por cobrar · Cliente</span><h1>@Model.NombreCompleto</h1><p>@Model.Correo · @(string.IsNullOrWhiteSpace(Model.Telefono) ? "Sin teléfono" : Model.Telefono)</p></div><div class="djj-page-header__actions"><span class="djj-badge djj-badge--@tone">Crédito @state</span><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.UsuarioId" class="djj-button djj-button--outline">Ver cliente</a><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
<div class="djj-kpi-grid djj-kpi-grid--four"><article class="djj-card djj-kpi-card"><span>Límite</span><strong>₡@Model.LimiteCredito.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Deuda actual</span><strong>₡@Model.DeudaActual.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Disponible</span><strong>@(Model.CreditoDisponible < 0 ? "−" : string.Empty)₡@Math.Abs(Model.CreditoDisponible).ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Última actualización</span><strong class="djj-kpi-card__compact">@(Model.FechaActualizacion?.ToString("dd/MM/yyyy HH:mm") ?? "Sin registro")</strong></article></div>
<div class="djj-detail-layout"><section class="djj-card"><div class="djj-card__header"><div><h2>Registrar movimiento</h2><p>El movimiento queda en el historial y modifica la deuda calculada.</p></div></div><form asp-action="RegisterMovement" method="post" class="djj-workspace-form" data-djj-confirm="Registrar este movimiento en la cuenta de @Model.NombreCompleto.">@Html.AntiForgeryToken()<input asp-for="MovementForm.UsuarioId" type="hidden" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="MovementForm.TipoMovimiento" class="djj-field__label"></label><select asp-for="MovementForm.TipoMovimiento" class="djj-select"><option value="Cargo">Cargo</option><option value="Abono">Abono</option><option value="AjustePositivo">Ajuste positivo</option><option value="AjusteNegativo">Ajuste negativo</option></select><span asp-validation-for="MovementForm.TipoMovimiento" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="MovementForm.Monto" class="djj-field__label">Monto (₡)</label><input asp-for="MovementForm.Monto" type="number" min="1" step="0.01" inputmode="decimal" class="djj-input" /><span asp-validation-for="MovementForm.Monto" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="MovementForm.Referencia" class="djj-field__label"></label><input asp-for="MovementForm.Referencia" class="djj-input" /><span asp-validation-for="MovementForm.Referencia" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="MovementForm.Descripcion" class="djj-field__label"></label><textarea asp-for="MovementForm.Descripcion" rows="3" class="djj-textarea"></textarea><span asp-validation-for="MovementForm.Descripcion" class="djj-field__error"></span></div></div><div class="djj-form-actions"><button class="djj-button djj-button--primary" type="submit">Registrar movimiento</button></div></form></section>
<aside class="djj-card"><div class="djj-card__header"><div><h2>Configuración</h2><p>Límite y disponibilidad de la cuenta.</p></div></div><form asp-action="UpdateSettings" method="post" class="djj-workspace-form" data-djj-confirm="Guardar la configuración de crédito de @Model.NombreCompleto.">@Html.AntiForgeryToken()<input asp-for="SettingsForm.UsuarioId" type="hidden" /><div class="djj-field"><label asp-for="SettingsForm.LimiteCredito" class="djj-field__label">Límite de crédito (₡)</label><input asp-for="SettingsForm.LimiteCredito" type="number" min="0" step="0.01" inputmode="decimal" class="djj-input" /><span asp-validation-for="SettingsForm.LimiteCredito" class="djj-field__error"></span></div><label class="djj-check"><input asp-for="SettingsForm.CreditoActivo" />Crédito activo</label><label class="djj-check"><input asp-for="SettingsForm.CreditoBloqueado" />Crédito bloqueado</label><div class="djj-field"><label asp-for="SettingsForm.MotivoBloqueo" class="djj-field__label"></label><textarea asp-for="SettingsForm.MotivoBloqueo" rows="3" class="djj-textarea"></textarea><span asp-validation-for="SettingsForm.MotivoBloqueo" class="djj-field__error"></span></div><div class="djj-form-actions"><button class="djj-button djj-button--primary" type="submit">Guardar configuración</button></div></form></aside></div>
<section class="djj-card djj-data-section" aria-labelledby="account-movements"><header><div><h2 id="account-movements">Movimientos</h2><p>Cargos: ₡@Model.TotalCargos.ToString("N2") · Abonos: ₡@Model.TotalAbonos.ToString("N2")</p></div><span class="djj-badge djj-badge--neutral">@Model.Movimientos.Count registro(s)</span></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Movimiento</th><th>Fecha</th><th>Tipo</th><th class="djj-align-right">Monto</th><th>Descripción</th><th>Referencia</th><th>Responsable</th></tr></thead><tbody>
@if (!Model.Movimientos.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin movimientos</h3><p>Esta cuenta todavía no tiene movimientos registrados.</p></div></td></tr> }
@foreach (var item in Model.Movimientos) { var increasesDebt = item.TipoMovimiento is "Cargo" or "AjustePositivo"; <tr><td>#@item.CreditoMovimientoId</td><td class="djj-table__nowrap">@item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td><td><span class="djj-badge djj-badge--@(increasesDebt ? "warning" : "success")">@item.TipoMovimiento</span></td><td class="djj-align-right">₡@item.Monto.ToString("N2")</td><td>@item.Descripcion</td><td>@(item.Referencia ?? "Sin referencia")</td><td>@(item.RegistradoPorNombre ?? "Sistema")</td></tr> }
</tbody></table></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
