@model IEnumerable<Proyecto_Final.Models.Admin.EmployeeLeaveRequestViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Solicitudes de empleados"; var estado = ViewBag.Estado as string; string Tone(string value) => value switch { "Aprobada" => "success", "Rechazada" or "Cancelada" => "danger", "Pendiente" => "warning", _ => "neutral" }; }

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Personal · Aprobaciones</span><h1>Solicitudes de empleados</h1><p>Revisá el período y el motivo antes de aprobar, rechazar o cancelar una solicitud.</p></div><div class="djj-page-header__actions"><a asp-action="Index" class="djj-button djj-button--ghost">Volver a empleados</a></div></header>
<section class="djj-card djj-filter-card" aria-labelledby="request-filters"><h2 id="request-filters">Filtrar solicitudes</h2><form asp-action="LeaveRequests" method="get" class="djj-filter-bar"><div class="djj-field"><label for="request-status">Estado</label><select id="request-status" name="estado" class="djj-select"><option value="">Todos</option><option value="Pendiente" selected="@(estado == "Pendiente")">Pendientes</option><option value="Aprobada" selected="@(estado == "Aprobada")">Aprobadas</option><option value="Rechazada" selected="@(estado == "Rechazada")">Rechazadas</option><option value="Cancelada" selected="@(estado == "Cancelada")">Canceladas</option></select></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--neutral">Filtrar</button><a asp-action="LeaveRequests" class="djj-button djj-button--ghost">Limpiar</a></div></form></section>
<section class="djj-card djj-data-section" aria-labelledby="request-list-title"><header><div><h2 id="request-list-title">Solicitudes registradas</h2><p>@Model.Count() resultado(s).</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Solicitante</th><th>Período</th><th>Solicitud</th><th>Estado</th><th>Decisión</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="5"><div class="djj-empty-state"><h3>Sin solicitudes</h3><p>No hay solicitudes para el estado seleccionado.</p></div></td></tr> }
@foreach (var item in Model) { <tr><td><strong class="djj-table__primary">@item.NombreCompleto</strong><small class="djj-table__note">@item.Puesto</small></td><td class="djj-table__nowrap">@item.FechaInicio.ToString("dd/MM/yyyy") – @item.FechaFin.ToString("dd/MM/yyyy")<small class="djj-table__note">@item.CantidadDias día(s)</small></td><td><span class="djj-table__primary">@item.TipoSolicitud</span><small class="djj-table__note djj-hr-request-summary">@item.Motivo</small></td><td><span class="djj-status-badge djj-status-badge--@Tone(item.Estado)">@item.Estado</span>@if (!string.IsNullOrWhiteSpace(item.RespuestaAdmin)) { <small class="djj-table__note">@item.RespuestaAdmin</small> }</td><td><form asp-action="UpdateLeaveRequest" method="post" class="djj-hr-decision"><input type="hidden" name="SolicitudId" value="@item.SolicitudId" /><input type="hidden" name="estadoFiltro" value="@estado" />@Html.AntiForgeryToken()<div class="djj-field"><label class="djj-sr-only" for="request-response-@item.SolicitudId">Respuesta para @item.NombreCompleto</label><input id="request-response-@item.SolicitudId" type="text" name="RespuestaAdmin" class="djj-input" maxlength="500" placeholder="Respuesta u observación" value="@item.RespuestaAdmin" /></div><div class="djj-row-actions"><button name="Estado" value="Aprobada" class="djj-button djj-button--success djj-button--sm" data-djj-confirm="Aprobar la solicitud de @item.NombreCompleto para el período @item.FechaInicio.ToString("dd/MM/yyyy") al @item.FechaFin.ToString("dd/MM/yyyy").">Aprobar</button><button name="Estado" value="Rechazada" class="djj-button djj-button--danger-outline djj-button--sm" data-djj-confirm="Rechazar la solicitud de @item.NombreCompleto. La respuesta escrita quedará asociada a la decisión.">Rechazar</button>@if (item.Estado != "Pendiente") { <button name="Estado" value="Pendiente" class="djj-button djj-button--ghost djj-button--sm">Marcar pendiente</button> }@if (item.Estado != "Cancelada") { <button name="Estado" value="Cancelada" class="djj-button djj-button--danger-outline djj-button--sm" data-djj-confirm="Cancelar la solicitud de @item.NombreCompleto para el período indicado.">Cancelar</button> }</div></form></td></tr> }
</tbody></table></div></section>
