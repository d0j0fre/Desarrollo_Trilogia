@model Proyecto_Final.Models.Admin.PriceHistoryViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Histórico de precios"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Compras · Precios</span><h1>Histórico de precios</h1><p>Compará compras reales por producto y proveedor.</p></div></header><nav class="djj-domain-nav" aria-label="Secciones de compras"><a asp-controller="Suppliers" asp-action="Index">Proveedores</a><a asp-controller="PurchaseOrders" asp-action="Index">Órdenes</a><a aria-current="page" asp-action="Index">Histórico de precios</a></nav>
<section class="djj-card djj-filter-card"><form method="get" class="djj-filter-bar"><div class="djj-field"><label for="price-product">Producto</label><select id="price-product" name="productoId" class="djj-select"><option value="">Seleccioná un producto</option>@foreach(var product in Model.ProductosDisponibles){<option value="@product.ProductoId" selected="@(product.ProductoId==Model.ProductoId)">@product.Nombre</option>}</select></div><button class="djj-button djj-button--primary">Consultar</button></form></section>
<section class="djj-card djj-data-section">@if(Model.ProductoId>0&&!Model.Historial.Any()){<div class="djj-empty-state"><h3>Sin historial</h3><p>No hay compras no canceladas para este producto.</p></div>}else if(Model.Historial.Any()){<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Fecha</th><th>Proveedor</th><th class="djj-align-right">Precio</th><th class="djj-align-right">Anterior</th><th class="djj-align-right">Variación</th><th>Orden / estado</th></tr></thead><tbody>@foreach(var line in Model.Historial){<tr><td>@line.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@line.ProveedorNombre</td><td class="djj-align-right">₡@line.PrecioUnitario.ToString("N2")</td><td class="djj-align-right">@(line.PrecioAnterior.HasValue?$"₡{line.PrecioAnterior:N2}":"—")</td><td class="djj-align-right">@if(line.VariacionSignificativa){<span class="djj-badge djj-badge--warning">@line.VariacionPorcentual?.ToString("N2")%</span>}else{<span>@(line.VariacionPorcentual.HasValue?$"{line.VariacionPorcentual:N2}%":"—")</span>}</td><td><a asp-controller="PurchaseOrders" asp-action="Detail" asp-route-id="@line.OrdenCompraId">#@line.OrdenCompraId</a> · @line.Estado</td></tr>}</tbody></table></div><p class="djj-padded djj-page-header__meta">Las variaciones absolutas mayores al 15% se resaltan; no modifican precios automáticamente.</p>}else{<div class="djj-empty-state"><h3>Seleccioná un producto</h3><p>Consultá su evolución de precios de compra.</p></div>}</section>
