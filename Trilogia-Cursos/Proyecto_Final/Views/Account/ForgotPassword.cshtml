@model Proyecto_Final.Models.ForgotPasswordViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Recuperar contraseña"; }
<main class="djj-container djj-auth-page djj-auth-page--single"><section class="djj-card djj-auth-card"><img class="djj-auth-logo" src="~/brand/stage2/logo_stage2-identity_horizontal_20260821_color.svg" alt="Distribuidora JJ — Licorera - Distribuidora" width="220" height="64" /><span class="djj-page-header__eyebrow">Recuperación segura</span><h1>Recuperar contraseña</h1><p>Te enviaremos un enlace al correo asociado a tu cuenta.</p><form asp-action="ForgotPassword" method="post" novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-field"><label asp-for="Email" class="djj-field__label"></label><input asp-for="Email" class="djj-input" autocomplete="email" /><span asp-validation-for="Email" class="djj-field__error"></span></div><button class="djj-button djj-button--primary djj-auth-submit" type="submit">Enviar enlace</button><a class="djj-button djj-button--ghost djj-auth-submit" asp-action="Login">Volver a iniciar sesión</a></form></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
