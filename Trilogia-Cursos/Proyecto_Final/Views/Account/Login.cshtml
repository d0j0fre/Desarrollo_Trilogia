@model Proyecto_Final.Models.LoginViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Iniciar sesión"; }
<main class="djj-container djj-auth-page"><section class="djj-auth-brand"><img src="~/brand/stage2/logo_stage2-identity_stacked_20260821_color.svg" alt="Distribuidora JJ — Licorera - Distribuidora" width="240" height="180" /><h1>Bienvenido de nuevo</h1><p>Accedé a pedidos, comprobantes y perfil desde tu cuenta.</p></section><section class="djj-card djj-auth-card"><span class="djj-page-header__eyebrow">Acceso seguro</span><h2>Iniciar sesión</h2>@if(TempData["RegisterSuccess"] is string msg && !string.IsNullOrWhiteSpace(msg)){<div class="djj-alert djj-alert--success" role="status">@msg</div>}<form asp-controller="Account" asp-action="Login" method="post" novalidate><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-field"><label asp-for="Email" class="djj-field__label"></label><input asp-for="Email" class="djj-input" autocomplete="email" /><span asp-validation-for="Email" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Password" class="djj-field__label"></label><input asp-for="Password" class="djj-input" autocomplete="current-password" /><span asp-validation-for="Password" class="djj-field__error"></span></div><div class="djj-auth-row"><label><input asp-for="RememberMe" /> Recordarme</label><a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a></div><button class="djj-button djj-button--primary djj-auth-submit" type="submit">Ingresar</button><p class="djj-auth-switch">¿No tenés cuenta? <a asp-action="Register">Registrate</a></p></form></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
