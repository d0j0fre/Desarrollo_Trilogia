@model Proyecto_Final.Models.RegistroViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Crear cuenta"; }
<main class="djj-container djj-auth-page"><section class="djj-auth-brand"><img src="~/brand/stage2/logo_stage2-identity_stacked_20260821_color.svg" alt="Distribuidora JJ — Licorera - Distribuidora" width="240" height="180" /><h1>Creá tu cuenta</h1><p>Comprá más rápido y consultá tus pedidos.</p></section><section class="djj-card djj-auth-card"><span class="djj-page-header__eyebrow">Nueva cuenta</span><h2>Registro</h2><form asp-controller="Account" asp-action="Register" method="post" novalidate><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-field"><label asp-for="FullName" class="djj-field__label"></label><input asp-for="FullName" class="djj-input" autocomplete="name" /><span asp-validation-for="FullName" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Email" class="djj-field__label"></label><input asp-for="Email" class="djj-input" autocomplete="email" /><span asp-validation-for="Email" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Password" class="djj-field__label"></label><input asp-for="Password" class="djj-input" autocomplete="new-password" /><span asp-validation-for="Password" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="ConfirmPassword" class="djj-field__label"></label><input asp-for="ConfirmPassword" class="djj-input" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="djj-field__error"></span></div><label class="djj-auth-terms"><input asp-for="AcceptTerms" /> Acepto los términos y condiciones</label><span asp-validation-for="AcceptTerms" class="djj-field__error"></span><button class="djj-button djj-button--primary djj-auth-submit" type="submit">Crear cuenta</button><p class="djj-auth-switch">¿Ya tenés cuenta? <a asp-action="Login">Iniciá sesión</a></p></form></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
