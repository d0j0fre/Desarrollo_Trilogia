@{ ViewData["Title"]="Acceso denegado"; Layout="~/Views/Shared/_Layout.cshtml"; }
@section Styles { <link rel="stylesheet" href="~/css/stage2/tokens.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/stage2/base.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/stage2/components.css" asp-append-version="true" /> }
<main class="djj-state-page" aria-labelledby="access-denied-title"><section class="djj-card djj-state-card"><span class="djj-state-card__code" aria-hidden="true">403</span><h1 id="access-denied-title">Acceso denegado</h1><p>No es posible mostrar esta sección con tu acceso actual. Si necesitás completar esta tarea, solicitá el permiso correspondiente a la persona administradora.</p><div class="djj-form-actions"><button class="djj-button djj-button--ghost" type="button" onclick="history.back()">Volver</button><a asp-controller="Home" asp-action="Index" class="djj-button djj-button--primary">Ir al inicio</a></div></section></main>
