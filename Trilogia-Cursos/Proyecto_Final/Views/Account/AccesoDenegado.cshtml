@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container my-5 text-center d-flex flex-column justify-content-center align-items-center" style="min-height: 50vh;" aria-labelledby="access-denied-title">
    <i class="fa fa-lock text-danger mb-3" style="font-size: 5rem;" aria-hidden="true"></i>
    <p class="display-4 fw-bold text-dark mb-0" aria-hidden="true">403</p>
    <h1 id="access-denied-title" class="h3 text-uppercase mt-2">Acceso denegado</h1>
    <p class="text-muted mt-2 mb-4" style="font-size: 1.1rem; max-width: 34rem;">
        No es posible mostrar esta sección con tu acceso actual.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-ds-neutral shadow-sm" style="font-weight: bold; padding: 10px 30px;">
        Volver al inicio
    </a>
</main>
</div>
