@model Proyecto_Final.Models.ResetPasswordViewModel
@{ Layout="_StorefrontLayout"; ViewData["Title"]="Restablecer contraseña"; }
<main class="djj-container djj-auth-page djj-auth-page--single"><section class="djj-card djj-auth-card"><img class="djj-auth-logo" src="~/brand/stage2/logo_stage2-identity_horizontal_20260821_color.svg" alt="Distribuidora JJ — Licorera - Distribuidora" width="220" height="64" /><span class="djj-page-header__eyebrow">Acceso seguro</span><h1>Restablecer contraseña</h1><p>Elegí una nueva contraseña para tu cuenta.</p><form asp-action="ResetPassword" method="post" novalidate>@Html.AntiForgeryToken()<input asp-for="Token" type="hidden" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-field"><label asp-for="Password" class="djj-field__label"></label><input asp-for="Password" class="djj-input" autocomplete="new-password" /><span asp-validation-for="Password" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="ConfirmPassword" class="djj-field__label"></label><input asp-for="ConfirmPassword" class="djj-input" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="djj-field__error"></span></div><button class="djj-button djj-button--primary djj-auth-submit" type="submit">Cambiar contraseña</button></form></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
