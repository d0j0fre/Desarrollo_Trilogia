@model ErrorViewModel
@{
    ViewData["Title"] = "Servicio temporalmente no disponible";
}

<div class="container py-5 text-center">
<h1 class="h3">No podemos completar esta solicitud en este momento.</h1>
<p class="text-muted">El incidente fue registrado. Intente nuevamente en unos minutos.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted"><small>Identificador de seguimiento: <code>@Model.RequestId</code></small></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-ds-neutral">Ir al inicio</a>
</div>
