@using Microsoft.AspNetCore.Http
@inject IRolePermissionService PermissionService
@{
    var role = Context.Session.GetString("UserRole") ?? string.Empty;
    var admin = string.Equals(role, "Administrador", StringComparison.OrdinalIgnoreCase);
    var canView = admin || await PermissionService.HasCodePermissionAsync(role, "DOCUMENTOS_VER");
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
@if (canView)
{
    <nav class="djj-domain-nav" aria-label="Gestión documental">
        <a asp-controller="Documents" asp-action="Index" aria-current="@(action == "Index" ? "page" : null)">Documentos</a>
        <a asp-controller="Documents" asp-action="Alerts" aria-current="@(action == "Alerts" ? "page" : null)">Alertas de vencimiento</a>
    </nav>
}
