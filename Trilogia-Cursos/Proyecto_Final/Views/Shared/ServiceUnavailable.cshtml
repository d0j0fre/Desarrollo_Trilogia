@{
    ViewData["Title"] = "Servicio temporalmente no disponible";
}
<div class="container py-5 text-center">
    <h1 class="h3">No podemos cargar este presupuesto en este momento.</h1>
    <p class="text-muted">El incidente fue registrado. Intente nuevamente en unos minutos o vuelva al listado de presupuestos.</p>
