@model Proyecto_Final.Models.Admin.BudgetCreateViewModel
@using Proyecto_Final.Models.Admin
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Nuevo presupuesto"; var departments = ViewBag.Departments as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>(); var categories = ViewBag.Categories as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>(); }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Presupuestos · Nuevo</span><h1>Nuevo presupuesto</h1><p>Se creará en borrador para distribuirlo antes de presentarlo.</p></div></header>
<form asp-action="Create" method="post" class="djj-card djj-workspace-form djj-workspace-form--narrow">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><fieldset><legend>Período y alcance</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="Year"></label><input asp-for="Year" type="number" min="2000" max="2100" class="djj-input" /><span asp-validation-for="Year" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="DepartmentId">Departamento</label><select asp-for="DepartmentId" class="djj-select"><option value="">Seleccioná</option>@foreach (var item in departments) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="DepartmentId" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="CategoryId">Categoría inicial</label><select asp-for="CategoryId" class="djj-select"><option value="">Seleccioná</option>@foreach (var item in categories) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="CategoryId" class="djj-field__error"></span></div></div></fieldset><fieldset><legend>Monto y contexto</legend><div class="djj-field"><label asp-for="AnnualAmount">Monto anual (₡)</label><input asp-for="AnnualAmount" type="number" min="0.01" step="0.01" inputmode="decimal" class="djj-input" /><small class="djj-field__hint">La distribución mensual deberá coincidir con este total.</small><span asp-validation-for="AnnualAmount" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Notes">Notas</label><textarea asp-for="Notes" rows="4" class="djj-textarea"></textarea><span asp-validation-for="Notes" class="djj-field__error"></span></div></fieldset><div class="djj-form-actions"><a asp-action="Index" asp-route-Year="@Model.Year" class="djj-button djj-button--ghost">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Crear borrador</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
