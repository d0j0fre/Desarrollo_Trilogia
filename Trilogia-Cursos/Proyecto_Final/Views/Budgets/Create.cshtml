@model Proyecto_Final.Models.Admin.BudgetCreateViewModel
@using Proyecto_Final.Models.Admin
@{
    ViewData["Title"] = "Nuevo presupuesto";
    var departments = ViewBag.Departments as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>();
    var categories = ViewBag.Categories as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>();
}

<div class="container py-4 s4-admin-page">
    <header class="d-flex flex-wrap justify-content-between align-items-start mb-4">
        <div class="s4-page-header">
            <span class="s4-eyebrow"><i class="fa fa-wallet"></i> Planificación anual</span>
            <h2>Nuevo presupuesto</h2>
            <p class="text-muted mb-0">Se creará en borrador y podrá distribuirse antes de presentarlo.</p>
        </div>
        <a asp-action="Index" asp-route-Year="@Model.Year" class="btn btn-outline-secondary"><i class="fa fa-arrow-left mr-1"></i>Volver</a>
    </header>

    <div class="card">
        <div class="card-header">Datos del presupuesto</div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Year">Año</label>
                        <input asp-for="Year" type="number" min="2000" max="2100" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="DepartmentId">Departamento</label>
                        <select asp-for="DepartmentId" class="form-control">
                            <option value="">Seleccione</option>
                            @foreach (var item in departments) { <option value="@item.Id">@item.Name</option> }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="CategoryId">Categoría inicial</label>
                        <select asp-for="CategoryId" class="form-control">
                            <option value="">Seleccione</option>
                            @foreach (var item in categories) { <option value="@item.Id">@item.Name</option> }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="AnnualAmount">Monto anual (CRC)</label>
                    <input asp-for="AnnualAmount" type="number" min="0.01" step="0.01" class="form-control" />
                    <span asp-validation-for="AnnualAmount" class="text-danger"></span>
                    <small class="form-text text-muted">La distribución mensual deberá coincidir exactamente con este total.</small>
                </div>
                <div class="form-group">
                    <label asp-for="Notes">Notas</label>
                    <textarea asp-for="Notes" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary" type="submit"><i class="fa fa-save mr-1"></i>Crear borrador</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
