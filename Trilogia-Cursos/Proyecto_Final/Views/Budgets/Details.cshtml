@model Proyecto_Final.Models.Admin.BudgetDetailsViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = $"Presupuesto {Model.Budget.Year}"; var names = System.Globalization.CultureInfo.GetCultureInfo("es-CR").DateTimeFormat.MonthNames; var distributed = Model.Details.Sum(item => item.AllocatedAmount); var difference = Model.Budget.AnnualAmount - distributed; string Tone(string state) => state switch { "Aprobado" => "success", "Rechazado" => "danger", "Presentado" => "warning", _ => "info" }; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Presupuesto anual · @Model.Budget.Year</span><h1>@Model.Budget.DepartmentName</h1><p>Creado por @Model.Budget.CreatedByName.</p></div><div class="djj-page-header__actions"><span class="djj-badge djj-badge--@Tone(Model.Budget.Status)">@Model.Budget.Status</span>@if (Model.CanEdit) { <a asp-action="Edit" asp-route-id="@Model.Budget.BudgetId" class="djj-button djj-button--outline">Editar encabezado</a> }<a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
<div class="djj-kpi-grid"><article class="djj-card djj-kpi-card"><span>Monto anual</span><strong>₡@Model.Budget.AnnualAmount.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Distribuido</span><strong>₡@distributed.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Diferencia</span><strong>@(difference < 0 ? "−" : difference > 0 ? "+" : string.Empty)₡@Math.Abs(difference).ToString("N2")</strong></article></div>
@if (difference != 0) { <div class="djj-alert djj-alert--warning" role="alert"><strong>Distribución incompleta.</strong> Los doce meses difieren del monto anual por ₡@Math.Abs(difference).ToString("N2"). Ajustá antes de presentar.</div> }
<section class="djj-card djj-financial-actions" aria-labelledby="budget-actions"><div class="djj-card__header"><div><h2 id="budget-actions">Acciones del presupuesto</h2><p>Cada cambio de estado queda registrado en auditoría.</p></div></div><div class="djj-action-cluster">@if (Model.Budget.Status is "Borrador" or "Rechazado") { <form asp-action="Submit" method="post" data-djj-confirm="Presentar este presupuesto para aprobación. Dejará de ser un borrador editable.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Budget.BudgetId" /><button class="djj-button djj-button--primary">Presentar</button></form> }@if (Model.Budget.Status == "Presentado") { <form asp-action="Approve" method="post" data-djj-confirm="Aprobar y bloquear este presupuesto para edición.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Budget.BudgetId" /><button class="djj-button djj-button--success">Aprobar</button></form><form asp-action="Reject" method="post" class="djj-inline-action" data-djj-confirm="Rechazar este presupuesto y devolverlo para corrección.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Budget.BudgetId" /><label class="djj-sr-only" for="budget-reject-reason">Motivo de rechazo</label><input id="budget-reject-reason" name="reason" class="djj-input" maxlength="500" required placeholder="Motivo de rechazo" /><button class="djj-button djj-button--danger-outline">Rechazar</button></form> }@if (Model.Budget.Status == "Aprobado") { <form asp-action="Close" method="post" data-djj-confirm="Cerrar este presupuesto aprobado.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Budget.BudgetId" /><button class="djj-button djj-button--outline">Cerrar</button></form> }<form asp-action="Copy" method="post" class="djj-inline-action">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Budget.BudgetId" /><label class="djj-sr-only" for="copy-target-year">Año destino</label><input id="copy-target-year" type="number" name="targetYear" value="@(Model.Budget.Year + 1)" min="2000" max="2100" class="djj-input djj-line-input" /><button class="djj-button djj-button--outline">Copiar</button></form></div></section>
<div class="djj-detail-layout"><section class="djj-card djj-data-section"><header><div><h2>Distribución mensual</h2><p>Líneas asignadas por categoría y mes.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Categoría</th><th>Mes</th><th class="djj-align-right">Monto</th><th>Notas</th><th>Acción</th></tr></thead><tbody>@foreach (var item in Model.Details) { <tr><td>@item.CategoryName</td><td>@names[item.Month - 1]</td><td class="djj-align-right">₡@item.AllocatedAmount.ToString("N2")</td><td>@(item.Notes ?? "—")</td><td>@if (Model.CanEdit) { <form asp-action="SaveDetail" method="post" class="djj-inline-action">@Html.AntiForgeryToken()<input type="hidden" name="BudgetId" value="@Model.Budget.BudgetId" /><input type="hidden" name="BudgetDetailId" value="@item.BudgetDetailId" /><input type="hidden" name="CategoryId" value="@item.CategoryId" /><input type="hidden" name="Month" value="@item.Month" /><label class="djj-sr-only" for="line-amount-@item.BudgetDetailId">Nuevo monto</label><input id="line-amount-@item.BudgetDetailId" type="number" name="AllocatedAmount" value="@item.AllocatedAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" class="djj-input djj-line-input" /><input type="hidden" name="Notes" value="@item.Notes" /><button class="djj-button djj-button--outline djj-button--sm">Actualizar</button></form> }</td></tr> }</tbody><tfoot><tr><th colspan="2">Total distribuido</th><th class="djj-align-right">₡@distributed.ToString("N2")</th><th colspan="2"></th></tr></tfoot></table></div></section>
<aside class="djj-form-guidance">@if (Model.CanEdit) { <section class="djj-card"><div class="djj-card__header"><div><h2>Agregar o editar línea</h2></div></div><form asp-action="SaveDetail" method="post" class="djj-workspace-form">@Html.AntiForgeryToken()<input type="hidden" name="BudgetId" value="@Model.Budget.BudgetId" /><div class="djj-field"><label for="line-category">Categoría</label><select id="line-category" name="CategoryId" class="djj-select" required><option value="">Seleccioná</option>@foreach (var item in Model.Categories) { <option value="@item.Id">@item.Name</option> }</select></div><div class="djj-form-grid"><div class="djj-field"><label for="line-month">Mes</label><input id="line-month" type="number" name="Month" min="1" max="12" class="djj-input" required /></div><div class="djj-field"><label for="line-new-amount">Monto (₡)</label><input id="line-new-amount" type="number" name="AllocatedAmount" min="0" step="0.01" class="djj-input" required /></div></div><div class="djj-field"><label for="line-notes">Notas</label><input id="line-notes" name="Notes" maxlength="300" class="djj-input" /></div><button class="djj-button djj-button--primary">Guardar línea</button></form><form asp-action="Distribute" method="post" class="djj-workspace-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Budget.BudgetId" /><div class="djj-field"><label for="distribute-category">Categoría para distribución</label><select id="distribute-category" name="categoryId" class="djj-select" required>@foreach (var item in Model.Categories) { <option value="@item.Id">@item.Name</option> }</select></div><button class="djj-button djj-button--outline">Distribuir monto anual</button></form></section> }<section class="djj-card"><div class="djj-card__header"><div><h2>Auditoría</h2></div></div><ul class="djj-audit-list">@foreach (var item in Model.Audit) { <li><strong>@item.Action</strong><span>@item.UserName · @item.CreatedUtc.ToString("dd/MM/yyyy HH:mm") UTC</span><p>@item.Detail</p></li> }</ul></section></aside></div>
