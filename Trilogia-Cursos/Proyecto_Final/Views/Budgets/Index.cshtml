@model Proyecto_Final.Models.Admin.BudgetsIndexViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Presupuestos anuales"; string Tone(string state) => state switch { "Aprobado" => "success", "Rechazado" => "danger", "Presentado" => "warning", "Cerrado" => "neutral", _ => "info" }; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Planificación</span><h1>Presupuestos anuales</h1><p>Planificá montos por departamento, categoría y mes.</p></div><div class="djj-page-header__actions"><a asp-controller="BudgetComparison" asp-action="Index" class="djj-button djj-button--outline">Ver comparativa</a><a asp-action="Create" asp-route-year="@(Model.Filter.Year ?? DateTime.Today.Year)" class="djj-button djj-button--primary">Nuevo presupuesto</a></div></header>
<nav class="djj-domain-nav" aria-label="Presupuestos y gastos"><a asp-action="Index" aria-current="page">Presupuestos</a><a asp-controller="Expenses" asp-action="Index">Gastos</a><a asp-controller="BudgetComparison" asp-action="Index">Comparativa</a></nav>
<section class="djj-card djj-filter-card" aria-labelledby="budget-filters"><h2 id="budget-filters">Filtrar presupuestos</h2><form method="get" class="djj-filter-bar djj-filter-bar--wide"><div class="djj-field"><label for="budget-year">Año</label><input id="budget-year" type="number" name="Year" value="@Model.Filter.Year" min="2000" max="2100" class="djj-input" /></div><div class="djj-field"><label for="budget-department">Departamento</label><select id="budget-department" name="DepartmentId" class="djj-select"><option value="">Todos</option>@foreach (var item in Model.Departments) { <option value="@item.Id" selected="@(Model.Filter.DepartmentId == item.Id)">@item.Name</option> }</select></div><div class="djj-field"><label for="budget-status">Estado</label><select id="budget-status" name="Status" class="djj-select"><option value="">Todos</option>@foreach (var state in new[] { "Borrador", "Presentado", "Aprobado", "Rechazado", "Cerrado", "Inactivo" }) { <option value="@state" selected="@(Model.Filter.Status == state)">@state</option> }</select></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--primary">Filtrar</button><a asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div><span class="djj-filter-bar__results">@Model.Budgets.Total resultado(s)</span></form></section>
<section class="djj-card djj-data-section"><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Período</th><th>Departamento</th><th>Estado</th><th class="djj-align-right">Monto anual</th><th>Creación</th><th>Acción</th></tr></thead><tbody>@if (!Model.Budgets.Items.Any()) { <tr><td colspan="6"><div class="djj-empty-state"><h3>Sin presupuestos</h3><p>No hay registros para los filtros seleccionados.</p></div></td></tr> }@foreach (var item in Model.Budgets.Items) { <tr><td><strong>@item.Year</strong></td><td>@item.DepartmentName</td><td><span class="djj-badge djj-badge--@Tone(item.Status)">@item.Status</span></td><td class="djj-align-right">₡@item.AnnualAmount.ToString("N2")</td><td>@item.CreatedByName<small class="djj-table__note">@item.CreatedUtc.ToString("dd/MM/yyyy HH:mm") UTC</small></td><td><a asp-action="Details" asp-route-id="@item.BudgetId" class="djj-button djj-button--outline djj-button--sm">Gestionar</a></td></tr> }</tbody></table></div><footer class="djj-table-footer"><span>Página @Model.Budgets.Page de @Model.Budgets.TotalPages</span><div class="djj-row-actions">@if (Model.Budgets.Page > 1) { <a asp-route-Page="@(Model.Budgets.Page - 1)" asp-route-Year="@Model.Filter.Year" asp-route-DepartmentId="@Model.Filter.DepartmentId" asp-route-Status="@Model.Filter.Status" class="djj-button djj-button--ghost djj-button--sm">Anterior</a> }@if (Model.Budgets.Page < Model.Budgets.TotalPages) { <a asp-route-Page="@(Model.Budgets.Page + 1)" asp-route-Year="@Model.Filter.Year" asp-route-DepartmentId="@Model.Filter.DepartmentId" asp-route-Status="@Model.Filter.Status" class="djj-button djj-button--ghost djj-button--sm">Siguiente</a> }</div></footer></section>
