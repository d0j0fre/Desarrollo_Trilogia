@model Proyecto_Final.Models.Admin.BudgetHeaderEditViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Editar presupuesto"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Presupuestos · Borrador</span><h1>Editar presupuesto</h1><p>Si cambiás el monto anual, revisá nuevamente la distribución mensual.</p></div></header>
<form asp-action="Edit" method="post" class="djj-card djj-workspace-form djj-workspace-form--narrow">@Html.AntiForgeryToken()<input asp-for="BudgetId" type="hidden" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="Year"></label><input asp-for="Year" type="number" min="2000" max="2100" class="djj-input" /><span asp-validation-for="Year" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="AnnualAmount">Monto anual (₡)</label><input asp-for="AnnualAmount" type="number" min="0.01" step="0.01" inputmode="decimal" class="djj-input" /><span asp-validation-for="AnnualAmount" class="djj-field__error"></span></div></div><div class="djj-field"><label asp-for="Notes">Notas</label><textarea asp-for="Notes" rows="4" class="djj-textarea"></textarea><span asp-validation-for="Notes" class="djj-field__error"></span></div><div class="djj-form-actions"><a asp-action="Details" asp-route-id="@Model.BudgetId" class="djj-button djj-button--ghost">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Guardar cambios</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
