@model Proyecto_Final.Models.Admin.BudgetHeaderEditViewModel
@{ ViewData["Title"] = "Editar presupuesto"; }

<div class="container py-4 s4-admin-page">
    <header class="d-flex flex-wrap justify-content-between align-items-start mb-4">
        <div class="s4-page-header">
            <span class="s4-eyebrow"><i class="fa fa-pen"></i> Borrador editable</span>
            <h2>Editar presupuesto</h2>
            <p class="text-muted mb-0">Al cambiar el monto anual, revise nuevamente sus doce meses.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.BudgetId" class="btn btn-ds-neutral">Cancelar</a>
    </header>
    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="BudgetId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Year">Año</label>
                        <input asp-for="Year" type="number" min="2000" max="2100" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-8">
                        <label asp-for="AnnualAmount">Monto anual (CRC)</label>
                        <input asp-for="AnnualAmount" type="number" min="0.01" step="0.01" class="form-control" />
                        <span asp-validation-for="AnnualAmount" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Notes">Notas</label>
                    <textarea asp-for="Notes" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <button class="btn btn-ds-action" type="submit"><i class="fa fa-save mr-1"></i>Guardar cambios</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
