@model IEnumerable<Proyecto_Final.Models.Admin.AttendanceEntryViewModel>
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Aprobación de jornadas"; var desde = ViewBag.Desde as DateTime?; var hasta = ViewBag.Hasta as DateTime?; string Tone(string state) => state switch { "Aprobada" => "success", "Rechazada" => "danger", "Enviada" or "Pendiente" or "Borrador" => "warning", _ => "neutral" }; }

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Personal · Supervisión</span><h1>Aprobación de jornadas</h1><p>Revisá las cantidades de horas enviadas. Este módulo no calcula tasas ni reglas laborales.</p></div></header>
<section class="djj-card djj-filter-card" aria-labelledby="attendance-filters"><h2 id="attendance-filters">Período</h2><form asp-action="Index" method="get" class="djj-filter-bar"><div class="djj-field"><label for="attendance-from">Desde</label><input id="attendance-from" type="date" name="desde" value="@desde?.ToString("yyyy-MM-dd")" class="djj-input" /></div><div class="djj-field"><label for="attendance-to">Hasta</label><input id="attendance-to" type="date" name="hasta" value="@hasta?.ToString("yyyy-MM-dd")" class="djj-input" /></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--neutral">Filtrar</button><a asp-action="Index" class="djj-button djj-button--ghost">Restablecer</a></div></form></section>
<section class="djj-card djj-data-section" aria-labelledby="attendance-list-title"><header><div><h2 id="attendance-list-title">Jornadas por resolver</h2><p>@Model.Count() registro(s) dentro del período.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Empleado / fecha</th><th class="djj-align-right">Ordinarias</th><th class="djj-align-right">Extra</th><th class="djj-align-right">Ausencia</th><th>Estado</th><th>Decisión</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="6"><div class="djj-empty-state"><h3>Sin jornadas pendientes</h3><p>No hay registros para revisar en este período.</p></div></td></tr> }@foreach (var item in Model) { <tr><td><strong class="djj-table__primary">@item.NombreCompleto</strong><small class="djj-table__note">@item.Fecha.ToString("dd/MM/yyyy")</small>@if (!string.IsNullOrWhiteSpace(item.Observaciones)) { <small class="djj-table__note">@item.Observaciones</small> }</td><td class="djj-align-right">@item.HorasOrdinarias.ToString("N2") h</td><td class="djj-align-right">@item.HorasExtra.ToString("N2") h</td><td class="djj-align-right">@item.HorasAusencia.ToString("N2") h</td><td><span class="djj-status-badge djj-status-badge--@Tone(item.Estado)">@item.Estado</span></td><td><form asp-action="Decide" method="post" class="djj-hr-decision"><input type="hidden" name="JornadaId" value="@item.JornadaId" /><input type="hidden" name="RowVersionBase64" value="@item.RowVersionBase64" /><input type="hidden" name="desde" value="@desde?.ToString("yyyy-MM-dd")" /><input type="hidden" name="hasta" value="@hasta?.ToString("yyyy-MM-dd")" />@Html.AntiForgeryToken()<label class="djj-sr-only" for="attendance-response-@item.JornadaId">Observación para la jornada de @item.NombreCompleto</label><input id="attendance-response-@item.JornadaId" name="RespuestaSupervisor" maxlength="500" class="djj-input" placeholder="Observación" /><div class="djj-row-actions"><button name="Decision" value="Aprobada" class="djj-button djj-button--success djj-button--sm" data-djj-confirm="Aprobar la jornada de @item.NombreCompleto del @item.Fecha.ToString("dd/MM/yyyy").">Aprobar</button><button name="Decision" value="Rechazada" class="djj-button djj-button--danger-outline djj-button--sm" data-djj-confirm="Rechazar la jornada de @item.NombreCompleto del @item.Fecha.ToString("dd/MM/yyyy"). La observación quedará como respuesta del supervisor.">Rechazar</button></div></form></td></tr> }</tbody></table></div></section>
