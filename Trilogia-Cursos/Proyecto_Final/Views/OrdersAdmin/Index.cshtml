@model IEnumerable<Proyecto_Final.Models.Admin.OrderAdminListItemViewModel>
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Pedidos"; var estado=ViewBag.Estado as string; string Tone(string value)=>value=="Entregado"?"success":value=="Cancelado"?"danger":value=="Pendiente"?"warning":"info"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Ventas y pedidos</span><h1>Gestión de pedidos</h1><p>Consultá los pedidos y administrá su avance operativo.</p></div></header>
<section class="djj-card djj-filter-card"><form method="get" class="djj-filter-bar"><div class="djj-field"><label for="order-state">Estado</label><select id="order-state" name="estado" class="djj-select"><option value="">Todos</option>@foreach(var item in new[]{"Pendiente","Aprobado","EnProceso","Entregado","Cancelado"}){<option value="@item" selected="@(estado==item)">@item</option>}</select></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--primary" type="submit">Filtrar</button><a class="djj-button djj-button--ghost" asp-action="Index">Limpiar</a></div><span class="djj-filter-bar__results">@(Model?.Count()??0) pedidos</span></form></section>
<section class="djj-card djj-data-section" aria-labelledby="orders-title"><header><div><h2 id="orders-title">Pedidos</h2><p>Estado, entrega y total de cada registro.</p></div></header>@if(Model==null||!Model.Any()){<div class="djj-empty-state"><h3>No hay pedidos</h3><p>No se encontraron registros para este filtro.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th>Entrega</th><th class="djj-align-right">Líneas</th><th class="djj-align-right">Total</th><th>Acción</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>#@item.PedidoId</strong></td><td><strong class="djj-table__primary">@item.Cliente</strong><small class="djj-table__note">@item.Correo</small></td><td class="djj-table__nowrap">@item.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td><td><span class="djj-badge djj-badge--@Tone(item.Estado)">@item.Estado</span></td><td><span class="djj-table__primary">@(string.IsNullOrWhiteSpace(item.TipoEntrega)?"No definido":item.TipoEntrega)</span><small class="djj-table__note">@(string.IsNullOrWhiteSpace(item.DireccionEntrega)?"Sin dirección":item.DireccionEntrega)</small></td><td class="djj-align-right">@item.TotalLineas</td><td class="djj-align-right">₡@item.Total.ToString("N2")</td><td><a class="djj-button djj-button--outline djj-button--sm" asp-action="Detail" asp-route-id="@item.PedidoId">Ver detalle</a></td></tr>}</tbody></table></div>}</section>
