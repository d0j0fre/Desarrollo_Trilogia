@model Proyecto_Final.Models.Admin.OrderDetailViewModel
@using Microsoft.AspNetCore.Http
@using Proyecto_Final.Services
@inject NavigationMenuService MenuAccess
@{
    ViewData["Title"] = "Detalle del pedido";
    // SellerOrders/Detail reutiliza esta vista para el vendedor: sin cambiar estado ni facturar.
    var soloLectura = ViewData["SoloLectura"] is true;
}

@section Styles {
    <link href="~/css/custom-theme.css" rel="stylesheet" />
}

<div class="container-fluid pt-4 backoffice-page orders-admin-page">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="admin-page-header">
                <h2 class="mb-2">Detalle del pedido #@Model.PedidoId</h2>
                <p>@(soloLectura
                    ? "Consulta la información general del pedido y los productos asociados."
                    : "Consulta la información general del pedido, productos asociados y actualiza su estado.")</p>
            </div>
        </div>
    </div>

    <div class="row px-xl-5 pb-3">
        <div class="col-lg-8 pb-3">
            <div class="admin-card h-100">
                <h5 class="mb-4">Información general</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Cliente</label>
                        <span>@Model.Cliente</span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Correo</label>
                        <span>@Model.Correo</span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Fecha del pedido</label>
                        <span>@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Estado actual</label>
                        <span class="admin-badge-soft @OrderStatusFlow.BadgeClass(Model.Estado)">@OrderStatusFlow.Name(Model.Estado)</span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Tipo de entrega</label>
                        <span>
                            @(string.IsNullOrWhiteSpace(Model.TipoEntrega)
                                                        ? "No definido"
                                                        : Model.TipoEntrega)
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Total</label>
                        <span class="font-weight-bold">₡@Model.Total.ToString("N2")</span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Método de pago</label>
                        <span>
                            @PaymentMethodNames.Display(Model.MetodoPago)
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold d-block">Estado de pago</label>
                        <span>
                            @(string.IsNullOrWhiteSpace(Model.EstadoPago)
                                                        ? "No registrado"
                                                        : Model.EstadoPago)
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ReferenciaPago))
                    {
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold d-block">Referencia de pago</label>
                            <span>@Model.ReferenciaPago</span>
                        </div>
                    }

                    @if (Model.FechaPago.HasValue)
                    {
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold d-block">Fecha de pago</label>
                            <span>@Model.FechaPago.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }

                    <div class="col-md-12 mb-3">
                        <label class="font-weight-bold d-block">Dirección de entrega</label>
                        <span>
                            @(string.IsNullOrWhiteSpace(Model.DireccionEntrega)
                                                        ? "No registrada"
                                                        : Model.DireccionEntrega)
                        </span>
                    </div>

                    <div class="col-md-12 mb-0">
                        <label class="font-weight-bold d-block">Observaciones</label>
                        <span>
                            @(string.IsNullOrWhiteSpace(Model.Observaciones)
                                                        ? "Sin observaciones."
                                                        : Model.Observaciones)
                        </span>
                    </div>
                </div>

                @if (ViewData["DatosCliente"] is Proyecto_Final.Models.Store.OrderCustomerDataViewModel datosCliente)
                {
                    @* G3-15: lo que el cliente indicó al pagar en la Tienda. *@
                    <h5 class="mt-4 mb-3">Datos del cliente para facturar</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold d-block">Tipo de cliente</label>
                            <span>@datosCliente.TipoCliente</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold d-block">Factura electrónica</label>
                            <span>@(datosCliente.FacturaElectronica ? "Sí, la solicitó" : "No la solicitó")</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold d-block">Correo del comprobante</label>
                            <span>@(datosCliente.CorreoComprobante ?? "No indicado")</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold d-block">Teléfonos</label>
                            <span>@(string.Join(" · ", new[] { datosCliente.Telefono, datosCliente.TelefonoAlterno }.Where(t => !string.IsNullOrWhiteSpace(t))) is { Length: > 0 } telefonos ? telefonos : "No indicados")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4 pb-3">
            @if (soloLectura)
            {
            <div class="admin-card h-100">
                <h5 class="mb-3">Facturación</h5>
                <p class="mb-4">
                    @(Model.HasInvoice
                        ? $"Factura {Model.NumeroFactura}."
                        : "Este pedido todavía no tiene factura.")
                </p>
                <a asp-controller="SellerOrders" asp-action="MyOrders" class="btn btn-ds-neutral btn-block">
                    <i class="fa fa-arrow-left mr-2"></i>Volver a mis pedidos
                </a>
            </div>
            }
            else
            {
            <div class="admin-card h-100">
                <h5 class="mb-4">Actualizar estado</h5>

                @{
                    // G2-30: solo los cambios que acepta sp_Admin_UpdateOrderStatus desde el estado actual.
                    var siguientes = OrderStatusFlow.NextStates(Model.Estado, Model.HasInvoice);
                    // G2-32: cada botón según el permiso de la acción a la que lleva.
                    var rol = Context.Session.GetString("UserRole");
                    var puedeCambiarEstado = await MenuAccess.CanSubmitAsync(rol, "OrdersAdmin", "UpdateStatus");
                    var puedeVerFactura = await MenuAccess.CanOpenAsync(rol, "Billing", "Detail");
                    var puedeFacturar = await MenuAccess.CanSubmitAsync(rol, "Billing", "GenerateFromOrder");
                }
                <form asp-controller="OrdersAdmin" asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@Model.PedidoId" />

                    @if (siguientes.Count > 0 && puedeCambiarEstado)
                    {
                        <div class="form-group">
                            <label class="font-weight-bold" for="nuevoEstado">Nuevo estado</label>
                            <select id="nuevoEstado" name="nuevoEstado" class="form-control">
                                @foreach (var estado in siguientes)
                                {
                                    <option value="@estado">@OrderStatusFlow.Name(estado)</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-ds-action btn-block mb-2">
                            <i class="fa fa-save mr-2"></i>Guardar estado
                        </button>
                    }
                    else if (puedeCambiarEstado)
                    {
                        <p class="text-muted">
                            @(Model.Estado is "EnRuta" or "Fallido"
                                ? $"El estado «{OrderStatusFlow.Name(Model.Estado)}» lo actualiza Rutas y entregas."
                                : $"Un pedido en estado «{OrderStatusFlow.Name(Model.Estado)}» no tiene cambios de estado desde esta pantalla.")
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">Su perfil puede consultar el pedido, pero no cambiar su estado.</p>
                    }

                    <a asp-controller="OrdersAdmin" asp-action="Index" class="btn btn-ds-neutral btn-block">
                        <i class="fa fa-arrow-left mr-2"></i>Volver a pedidos
                    </a>
                </form>

                <hr />

                <h5 class="mb-3">Facturación</h5>

                @if (Model.HasInvoice && Model.FacturaId.HasValue)
                {
                    @if (puedeVerFactura)
                    {
                    <a asp-controller="Billing"
                       asp-action="Detail"
                       asp-route-id="@Model.FacturaId.Value"
                       class="btn btn-ds-view btn-block mb-2">
                        <i class="fa fa-file-invoice mr-2"></i>Ver factura
                    </a>
                    }
                    <p class="text-muted mb-0">
                        Este pedido ya tiene una factura asociada@(string.IsNullOrWhiteSpace(Model.NumeroFactura) ? "" : $" ({Model.NumeroFactura})").
                    </p>
                }
                else if (Model.CanGenerateInvoice && puedeFacturar)
                {
                    <form asp-controller="Billing"
                          asp-action="GenerateFromOrder"
                          method="post"
                          data-s3-confirm="Desea generar la factura para este pedido?"
                          data-s3-confirm-title="Generar factura"
                          data-s3-confirm-type="warning"
                          data-s3-confirm-ok="Si, generar"
                          data-s3-confirm-cancel="Volver">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                        <button type="submit" class="btn btn-ds-action btn-block mb-2">
                            <i class="fa fa-file-invoice-dollar mr-2"></i>Generar factura
                        </button>
                    </form>
                    <p class="text-muted mb-0">
                        La factura se genera desde las lineas actuales del pedido. No se descuenta inventario en esta accion.
                    </p>
                }
                else if (Model.CanGenerateInvoice)
                {
                    <p class="text-muted mb-0">
                        Este pedido todavía no tiene factura. Su perfil no genera facturas.
                    </p>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Este pedido no permite generar factura desde esta vista.
                    </p>
                }
            </div>
            }
        </div>
    </div>

    <div class="row px-xl-5 pb-5">
        <div class="col-12">
            <div class="admin-table-wrapper">
                <div class="p-4 border-bottom">
                    <h5 class="mb-0">Detalle de productos</h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>ID detalle</th>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio unitario</th>
                                <th>Subtotal</th>
                                <th>Stock actual</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Detalles == null || !Model.Detalles.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        No hay líneas registradas para este pedido.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Detalles)
                                {
                                    var claseStock = item.StockActual <= 0
                                    ? "danger"
                                    : item.StockActual <= 5
                                    ? "warning"
                                    : "success";

                                    <tr>
                                        <td>@item.PedidoDetalleId</td>
                                        <td class="font-weight-bold">@item.Producto</td>
                                        <td>@item.Cantidad</td>
                                        <td>₡@item.PrecioUnitario.ToString("N2")</td>
                                        <td>₡@item.Subtotal.ToString("N2")</td>
                                        <td>
                                            <span class="admin-badge-soft @claseStock">@item.StockActual</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
