@model Proyecto_Final.Models.Admin.ClientFormViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Crear cliente"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Clientes · Nuevo registro</span><h1>Crear cliente</h1><p>Registrá la identidad y datos de contacto para su relación comercial.</p></div></header>
<div class="djj-form-layout"><form asp-action="Create" method="post" class="djj-card djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><fieldset><legend>Identidad y acceso</legend><div class="djj-field"><label asp-for="NombreCompleto" class="djj-field__label"></label><input asp-for="NombreCompleto" class="djj-input" autocomplete="name" /><span asp-validation-for="NombreCompleto" class="djj-field__error"></span></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="Correo" class="djj-field__label"></label><input asp-for="Correo" class="djj-input" autocomplete="email" /><span asp-validation-for="Correo" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Contrasena" class="djj-field__label"></label><input asp-for="Contrasena" class="djj-input" autocomplete="new-password" /><small class="djj-field__hint">Contraseña temporal de 12 a 128 caracteres.</small><span asp-validation-for="Contrasena" class="djj-field__error"></span></div></div></fieldset><fieldset><legend>Contacto</legend><div class="djj-field"><label asp-for="Telefono" class="djj-field__label"></label><input asp-for="Telefono" class="djj-input" autocomplete="tel" /><span asp-validation-for="Telefono" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Direccion" class="djj-field__label"></label><textarea asp-for="Direccion" rows="3" class="djj-textarea" autocomplete="street-address"></textarea><span asp-validation-for="Direccion" class="djj-field__error"></span></div></fieldset><fieldset><legend>Estado</legend><label class="djj-check"><input asp-for="Activo" />Cliente activo</label><div class="djj-field"><label asp-for="MotivoInactivacion" class="djj-field__label"></label><textarea asp-for="MotivoInactivacion" rows="2" class="djj-textarea"></textarea><small class="djj-field__hint">Solo es necesario al registrar el cliente como inactivo.</small><span asp-validation-for="MotivoInactivacion" class="djj-field__error"></span></div></fieldset><div class="djj-form-actions"><a asp-action="Index" class="djj-button djj-button--ghost">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Guardar cliente</button></div></form><aside class="djj-card djj-form-guidance"><h2>Antes de guardar</h2><ul><li>El correo debe ser único.</li><li>El registro tendrá rol Cliente.</li><li>Un cliente inactivo no puede iniciar sesión.</li><li>La creación queda en auditoría.</li></ul></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
