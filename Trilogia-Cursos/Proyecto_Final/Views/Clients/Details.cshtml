@model Proyecto_Final.Models.Admin.ClientDetailViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Detalle de cliente"; string Tone(string state) => state switch { "Entregado" => "success", "Cancelado" => "danger", "Pendiente" => "warning", _ => "info" }; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Cliente · ID @Model.UsuarioId</span><h1>@Model.NombreCompleto</h1><p>@Model.Correo · @(string.IsNullOrWhiteSpace(Model.Telefono) ? "Sin teléfono" : Model.Telefono)</p></div><div class="djj-page-header__actions"><span class="djj-badge djj-badge--@(Model.Activo ? "success" : "neutral")">@(Model.Activo ? "Activo" : "Inactivo")</span><a asp-action="Edit" asp-route-id="@Model.UsuarioId" class="djj-button djj-button--outline">Editar</a><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
<div class="djj-kpi-grid"><article class="djj-card djj-kpi-card"><span>Pedidos</span><strong>@Model.TotalPedidos</strong></article><article class="djj-card djj-kpi-card"><span>Total comprado</span><strong>₡@Model.TotalComprado.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Último pedido</span><strong class="djj-kpi-card__compact">@(Model.UltimoPedido?.ToString("dd/MM/yyyy") ?? "Sin pedidos")</strong></article></div>
<div class="djj-detail-layout"><section class="djj-card"><div class="djj-card__header"><div><h2>Datos principales</h2><p>Información administrativa y de contacto.</p></div></div><dl class="djj-detail-grid"><div><dt>Correo</dt><dd>@Model.Correo</dd></div><div><dt>Teléfono</dt><dd>@(Model.Telefono ?? "Sin teléfono")</dd></div><div><dt>Dirección</dt><dd>@(Model.Direccion ?? "Sin dirección")</dd></div><div><dt>Registro</dt><dd>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd></div></dl></section><aside class="djj-card"><div class="djj-card__header"><div><h2>Estado del cliente</h2><p>@(Model.Activo ? "Puede iniciar sesión y realizar pedidos." : "No puede iniciar sesión ni realizar pedidos.")</p></div></div>@if (!Model.Activo) { <dl class="djj-detail-grid"><div><dt>Fecha de inactivación</dt><dd>@(Model.FechaInactivacion?.ToString("dd/MM/yyyy HH:mm") ?? "No registrada")</dd></div><div><dt>Motivo</dt><dd>@(Model.MotivoInactivacion ?? "No indicado")</dd></div></dl> }<form asp-action="ToggleStatus" method="post" class="djj-workspace-form" data-djj-confirm="@(Model.Activo ? "Inactivar a " + Model.NombreCompleto + ". No podrá iniciar sesión ni realizar pedidos." : "Reactivar a " + Model.NombreCompleto + ".")">@Html.AntiForgeryToken()<input type="hidden" name="usuarioId" value="@Model.UsuarioId" /><input type="hidden" name="returnTo" value="details" /><div class="djj-field"><label for="client-status-reason" class="djj-field__label">Motivo</label><textarea id="client-status-reason" name="motivo" rows="2" class="djj-textarea"></textarea></div><button type="submit" class="djj-button @(Model.Activo ? "djj-button--danger" : "djj-button--success")">@(Model.Activo ? "Inactivar cliente" : "Reactivar cliente")</button></form></aside></div>
<section class="djj-card djj-data-section" aria-labelledby="client-orders"><header><div><h2 id="client-orders">Pedidos del cliente</h2><p>Historial comercial disponible.</p></div><span class="djj-badge djj-badge--neutral">@Model.Pedidos.Count registro(s)</span></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th>Entrega</th><th class="djj-align-right">Total</th><th>Observaciones</th></tr></thead><tbody>
@if (!Model.Pedidos.Any()) { <tr><td colspan="6"><div class="djj-empty-state"><h3>Sin pedidos</h3><p>Este cliente no tiene pedidos registrados.</p></div></td></tr> }
@foreach (var item in Model.Pedidos) { <tr><td><strong>#@item.PedidoId</strong></td><td class="djj-table__nowrap">@item.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td><td><span class="djj-badge djj-badge--@Tone(item.Estado)">@item.Estado</span></td><td>@(item.TipoEntrega ?? "No indicado")</td><td class="djj-align-right">₡@item.Total.ToString("N2")</td><td>@(item.Observaciones ?? "Sin observaciones")</td></tr> }
</tbody></table></div></section>
