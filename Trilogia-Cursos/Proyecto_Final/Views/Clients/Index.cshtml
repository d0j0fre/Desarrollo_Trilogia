@model Proyecto_Final.Models.Admin.ClientFilterViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Clientes"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Clientes · Administración</span><h1>Clientes</h1><p>Gestioná identidad, contacto, estado e historial comercial.</p></div><div class="djj-page-header__actions"><a asp-action="Create" class="djj-button djj-button--primary">Nuevo cliente</a></div></header>
<nav class="djj-domain-nav" aria-label="Clientes y crédito"><a asp-action="Index" aria-current="page">Clientes</a><a asp-controller="Credits" asp-action="Index">Crédito</a><a asp-controller="AccountsReceivableAdmin" asp-action="Index">Cuentas por cobrar</a></nav>
<section class="djj-card djj-filter-card" aria-labelledby="client-filters"><h2 id="client-filters">Filtrar clientes</h2><form asp-action="Index" method="get" class="djj-filter-bar djj-filter-bar--wide"><div class="djj-field"><label for="client-search" class="djj-field__label">Buscar</label><input id="client-search" type="search" name="buscar" value="@Model.Buscar" class="djj-input" placeholder="Nombre, correo, teléfono o dirección" /></div><div class="djj-field"><label for="client-status" class="djj-field__label">Estado</label><select id="client-status" name="estado" class="djj-select"><option value="">Todos</option><option value="Activo" selected="@(Model.Estado == "Activo")">Activos</option><option value="Inactivo" selected="@(Model.Estado == "Inactivo")">Inactivos</option></select></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--primary" type="submit">Buscar</button><a asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div><span class="djj-filter-bar__results">@Model.Clientes.Count cliente(s)</span></form></section>
<section class="djj-card djj-data-section" aria-labelledby="clients-table"><header><div><h2 id="clients-table">Relación comercial</h2><p>Pedidos, compras y estado de acceso de cada cliente.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Cliente</th><th>Contacto</th><th class="djj-align-right">Pedidos</th><th class="djj-align-right">Total comprado</th><th>Último pedido</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@if (!Model.Clientes.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin resultados</h3><p>No se encontraron clientes con los filtros indicados.</p></div></td></tr> }
@foreach (var item in Model.Clientes) { <tr><td><strong class="djj-table__primary">@item.NombreCompleto</strong><small class="djj-table__note">ID @item.UsuarioId · Registro @item.FechaRegistro.ToString("dd/MM/yyyy")</small></td><td><span class="djj-table__primary">@item.Correo</span><small class="djj-table__note">@(string.IsNullOrWhiteSpace(item.Telefono) ? "Sin teléfono" : item.Telefono)</small></td><td class="djj-align-right">@item.TotalPedidos</td><td class="djj-align-right">₡@item.TotalComprado.ToString("N2")</td><td>@(item.UltimoPedido?.ToString("dd/MM/yyyy") ?? "Sin pedidos")</td><td><span class="djj-badge djj-badge--@(item.Activo ? "success" : "neutral")">@(item.Activo ? "Activo" : "Inactivo")</span></td><td><div class="djj-row-actions"><a asp-action="Details" asp-route-id="@item.UsuarioId" class="djj-button djj-button--outline djj-button--sm">Detalle</a><a asp-action="Edit" asp-route-id="@item.UsuarioId" class="djj-button djj-button--ghost djj-button--sm">Editar</a><form asp-action="ToggleStatus" method="post" data-djj-confirm="@(item.Activo ? "Inactivar a " + item.NombreCompleto + ". No podrá iniciar sesión ni realizar pedidos." : "Reactivar a " + item.NombreCompleto + ".")">@Html.AntiForgeryToken()<input type="hidden" name="usuarioId" value="@item.UsuarioId" /><input type="hidden" name="buscar" value="@Model.Buscar" /><input type="hidden" name="estado" value="@Model.Estado" /><input type="hidden" name="motivo" value="@(item.Activo ? "Inactivación realizada desde el listado de clientes." : "Reactivación realizada desde el listado de clientes.")" /><button type="submit" class="djj-button @(item.Activo ? "djj-button--danger" : "djj-button--success") djj-button--sm">@(item.Activo ? "Inactivar" : "Reactivar")</button></form></div></td></tr> }
</tbody></table></div></section>
