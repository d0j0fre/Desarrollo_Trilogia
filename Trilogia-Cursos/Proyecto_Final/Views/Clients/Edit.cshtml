@model Proyecto_Final.Models.Admin.ClientFormViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Editar cliente"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Clientes · ID @Model.UsuarioId</span><h1>Editar @Model.NombreCompleto</h1><p>Actualizá datos comerciales, acceso y estado.</p></div><div class="djj-page-header__actions"><a asp-action="Details" asp-route-id="@Model.UsuarioId" class="djj-button djj-button--outline">Detalle</a></div></header>
<div class="djj-form-layout"><form asp-action="Edit" method="post" class="djj-card djj-workspace-form">@Html.AntiForgeryToken()<input asp-for="UsuarioId" type="hidden" /><input asp-for="FechaRegistro" type="hidden" /><div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><fieldset><legend>Identidad y acceso</legend><div class="djj-field"><label asp-for="NombreCompleto" class="djj-field__label"></label><input asp-for="NombreCompleto" class="djj-input" autocomplete="name" /><span asp-validation-for="NombreCompleto" class="djj-field__error"></span></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="Correo" class="djj-field__label"></label><input asp-for="Correo" class="djj-input" autocomplete="email" /><span asp-validation-for="Correo" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Contrasena" class="djj-field__label">Nueva contraseña</label><input asp-for="Contrasena" class="djj-input" autocomplete="new-password" /><small class="djj-field__hint">Dejala vacía para conservar la actual.</small><span asp-validation-for="Contrasena" class="djj-field__error"></span></div></div></fieldset><fieldset><legend>Contacto</legend><div class="djj-field"><label asp-for="Telefono" class="djj-field__label"></label><input asp-for="Telefono" class="djj-input" autocomplete="tel" /><span asp-validation-for="Telefono" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Direccion" class="djj-field__label"></label><textarea asp-for="Direccion" rows="3" class="djj-textarea" autocomplete="street-address"></textarea><span asp-validation-for="Direccion" class="djj-field__error"></span></div></fieldset><fieldset><legend>Estado</legend><label class="djj-check"><input asp-for="Activo" />Cliente activo</label><div class="djj-field"><label asp-for="MotivoInactivacion" class="djj-field__label"></label><textarea asp-for="MotivoInactivacion" rows="3" class="djj-textarea"></textarea><small class="djj-field__hint">Requerido al inactivar.</small><span asp-validation-for="MotivoInactivacion" class="djj-field__error"></span></div></fieldset><div class="djj-form-actions"><a asp-action="Details" asp-route-id="@Model.UsuarioId" class="djj-button djj-button--ghost">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Guardar cambios</button></div></form><aside class="djj-form-guidance"><section class="djj-card"><h2>Resumen comercial</h2><dl class="djj-detail-grid"><div><dt>Pedidos</dt><dd>@Model.TotalPedidos</dd></div><div><dt>Total comprado</dt><dd class="djj-money">₡@Model.TotalComprado.ToString("N2")</dd></div><div><dt>Último pedido</dt><dd>@(Model.UltimoPedido?.ToString("dd/MM/yyyy") ?? "Sin pedidos")</dd></div><div><dt>Registro</dt><dd>@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd></div></dl></section><section class="djj-card"><h2>Estado actual</h2><span class="djj-badge djj-badge--@(Model.Activo ? "success" : "neutral")">@(Model.Activo ? "Activo" : "Inactivo")</span>@if (!Model.Activo) { <p>@(string.IsNullOrWhiteSpace(Model.MotivoInactivacion) ? "Sin motivo indicado." : Model.MotivoInactivacion)</p> }</section></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
