@model Proyecto_Final.Models.Store.CheckoutViewModel
@{ Layout = "_StorefrontLayout"; ViewData["Title"] = "Finalizar compra"; }
<main class="djj-container djj-store-page">
    <nav class="djj-store-page__breadcrumb" aria-label="Migas de pan"><ol class="djj-breadcrumb"><li><a asp-controller="Cart" asp-action="Index">Carrito</a></li><li aria-hidden="true"><svg class="djj-icon djj-icon--sm"><use href="#djj-icon-caret-right"></use></svg></li><li aria-current="page">Finalizar compra</li></ol></nav>
    <header class="djj-store-heading"><div class="djj-store-heading__copy"><span class="djj-page-header__eyebrow">Compra segura</span><h1>Finalizar compra</h1><p>Completá la entrega y revisá el pedido antes de confirmarlo.</p></div></header>
    <div class="djj-checkout-layout">
        <form asp-action="Checkout" method="post" id="checkoutForm" class="djj-card djj-checkout-form">
            @Html.AntiForgeryToken()<input asp-for="OperationToken" type="hidden" /><input type="hidden" id="savedProvincia" value="@(Model.Provincia ?? string.Empty)" /><input type="hidden" id="savedCanton" value="@(Model.Canton ?? string.Empty)" /><input type="hidden" id="savedDistrito" value="@(Model.Distrito ?? string.Empty)" />
            <div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div>
            <fieldset class="djj-checkout-section"><legend>Datos del cliente</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="CorreoElectronico" class="djj-field__label"></label><input asp-for="CorreoElectronico" class="djj-input" readonly /><span asp-validation-for="CorreoElectronico" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Identificacion" class="djj-field__label"></label><input asp-for="Identificacion" class="djj-input" aria-describedby="Identificacion-error" /><span id="Identificacion-error" asp-validation-for="Identificacion" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Telefono" class="djj-field__label"></label><input asp-for="Telefono" class="djj-input" autocomplete="tel" aria-describedby="Telefono-error" /><span id="Telefono-error" asp-validation-for="Telefono" class="djj-field__error"></span></div></div></fieldset>
            <fieldset class="djj-checkout-section"><legend>Entrega</legend><div class="djj-form-grid"><div class="djj-field"><label asp-for="Pais" class="djj-field__label"></label><select asp-for="Pais" class="djj-select"><option value="Costa Rica">Costa Rica</option></select></div><div class="djj-field"><span class="djj-field__label">Método de entrega</span><p class="djj-readonly-value">Envío a domicilio</p><input asp-for="TipoEntrega" type="hidden" value="Envío a domicilio" /></div><div class="djj-field"><label asp-for="Provincia" class="djj-field__label"></label><select asp-for="Provincia" id="provincia" class="djj-select" aria-describedby="Provincia-error"><option value="">Elegí una provincia</option></select><span id="Provincia-error" asp-validation-for="Provincia" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Canton" class="djj-field__label"></label><select asp-for="Canton" id="canton" class="djj-select" aria-describedby="Canton-error" disabled><option value="">Elegí un cantón</option></select><span id="Canton-error" asp-validation-for="Canton" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Distrito" class="djj-field__label"></label><select asp-for="Distrito" id="distrito" class="djj-select" aria-describedby="Distrito-error" disabled><option value="">Elegí un distrito</option></select><span id="Distrito-error" asp-validation-for="Distrito" class="djj-field__error"></span></div><div class="djj-field djj-form-grid__wide"><label asp-for="DireccionDetalle" class="djj-field__label"></label><input asp-for="DireccionDetalle" class="djj-input" autocomplete="street-address" aria-describedby="DireccionDetalle-error" /><span id="DireccionDetalle-error" asp-validation-for="DireccionDetalle" class="djj-field__error"></span></div></div></fieldset>
            <fieldset class="djj-checkout-section"><legend>Pago QA</legend><div class="djj-alert djj-alert--info" role="note"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-info"></use></svg><div><strong>Pago simulado</strong><p>No se realizará un cobro real. No ingresés datos bancarios sensibles.</p></div></div><div class="djj-payment-options">@foreach(var method in new[]{"Efectivo contra entrega","SINPE Móvil simulado","Tarjeta demo","Transferencia simulada"}){<label class="djj-payment-option"><input type="radio" asp-for="MetodoPago" value="@method" aria-describedby="MetodoPago-error" /><span>@method</span></label>}</div><span id="MetodoPago-error" asp-validation-for="MetodoPago" class="djj-field__error"></span><div class="djj-field"><label asp-for="ReferenciaPago" class="djj-field__label"></label><input asp-for="ReferenciaPago" class="djj-input" maxlength="80" aria-describedby="ReferenciaPago-hint ReferenciaPago-error" /><small id="ReferenciaPago-hint" class="djj-field__hint">Solo una referencia ficticia cuando corresponda.</small><span id="ReferenciaPago-error" asp-validation-for="ReferenciaPago" class="djj-field__error"></span></div></fieldset>
            <fieldset class="djj-checkout-section"><legend>Notas</legend><div class="djj-field"><label asp-for="Observaciones" class="djj-field__label"></label><textarea asp-for="Observaciones" class="djj-textarea" rows="3" aria-describedby="Observaciones-error"></textarea><span id="Observaciones-error" asp-validation-for="Observaciones" class="djj-field__error"></span></div></fieldset>
            <div class="djj-checkout-actions"><a class="djj-button djj-button--ghost" asp-action="Index">Volver al carrito</a><button class="djj-button djj-button--primary" type="submit" data-djj-submit>Crear pedido</button></div>
        </form>
        <aside class="djj-card djj-checkout-summary" aria-labelledby="checkout-summary-title"><h2 id="checkout-summary-title">Tu pedido</h2>@foreach(var item in Model.Cart.Items){<div class="djj-checkout-summary__row"><span>@item.Nombre <small>× @item.Cantidad</small></span><strong>₡@item.SubtotalConDescuento.ToString("N0")</strong></div>}@foreach(var gift in Model.Cart.Regalias){<div class="djj-checkout-summary__row"><span>@gift.Nombre <small>Regalía × @gift.Cantidad</small></span><strong>Incluido</strong></div>}@if(Model.Cart.DescuentoTotal > 0){<div class="djj-checkout-summary__row djj-cart-summary__discount"><span>Descuento</span><strong>−₡@Model.Cart.DescuentoTotal.ToString("N0")</strong></div>}<div class="djj-checkout-summary__total"><span>Total</span><strong>₡@Model.Cart.Total.ToString("N0")</strong></div></aside>
    </div>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/checkout.js" asp-append-version="true"></script> }
