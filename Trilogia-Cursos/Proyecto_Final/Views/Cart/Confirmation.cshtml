@using Microsoft.AspNetCore.Http
@model Proyecto_Final.Models.Store.OrderConfirmationViewModel
@{ Layout = "_StorefrontLayout"; ViewData["Title"] = "Pedido creado"; var isClient = string.Equals(Context.Session.GetString("UserRole"), "Cliente", StringComparison.OrdinalIgnoreCase); }
<main class="djj-container djj-store-page djj-confirmation">
    <section class="djj-card djj-confirmation__card" aria-labelledby="confirmation-title"><span class="djj-state__icon djj-state__icon--success"><svg class="djj-icon djj-icon--lg" aria-hidden="true"><use href="#djj-icon-check"></use></svg></span><span class="djj-page-header__eyebrow">Pedido #@Model.PedidoId</span><h1 id="confirmation-title">Pedido creado correctamente</h1><p>Registramos tu pedido. Podés consultar su detalle desde el portal cuando iniciás sesión como cliente.</p>
        <dl class="djj-confirmation__facts"><div><dt>Entrega</dt><dd>@Model.TipoEntrega</dd></div><div><dt>Productos</dt><dd>@Model.Items.Sum(x => x.Cantidad)</dd></div><div><dt>Total</dt><dd>₡@Model.Total.ToString("N0")</dd></div></dl>
        @if(!string.IsNullOrWhiteSpace(Model.DireccionEntrega)){<div class="djj-alert djj-alert--info"><svg class="djj-icon" aria-hidden="true"><use href="#djj-icon-truck"></use></svg><div><strong>Dirección de entrega</strong><p>@Model.DireccionEntrega</p></div></div>}
        <section class="djj-confirmation__items" aria-labelledby="confirmation-items-title"><h2 id="confirmation-items-title">Detalle del pedido</h2>@foreach(var item in Model.Items){<div><span><strong>@item.Nombre</strong><small>@item.Cantidad × @item.Categoria</small></span><strong>₡@item.Subtotal.ToString("N0")</strong></div>}</section>
        <div class="djj-confirmation__actions"><a class="djj-button djj-button--primary" asp-controller="Home" asp-action="Shop">Seguir comprando</a>@if(isClient){<a class="djj-button djj-button--outline" asp-controller="ClientPortal" asp-action="Index">Ver mis pedidos</a>}<a class="djj-button djj-button--ghost" asp-controller="Home" asp-action="Index">Ir al inicio</a></div>
    </section>
</main>
