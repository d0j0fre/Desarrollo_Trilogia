@model Proyecto_Final.Models.Admin.BudgetComparisonDashboardViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Presupuesto vs. real"; string Tone(string value) => value is "Excedido" or "Crítico" ? "danger" : value == "Advertencia" ? "warning" : "success"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Comparativa</span><h1>Presupuesto vs. real</h1><p>Comparación autoritativa y proyección determinista con datos registrados.</p></div><div class="djj-page-header__actions"><a asp-action="ExportCsv" asp-route-Year="@Model.Filter.Year" asp-route-DepartmentId="@Model.Filter.DepartmentId" asp-route-Month="@Model.Filter.Month" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-ExpenseStatus="@Model.Filter.ExpenseStatus" class="djj-button djj-button--outline">Descargar CSV</a><a asp-action="Print" asp-route-Year="@Model.Filter.Year" asp-route-DepartmentId="@Model.Filter.DepartmentId" asp-route-Month="@Model.Filter.Month" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-ExpenseStatus="@Model.Filter.ExpenseStatus" class="djj-button djj-button--ghost">Imprimir</a></div></header>
<nav class="djj-domain-nav" aria-label="Presupuestos y gastos"><a asp-controller="Budgets" asp-action="Index">Presupuestos</a><a asp-controller="Expenses" asp-action="Index">Gastos</a><a asp-action="Index" aria-current="page">Comparativa</a></nav>
<section class="djj-card djj-filter-card"><form method="get" class="djj-filter-bar djj-filter-bar--wide"><div class="djj-field"><label for="comparison-year">Año</label><input id="comparison-year" type="number" name="Year" value="@Model.Filter.Year" min="2000" max="2100" class="djj-input" /></div><div class="djj-field"><label for="comparison-dept">Departamento</label><select id="comparison-dept" name="DepartmentId" class="djj-select"><option value="">Todos</option>@foreach (var item in Model.Departments) { <option value="@item.Id" selected="@(Model.Filter.DepartmentId == item.Id)">@item.Name</option> }</select></div><div class="djj-field"><label for="comparison-month">Período</label><select id="comparison-month" name="Month" class="djj-select"><option value="">Año completo</option>@for (var i = 1; i <= 12; i++) { <option value="@i" selected="@(Model.Filter.Month == i)">Mes @i</option> }</select></div><div class="djj-field"><label for="comparison-category">Categoría</label><select id="comparison-category" name="CategoryId" class="djj-select"><option value="">Todas</option>@foreach (var item in Model.Categories) { <option value="@item.Id" selected="@(Model.Filter.CategoryId == item.Id)">@item.Name</option> }</select></div><div class="djj-field"><label for="comparison-status">Estado de gasto</label><select id="comparison-status" name="ExpenseStatus" class="djj-select"><option value="">Todos</option>@foreach (var state in new[] { "Registrado", "Aprobado", "Pagado", "Rechazado" }) { <option selected="@(Model.Filter.ExpenseStatus == state)">@state</option> }</select></div><button class="djj-button djj-button--primary">Actualizar</button></form></section>
<div class="djj-kpi-grid djj-kpi-grid--four"><article class="djj-card djj-kpi-card"><span>Presupuesto filtrado</span><strong>₡@Model.Summary.FilteredBudget.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Real aprobado + pagado</span><strong>₡@Model.Summary.RealExpense.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Disponible</span><strong>@(Model.Summary.Available < 0 ? "−" : string.Empty)₡@Math.Abs(Model.Summary.Available).ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Ejecución</span><strong>@Model.Summary.ExecutionPercent.ToString("N1")%</strong><small>Proyección: ₡@Model.Summary.AnnualProjection.ToString("N2")</small></article></div>
<div class="djj-financial-panels"><section class="djj-card djj-data-section"><header><div><h2>Por departamento</h2><p>¿Dónde se concentra la ejecución?</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Departamento</th><th class="djj-align-right">Presupuesto</th><th class="djj-align-right">Real</th><th>Ejecución</th></tr></thead><tbody>@foreach (var item in Model.ByDepartment) { <tr><td>@item.Name</td><td class="djj-align-right">₡@item.Budget.ToString("N2")</td><td class="djj-align-right">₡@item.Real.ToString("N2")</td><td><span class="djj-badge djj-badge--@Tone(item.Level)">@item.ExecutionPercent.ToString("N1")% · @item.Level</span></td></tr> }</tbody></table></div></section><section class="djj-card djj-data-section"><header><div><h2>Por categoría</h2><p>Presupuesto, compromiso y gasto real.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Categoría</th><th class="djj-align-right">Presupuesto</th><th class="djj-align-right">Pendiente</th><th class="djj-align-right">Real</th><th>Nivel</th></tr></thead><tbody>@foreach (var item in Model.ByCategory) { <tr><td>@item.Name</td><td class="djj-align-right">₡@item.Budget.ToString("N2")</td><td class="djj-align-right">₡@item.Pending.ToString("N2")</td><td class="djj-align-right">₡@item.Real.ToString("N2")</td><td><span class="djj-badge djj-badge--@Tone(item.Level)">@item.Level</span></td></tr> }</tbody></table></div></section></div>
<section class="djj-card djj-data-section" aria-labelledby="monthly-comparison"><header><div><h2 id="monthly-comparison">Serie mensual</h2><p>¿Cómo avanza el gasto real frente al presupuesto?</p></div></header><div class="djj-monthly-comparison">@foreach (var item in Model.Monthly) { var pct = item.Budget <= 0 ? 0 : Math.Min(100, (int)(item.Real / item.Budget * 100)); <div class="djj-progress-row"><div><strong>Mes @item.Month</strong><span>₡@item.Real.ToString("N0") de ₡@item.Budget.ToString("N0") @(item.Budget <= 0 ? "· sin presupuesto" : string.Empty)</span></div><div class="djj-progress" role="progressbar" aria-label="Ejecución del mes @item.Month" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"><span class="djj-progress__bar djj-progress__bar--@(item.Real > item.Budget ? "danger" : "primary")" style="--djj-progress-value:@pct%"></span></div></div> }</div></section>
<div class="djj-alert djj-alert--info" role="status">Pendiente: ₡@Model.Summary.PendingExpense.ToString("N2") · Departamentos sin presupuesto: @Model.Summary.DepartmentsWithoutBudget · Categorías excedidas: @Model.Summary.OverBudgetCategories · Actualizado @Model.UpdatedUtc.ToString("dd/MM/yyyy HH:mm") UTC</div>
<section class="djj-card djj-data-section"><header><div><h2>Detalle de gastos</h2><p>Registros que componen la comparativa.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Fecha</th><th>Departamento / categoría</th><th>Documento</th><th>Estado</th><th class="djj-align-right">Total</th></tr></thead><tbody>@if (!Model.ExpenseDetail.Items.Any()) { <tr><td colspan="5"><div class="djj-empty-state"><h3>Sin gastos</h3><p>No hay detalle para los filtros seleccionados.</p></div></td></tr> }@foreach (var item in Model.ExpenseDetail.Items) { <tr><td>@item.ExpenseDate.ToString("dd/MM/yyyy")</td><td>@item.DepartmentName<small class="djj-table__note">@item.CategoryName</small></td><td><a asp-controller="Expenses" asp-action="Details" asp-route-id="@item.ExpenseId">@item.DocumentNumber</a></td><td>@item.Status</td><td class="djj-align-right">₡@item.Total.ToString("N2")</td></tr> }</tbody></table></div></section>
