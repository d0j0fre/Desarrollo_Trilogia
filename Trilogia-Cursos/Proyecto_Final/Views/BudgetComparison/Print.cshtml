@model Proyecto_Final.Models.Admin.BudgetComparisonDashboardViewModel
@{ Layout = null; }
<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Presupuesto vs. real @Model.Filter.Year</title><style>body{font-family:Arial,sans-serif;margin:32px;color:black}table{border-collapse:collapse;width:100%;margin:18px 0}th,td{border:1px solid gray;padding:7px;text-align:left}.num{text-align:right;font-variant-numeric:tabular-nums}.muted{color:dimgray}button{min-height:44px;padding:8px 16px}@@media print{button{display:none}}</style></head><body><button type="button" onclick="window.print()">Imprimir</button><h1>Presupuesto vs. real · @Model.Filter.Year</h1><p class="muted">Generado @Model.UpdatedUtc.ToString("dd/MM/yyyy HH:mm") UTC</p><table><thead><tr><th>Presupuesto</th><th>Real</th><th>Pendiente</th><th>Disponible</th><th>Ejecución</th><th>Proyección</th></tr></thead><tbody><tr><td class="num">₡@Model.Summary.FilteredBudget.ToString("N2")</td><td class="num">₡@Model.Summary.RealExpense.ToString("N2")</td><td class="num">₡@Model.Summary.PendingExpense.ToString("N2")</td><td class="num">₡@Model.Summary.Available.ToString("N2")</td><td class="num">@Model.Summary.ExecutionPercent.ToString("N2")%</td><td class="num">₡@Model.Summary.AnnualProjection.ToString("N2")</td></tr></tbody></table><h2>Por departamento</h2><table><thead><tr><th>Departamento</th><th>Presupuesto</th><th>Pendiente</th><th>Real</th><th>Disponible</th></tr></thead><tbody>@foreach (var item in Model.ByDepartment) { <tr><td>@item.Name</td><td class="num">₡@item.Budget.ToString("N2")</td><td class="num">₡@item.Pending.ToString("N2")</td><td class="num">₡@item.Real.ToString("N2")</td><td class="num">₡@item.Available.ToString("N2")</td></tr> }</tbody></table><h2>Detalle</h2><table><thead><tr><th>Fecha</th><th>Departamento</th><th>Categoría</th><th>Documento</th><th>Estado</th><th>Total</th></tr></thead><tbody>@foreach (var item in Model.ExpenseDetail.Items) { <tr><td>@item.ExpenseDate.ToString("dd/MM/yyyy")</td><td>@item.DepartmentName</td><td>@item.CategoryName</td><td>@item.DocumentNumber</td><td>@item.Status</td><td class="num">₡@item.Total.ToString("N2")</td></tr> }</tbody></table></body></html>
