@model Proyecto_Final.Models.Admin.SellerPerformanceViewModel
@{
    var printMode = ViewData["PrintMode"] as bool? == true;
    ViewData["Title"] = "Desempeño de vendedores";
}

<div class="container-fluid pt-4 backoffice-page">
    <div class="row px-xl-5"><div class="col-12 d-flex justify-content-between"><div><h2>Desempeño de vendedores</h2><p>Ventas, clientes, ticket y metas del equipo (CU-134).</p></div>@if(printMode){<button class="btn btn-outline-primary d-print-none" onclick="window.print()">Imprimir</button>}</div></div>
    @if(!printMode)
    {
        <div class="row px-xl-5"><div class="col-12"><form method="get" class="admin-filter-bar form-row align-items-end">
            <div class="form-group col-md-2"><label>Desde</label><input name="Desde" type="date" value="@Model.Filtro.Desde.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="form-group col-md-2"><label>Hasta</label><input name="Hasta" type="date" value="@Model.Filtro.Hasta.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="form-group col-md-3"><label>Vendedor</label><select name="VendedorUsuarioId" class="form-control"><option value="">Todos</option>@foreach(var seller in Model.Vendedores){<option value="@seller.UsuarioId" selected="@(Model.Filtro.VendedorUsuarioId==seller.UsuarioId)">@seller.NombreCompleto</option>}</select></div>
            <div class="form-group col-md-2"><label>Orden</label><select name="Orden" class="form-control"><option value="ventas_desc" selected="@(Model.Filtro.Orden=="ventas_desc")">Ventas ↓</option><option value="ventas_asc" selected="@(Model.Filtro.Orden=="ventas_asc")">Ventas ↑</option><option value="nombre" selected="@(Model.Filtro.Orden=="nombre")">Nombre</option><option value="cumplimiento_desc" selected="@(Model.Filtro.Orden=="cumplimiento_desc")">Cumplimiento ↓</option></select></div>
            <div class="form-group col-md-3"><button class="btn btn-primary">Consultar</button> <a asp-action="Print" asp-route-Desde="@Model.Filtro.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Filtro.Hasta.ToString("yyyy-MM-dd")" asp-route-VendedorUsuarioId="@Model.Filtro.VendedorUsuarioId" asp-route-Orden="@Model.Filtro.Orden" target="_blank" class="btn btn-outline-secondary">Imprimir</a> <a asp-action="ExportCsv" asp-route-Desde="@Model.Filtro.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Filtro.Hasta.ToString("yyyy-MM-dd")" asp-route-VendedorUsuarioId="@Model.Filtro.VendedorUsuarioId" asp-route-Orden="@Model.Filtro.Orden" class="btn btn-outline-success">CSV</a></div>
            <div asp-validation-summary="All" class="text-danger col-12"></div>
        </form></div></div>
    }
    <div class="row px-xl-5 mb-4"><div class="col-md-4"><div class="card"><div class="card-body"><small>Ventas</small><h4>₡@Model.TotalVentas.ToString("N2")</h4></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><small>Pedidos</small><h4>@Model.TotalPedidos</h4></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><small>Ticket promedio</small><h4>₡@Model.TicketPromedio.ToString("N2")</h4></div></div></div></div>
    <div class="row px-xl-5 pb-5"><div class="col-12 table-responsive"><table class="table table-hover"><thead><tr><th>Vendedor</th><th>Ventas</th><th>Pedidos</th><th>Facturas</th><th>Ticket</th><th>Clientes</th><th>Meta</th><th>Cumplimiento</th></tr></thead><tbody>
    @if(!Model.HayDatos){<tr><td colspan="8" class="text-center text-muted py-4">No hay datos de vendedores para este período.</td></tr>}
    @foreach(var row in Model.Filas){<tr><td>@row.VendedorNombre</td><td>₡@row.Ventas.ToString("N2")</td><td>@row.Pedidos</td><td>@row.Facturas</td><td>₡@row.TicketPromedio.ToString("N2")</td><td>@row.ClientesAtendidos</td><td>@(row.Meta.HasValue?$"₡{row.Meta:N2}":"Sin meta")</td><td>@(row.CumplimientoPorcentual.HasValue?$"{row.CumplimientoPorcentual:N2}%":"—")</td></tr>}
    </tbody></table></div></div>
</div>
