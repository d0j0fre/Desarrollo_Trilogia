@model Proyecto_Final.Models.Admin.SellerPerformanceViewModel
@using Proyecto_Final.Models.Admin
@using Proyecto_Final.Models.Presentation
@{
    Layout = "_WorkspaceLayout";
    var printMode = ViewData["PrintMode"] as bool? == true;
    ViewData["Title"] = "Desempeño de vendedores";
    var period = $"{Model.Filtro.Desde:dd/MM/yyyy} — {Model.Filtro.Hasta:dd/MM/yyyy}";
    var chart = new AnalyticsChartViewModel { Title = "Ventas frente a meta por vendedor", Context = period + " · Las metas abarcan los meses completos del rango", TargetLabel = "Meta", Rows = Model.Filas.Select(row => new AnalyticsChartRow(row.VendedorNombre, row.Ventas, row.Meta)).ToList() };
}
<div class="djj-analytics">
<header class="djj-page-header">
<div>
<h1>Desempeño de vendedores</h1>
<p>Resultados del equipo y avance frente a sus metas.</p>
<span class="djj-page-header__meta">@period</span>
</div>
@if (printMode) { <button type="button" class="djj-button djj-button--secondary" data-djj-screen-only onclick="window.print()">Imprimir</button> }
</header>
@if (!printMode) {
<form method="get" class="djj-card djj-analytics-filter djj-filter-bar djj-filter-bar--analytics" data-djj-screen-only aria-label="Filtros del reporte">
<div class="djj-field">
<label for="sellerperformance-desde">Desde</label>
<input id="sellerperformance-desde" name="Desde" type="date" value="@Model.Filtro.Desde.ToString("yyyy-MM-dd")" class="djj-input" />
</div>
<div class="djj-field">
<label for="sellerperformance-hasta">Hasta</label>
<input id="sellerperformance-hasta" name="Hasta" type="date" value="@Model.Filtro.Hasta.ToString("yyyy-MM-dd")" class="djj-input" />
</div>
<div class="djj-field">
<label for="sellerperformance-vendedorusuarioid">Vendedor</label>
<select id="sellerperformance-vendedorusuarioid" name="VendedorUsuarioId" class="djj-select">
<option value="">Todos</option>@foreach(var seller in Model.Vendedores){<option value="@seller.UsuarioId" selected="@(Model.Filtro.VendedorUsuarioId==seller.UsuarioId)">@seller.NombreCompleto</option>}</select>
</div>
<div class="djj-field">
<label for="sellerperformance-orden">Orden</label>
<select id="sellerperformance-orden" name="Orden" class="djj-select">
<option value="ventas_desc" selected="@(Model.Filtro.Orden=="ventas_desc")">Ventas ↓</option>
<option value="ventas_asc" selected="@(Model.Filtro.Orden=="ventas_asc")">Ventas ↑</option>
<option value="nombre" selected="@(Model.Filtro.Orden=="nombre")">Nombre</option>
<option value="cumplimiento_desc" selected="@(Model.Filtro.Orden=="cumplimiento_desc")">Cumplimiento ↓</option>
</select>
</div>
<div class="djj-filter-bar__actions">
<button class="djj-button djj-button--primary">Consultar</button> <a asp-action="Print" asp-route-Desde="@Model.Filtro.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Filtro.Hasta.ToString("yyyy-MM-dd")" asp-route-VendedorUsuarioId="@Model.Filtro.VendedorUsuarioId" asp-route-Orden="@Model.Filtro.Orden" target="_blank" rel="noopener" class="djj-button djj-button--secondary">Imprimir</a> <a asp-action="ExportCsv" asp-route-Desde="@Model.Filtro.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Filtro.Hasta.ToString("yyyy-MM-dd")" asp-route-VendedorUsuarioId="@Model.Filtro.VendedorUsuarioId" asp-route-Orden="@Model.Filtro.Orden" class="djj-button djj-button--secondary">Exportar CSV</a>
</div>
<div asp-validation-summary="All" class="djj-validation-summary" role="alert">
</div>
</form>
}
<p class="djj-analytics-period">Vendedor: @(Model.Vendedores.FirstOrDefault(v => v.UsuarioId == Model.Filtro.VendedorUsuarioId)?.NombreCompleto ?? "Todos") · Orden: @Model.Filtro.Orden</p>
<section class="djj-analytics-kpis" aria-label="Totales del reporte">
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Ventas</p>
<p class="djj-kpi-card__value">₡@Model.TotalVentas.ToString("N2")</p>
<small>Ventas facturadas del equipo</small>
</article>
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Pedidos</p>
<p class="djj-kpi-card__value">@Model.TotalPedidos</p>
<small>Pedidos del período</small>
</article>
<article class="djj-kpi-card">
<p class="djj-kpi-card__label">Ticket promedio</p>
<p class="djj-kpi-card__value">₡@Model.TicketPromedio.ToString("N2")</p>
<small>Promedio por pedido</small>
</article>
</section>
@if (ViewData.ModelState.IsValid) { <partial name="_AnalyticsChart" model="chart" /> }
<section class="djj-card djj-data-section" aria-labelledby="report-detail">
<header>
<div>
<h2 id="report-detail">Detalle del equipo</h2>
<p>@period · @Model.Filas.Count fila(s)</p>
</div>
</header>
<div class="djj-table-wrap" tabindex="0" role="region" aria-label="Detalle del reporte">
<table class="djj-table djj-table--compact">
<caption>La meta suma los meses completos incluidos en el rango; las ventas corresponden a las fechas seleccionadas. Clientes por vendedor no equivalen a clientes únicos del equipo.</caption>
<thead>
<tr>
<th scope="col">Vendedor</th>
<th scope="col">Ventas</th>
<th scope="col">Pedidos</th>
<th scope="col">Facturas</th>
<th scope="col">Ticket por pedido</th>
<th scope="col">Clientes</th>
<th scope="col">Meta</th>
<th scope="col">Cumplimiento</th>
<th scope="col">Restante</th>
<th scope="col">Estado</th>
</tr>
</thead>
<tbody>
@if (!Model.HayDatos) { <tr>
<td colspan="10">
<div class="djj-empty-state">
<p>@(ViewData.ModelState.IsValid ? "No hay datos para los filtros seleccionados." : "Revisá los filtros para consultar el reporte.")</p>
</div>
</td>
</tr> }
@foreach (var row in Model.Filas) { var hasGoal = row.Meta is > 0;
var status = !hasGoal ? "Sin meta" : row.CumplimientoPorcentual >= 100 ? "Meta alcanzada" : "Meta en curso";
<tr>
<th scope="row">@row.VendedorNombre</th>
<td class="djj-number">₡@row.Ventas.ToString("N2")</td>
<td class="djj-number">@row.Pedidos</td>
<td class="djj-number">@row.Facturas</td>
<td class="djj-number">₡@row.TicketPromedio.ToString("N2")</td>
<td class="djj-number">@row.ClientesAtendidos</td>
<td class="djj-number">@(row.Meta.HasValue ? $"₡{row.Meta:N2}" : "Sin meta")</td>
<td class="djj-number">@(row.CumplimientoPorcentual.HasValue ? $"{row.CumplimientoPorcentual:N2}%" : "—")
@if (hasGoal) { <td class="djj-number">₡@Math.Max(0m, row.Meta!.Value - row.Ventas).ToString("N2")</td> } else { <td>—</td> }
<td>
<span class="djj-badge @(status == "Meta alcanzada" ? "djj-badge--success" : "djj-badge--neutral")">@status</span>
</td>
</tr> }
</tbody>
</table>
</div>
</section>
</div>
