@model Proyecto_Final.Models.Admin.SuppliersIndexViewModel
@{ Layout="_WorkspaceLayout"; ViewData["Title"]="Proveedores"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Compras · Proveedores</span><h1>Proveedores</h1><p>Administrá contactos y disponibilidad para órdenes de compra.</p></div></header>
<nav class="djj-domain-nav" aria-label="Secciones de compras"><a aria-current="page" asp-action="Index">Proveedores</a><a asp-controller="PurchaseOrders" asp-action="Index">Órdenes</a><a asp-controller="PriceHistory" asp-action="Index">Histórico de precios</a></nav>
<div class="djj-detail-layout"><section class="djj-card" id="supplier-form-card"><div class="djj-card__header"><div><h2 id="supplier-form-title">@(Model.Formulario.ProveedorId>0?"Editar proveedor":"Nuevo proveedor")</h2><p>Información comercial y de contacto.</p></div></div><form asp-action="Save" method="post" class="djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1"></div><input asp-for="Formulario.ProveedorId" name="ProveedorId" id="ProveedorId" type="hidden" /><div class="djj-field"><label asp-for="Formulario.Nombre"></label><input asp-for="Formulario.Nombre" name="Nombre" id="Nombre" class="djj-input" /><span asp-validation-for="Formulario.Nombre" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Formulario.Contacto"></label><input asp-for="Formulario.Contacto" name="Contacto" id="Contacto" class="djj-input" /></div><div class="djj-form-grid"><div class="djj-field"><label asp-for="Formulario.Telefono"></label><input asp-for="Formulario.Telefono" name="Telefono" id="Telefono" class="djj-input" /></div><div class="djj-field"><label asp-for="Formulario.Email"></label><input asp-for="Formulario.Email" name="Email" id="Email" class="djj-input" /><span asp-validation-for="Formulario.Email" class="djj-field__error"></span></div></div><label class="djj-check"><input type="checkbox" name="Activo" id="Activo" value="true" checked="@(Model.Formulario.Activo)" /><input type="hidden" name="Activo" value="false" />Proveedor activo</label><div class="djj-form-actions"><button class="djj-button djj-button--ghost" type="button" id="reset-supplier">Limpiar</button><button class="djj-button djj-button--primary" type="submit">Guardar proveedor</button></div></form></section>
<section class="djj-card djj-data-section"><form asp-action="Index" method="get" class="djj-filter-bar djj-padded"><div class="djj-field"><label for="supplier-filter">Buscar</label><input id="supplier-filter" name="filtro" value="@Model.Filtro" maxlength="100" class="djj-input" /></div><div class="djj-field"><label for="supplier-status">Estado</label><select id="supplier-status" name="soloActivos" class="djj-select"><option value="">Todos</option><option value="true" selected="@(Model.SoloActivos==true)">Activos</option><option value="false" selected="@(Model.SoloActivos==false)">Inactivos</option></select></div><button class="djj-button djj-button--outline" type="submit">Filtrar</button></form>@if(!Model.Proveedores.Any()){<div class="djj-empty-state"><h3>Sin proveedores</h3><p>No hay resultados para este filtro.</p></div>}else{<div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Nombre</th><th>Contacto</th><th>Teléfono / correo</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var supplier in Model.Proveedores){<tr><td><strong>@supplier.Nombre</strong></td><td>@(supplier.Contacto??"—")</td><td><span class="djj-table__primary">@(supplier.Telefono??"—")</span><small class="djj-table__note">@(supplier.Email??"Sin correo")</small></td><td><span class="djj-badge djj-badge--@(supplier.Activo?"success":"neutral")">@(supplier.Activo?"Activo":"Inactivo")</span></td><td><div class="djj-row-actions"><button type="button" class="djj-button djj-button--outline djj-button--sm edit-supplier" data-id="@supplier.ProveedorId" data-name="@supplier.Nombre" data-contact="@supplier.Contacto" data-phone="@supplier.Telefono" data-email="@supplier.Email" data-active="@supplier.Activo.ToString().ToLowerInvariant()">Editar</button><form asp-action="ChangeStatus" method="post" data-djj-confirm="Cambiar el estado del proveedor @supplier.Nombre.">@Html.AntiForgeryToken()<input type="hidden" name="proveedorId" value="@supplier.ProveedorId" /><input type="hidden" name="activo" value="@((!supplier.Activo).ToString().ToLowerInvariant())" /><button class="djj-button djj-button--ghost djj-button--sm" type="submit">@(supplier.Activo?"Desactivar":"Reactivar")</button></form></div></td></tr>}</tbody></table></div>}</section></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const byId=id=>document.getElementById(id);const set=(id,value)=>{const element=byId(id);if(element)element.value=value||'';};document.querySelectorAll('.edit-supplier').forEach(button=>button.addEventListener('click',()=>{set('ProveedorId',button.dataset.id);set('Nombre',button.dataset.name);set('Contacto',button.dataset.contact);set('Telefono',button.dataset.phone);set('Email',button.dataset.email);byId('Activo').checked=button.dataset.active==='true';byId('supplier-form-title').textContent=`Editar proveedor #${button.dataset.id}`;byId('supplier-form-card').scrollIntoView({behavior:'smooth'});}));byId('reset-supplier')?.addEventListener('click',()=>{['ProveedorId','Nombre','Contacto','Telefono','Email'].forEach(id=>set(id,id==='ProveedorId'?'0':''));byId('Activo').checked=true;byId('supplier-form-title').textContent='Nuevo proveedor';});})();</script>}
