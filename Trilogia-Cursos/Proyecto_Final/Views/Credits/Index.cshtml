@model Proyecto_Final.Models.Admin.ClientCreditFilterViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Crédito y cobro"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Cartera</span><h1>Crédito y cobro</h1><p>Revisá límites, deuda, disponibilidad y movimientos por cliente.</p></div><div class="djj-page-header__actions"><a asp-controller="Clients" asp-action="Index" class="djj-button djj-button--outline">Ver clientes</a></div></header>
<nav class="djj-domain-nav" aria-label="Crédito y clientes"><a asp-action="Index" aria-current="page">Crédito</a><a asp-controller="AccountsReceivableAdmin" asp-action="Index">Cuentas por cobrar</a><a asp-controller="Clients" asp-action="Index">Clientes</a></nav>
<section class="djj-card djj-filter-card" aria-labelledby="credit-filters"><h2 id="credit-filters">Filtrar cartera</h2><form asp-controller="Credits" asp-action="Index" method="get" class="djj-filter-bar djj-filter-bar--wide"><div class="djj-field"><label for="credit-search" class="djj-field__label">Cliente</label><input id="credit-search" type="search" name="buscar" value="@Model.Buscar" class="djj-input" placeholder="Nombre, correo o teléfono" /></div><div class="djj-field"><label for="credit-status" class="djj-field__label">Estado de crédito</label><select id="credit-status" name="estadoCredito" class="djj-select"><option value="">Todos</option><option value="Activo" selected="@(Model.EstadoCredito == "Activo")">Activo</option><option value="Bloqueado" selected="@(Model.EstadoCredito == "Bloqueado")">Bloqueado</option><option value="Inactivo" selected="@(Model.EstadoCredito == "Inactivo")">Inactivo</option><option value="ConDeuda" selected="@(Model.EstadoCredito == "ConDeuda")">Con deuda</option><option value="SinDeuda" selected="@(Model.EstadoCredito == "SinDeuda")">Sin deuda</option><option value="SinCredito" selected="@(Model.EstadoCredito == "SinCredito")">Sin crédito asignado</option></select></div><div class="djj-filter-bar__actions"><button type="submit" class="djj-button djj-button--primary">Buscar</button><a asp-controller="Credits" asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div><span class="djj-filter-bar__results">@(Model.Clientes?.Count ?? 0) cliente(s)</span></form></section>
<section class="djj-card djj-data-section" aria-labelledby="credit-table"><header><div><h2 id="credit-table">Cartera por cliente</h2><p>El disponible corresponde al límite menos la deuda actual.</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Cliente</th><th>Estado</th><th class="djj-align-right">Límite</th><th class="djj-align-right">Deuda</th><th class="djj-align-right">Disponible</th><th class="djj-align-right">Movimientos</th><th>Último movimiento</th><th>Acción</th></tr></thead><tbody>
@if (Model.Clientes == null || !Model.Clientes.Any()) { <tr><td colspan="8"><div class="djj-empty-state"><h3>Sin resultados</h3><p>No se encontraron clientes con los filtros indicados.</p></div></td></tr> }
@foreach (var item in Model.Clientes ?? Enumerable.Empty<Proyecto_Final.Models.Admin.ClientCreditListItemViewModel>()) { var tone = item.CreditoBloqueado ? "danger" : item.CreditoActivo ? "success" : "neutral"; var state = item.CreditoBloqueado ? "Bloqueado" : item.CreditoActivo ? "Activo" : "Inactivo"; <tr><td><strong class="djj-table__primary">@item.NombreCompleto</strong><small class="djj-table__note">@item.Correo</small>@if (!item.ClienteActivo) { <small class="djj-table__note">Cliente inactivo</small> }</td><td><span class="djj-badge djj-badge--@tone">@state</span>@if (item.CreditoBloqueado) { <small class="djj-table__note">@(string.IsNullOrWhiteSpace(item.MotivoBloqueo) ? "Sin motivo registrado" : item.MotivoBloqueo)</small> }</td><td class="djj-align-right">₡@item.LimiteCredito.ToString("N2")</td><td class="djj-align-right"><strong>₡@item.DeudaActual.ToString("N2")</strong></td><td class="djj-align-right"><strong>@(item.CreditoDisponible < 0 ? "−" : string.Empty)₡@Math.Abs(item.CreditoDisponible).ToString("N2")</strong></td><td class="djj-align-right">@item.TotalMovimientos</td><td class="djj-table__nowrap">@(item.UltimoMovimiento?.ToString("dd/MM/yyyy HH:mm") ?? "Sin movimientos")</td><td><a asp-controller="Credits" asp-action="Details" asp-route-id="@item.UsuarioId" class="djj-button djj-button--outline djj-button--sm">Administrar</a></td></tr> }
</tbody></table></div></section>
