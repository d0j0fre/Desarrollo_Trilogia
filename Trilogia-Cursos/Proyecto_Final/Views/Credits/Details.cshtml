@model Proyecto_Final.Models.Admin.ClientCreditDetailViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Detalle de crédito"; var creditTone = Model.CreditoBloqueado ? "danger" : Model.CreditoActivo ? "success" : "neutral"; var creditState = Model.CreditoBloqueado ? "Bloqueado" : Model.CreditoActivo ? "Activo" : "Inactivo"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Crédito · Cliente</span><h1>@Model.NombreCompleto</h1><p>@Model.Correo · @(string.IsNullOrWhiteSpace(Model.Telefono) ? "Sin teléfono" : Model.Telefono)</p></div><div class="djj-page-header__actions"><span class="djj-badge djj-badge--@creditTone">Crédito @creditState</span><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.UsuarioId" class="djj-button djj-button--outline">Ver cliente</a><a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
<div class="djj-kpi-grid djj-kpi-grid--four"><article class="djj-card djj-kpi-card"><span>Límite</span><strong>₡@Model.LimiteCredito.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Deuda actual</span><strong>₡@Model.DeudaActual.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Disponible</span><strong>@(Model.CreditoDisponible < 0 ? "−" : string.Empty)₡@Math.Abs(Model.CreditoDisponible).ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Cliente</span><strong>@(Model.ClienteActivo ? "Activo" : "Inactivo")</strong></article></div>
<div class="djj-detail-layout"><section class="djj-card"><div class="djj-card__header"><div><h2>Registrar movimiento</h2><p>Los movimientos no se eliminan y modifican la deuda registrada.</p></div></div><form asp-controller="Credits" asp-action="RegisterMovement" method="post" class="djj-workspace-form" data-djj-confirm="Registrar este movimiento financiero para @Model.NombreCompleto. La deuda disponible se recalculará.">@Html.AntiForgeryToken()<input type="hidden" name="UsuarioId" value="@Model.UsuarioId" /><div class="djj-form-grid"><div class="djj-field"><label for="TipoMovimiento" class="djj-field__label">Tipo</label><select id="TipoMovimiento" name="TipoMovimiento" class="djj-select" required><option value="Cargo">Cargo</option><option value="Abono" selected>Abono</option><option value="AjustePositivo">Ajuste positivo</option><option value="AjusteNegativo">Ajuste negativo</option></select></div><div class="djj-field"><label for="Monto" class="djj-field__label">Monto (₡)</label><input id="Monto" type="number" step="0.01" min="1" name="Monto" inputmode="decimal" class="djj-input" required /></div><div class="djj-field"><label for="Referencia" class="djj-field__label">Referencia</label><input id="Referencia" type="text" name="Referencia" maxlength="100" class="djj-input" placeholder="Factura, pedido o recibo" /></div><div class="djj-field"><label for="Descripcion" class="djj-field__label">Descripción</label><textarea id="Descripcion" name="Descripcion" rows="3" maxlength="500" class="djj-textarea" required></textarea></div></div><div class="djj-form-actions"><button type="submit" class="djj-button djj-button--primary">Registrar movimiento</button></div></form></section>
<aside class="djj-card"><div class="djj-card__header"><div><h2>Configuración de crédito</h2><p>Definí el límite y disponibilidad para este cliente.</p></div></div><form asp-controller="Credits" asp-action="UpdateSettings" method="post" class="djj-workspace-form" data-djj-confirm="Guardar la configuración de crédito de @Model.NombreCompleto.">@Html.AntiForgeryToken()<input type="hidden" name="UsuarioId" value="@Model.UsuarioId" /><div class="djj-field"><label for="LimiteCredito" class="djj-field__label">Límite de crédito (₡)</label><input id="LimiteCredito" type="number" step="0.01" min="0" name="LimiteCredito" value="@Model.LimiteCredito" inputmode="decimal" class="djj-input" required /></div><label class="djj-check"><input type="checkbox" id="CreditoActivo" name="CreditoActivo" value="true" @(Model.CreditoActivo ? "checked" : null) /><input type="hidden" name="CreditoActivo" value="false" />Crédito activo</label><label class="djj-check"><input type="checkbox" id="CreditoBloqueado" name="CreditoBloqueado" value="true" @(Model.CreditoBloqueado ? "checked" : null) /><input type="hidden" name="CreditoBloqueado" value="false" />Crédito bloqueado</label><div class="djj-field"><label for="MotivoBloqueo" class="djj-field__label">Motivo de bloqueo o desactivación</label><textarea id="MotivoBloqueo" name="MotivoBloqueo" rows="3" maxlength="255" class="djj-textarea">@Model.MotivoBloqueo</textarea><small class="djj-field__hint">Obligatorio al bloquear o desactivar.</small></div><div class="djj-form-actions"><button type="submit" class="djj-button djj-button--primary">Guardar configuración</button></div></form></aside></div>
<section class="djj-card djj-data-section" aria-labelledby="credit-movements"><header><div><h2 id="credit-movements">Historial de movimientos</h2><p>Cargos: ₡@Model.TotalCargos.ToString("N2") · Abonos y ajustes negativos: ₡@Model.TotalAbonos.ToString("N2")</p></div><span class="djj-badge djj-badge--neutral">@Model.Movimientos.Count movimiento(s)</span></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Movimiento</th><th>Fecha</th><th>Tipo</th><th class="djj-align-right">Monto</th><th>Descripción</th><th>Referencia</th><th>Registrado por</th></tr></thead><tbody>
@if (Model.Movimientos == null || !Model.Movimientos.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin movimientos</h3><p>Este cliente todavía no tiene movimientos de crédito.</p></div></td></tr> }
@foreach (var mov in Model.Movimientos ?? Enumerable.Empty<Proyecto_Final.Models.Admin.ClientCreditMovementViewModel>()) { var positiveDebt = mov.TipoMovimiento is "Cargo" or "AjustePositivo"; var label = mov.TipoMovimiento switch { "Cargo" => "Cargo", "Abono" => "Abono", "AjustePositivo" => "Ajuste +", _ => "Ajuste −" }; <tr><td>#@mov.CreditoMovimientoId</td><td class="djj-table__nowrap">@mov.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td><td><span class="djj-badge djj-badge--@(positiveDebt ? "warning" : "success")">@label</span></td><td class="djj-align-right">₡@mov.Monto.ToString("N2")</td><td>@mov.Descripcion</td><td>@(string.IsNullOrWhiteSpace(mov.Referencia) ? "Sin referencia" : mov.Referencia)</td><td>@(string.IsNullOrWhiteSpace(mov.RegistradoPorNombre) ? "Sistema" : mov.RegistradoPorNombre)</td></tr> }
</tbody></table></div></section>
