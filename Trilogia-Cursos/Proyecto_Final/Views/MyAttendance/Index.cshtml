@model Proyecto_Final.Models.Admin.MyAttendanceIndexViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Mis jornadas"; string Tone(string state) => state switch { "Aprobada" => "success", "Rechazada" => "danger", "Enviada" or "Pendiente" or "Borrador" => "warning", _ => "neutral" }; }

<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Mi portal · Tiempo</span><h1>Mis jornadas</h1><p>Registrá horas ordinarias, extra o de ausencia para una fecha y consultá su estado.</p></div><div class="djj-page-header__actions"><a asp-controller="EmployeePortal" asp-action="Index" class="djj-button djj-button--ghost">Volver a mi portal</a></div></header>
<section class="djj-card" aria-labelledby="attendance-form-title"><div class="djj-card__header"><div><h2 id="attendance-form-title">Registrar jornada</h2><p>La suma de horas debe ser mayor que cero y no puede superar 24.</p></div></div><form asp-action="Save" method="post" class="djj-workspace-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="Form.IdempotencyKey" name="IdempotencyKey" /><div asp-validation-summary="ModelOnly" class="djj-alert djj-alert--danger" role="alert" tabindex="-1" data-djj-validation-summary></div><div class="djj-form-grid djj-form-grid--four"><div class="djj-field"><label asp-for="Form.Fecha"></label><input asp-for="Form.Fecha" name="Fecha" class="djj-input" type="date" /><span asp-validation-for="Form.Fecha" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Form.HorasOrdinarias"></label><input asp-for="Form.HorasOrdinarias" name="HorasOrdinarias" class="djj-input djj-number" type="number" min="0" max="24" step="0.25" /><span asp-validation-for="Form.HorasOrdinarias" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Form.HorasExtra"></label><input asp-for="Form.HorasExtra" name="HorasExtra" class="djj-input djj-number" type="number" min="0" max="24" step="0.25" /><span asp-validation-for="Form.HorasExtra" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Form.HorasAusencia"></label><input asp-for="Form.HorasAusencia" name="HorasAusencia" class="djj-input djj-number" type="number" min="0" max="24" step="0.25" /><span asp-validation-for="Form.HorasAusencia" class="djj-field__error"></span></div></div><div class="djj-field"><label asp-for="Form.Observaciones"></label><textarea asp-for="Form.Observaciones" name="Observaciones" class="djj-textarea" rows="3" maxlength="500"></textarea><span asp-validation-for="Form.Observaciones" class="djj-field__error"></span></div><div class="djj-form-actions"><button name="submit" value="false" class="djj-button djj-button--outline">Guardar borrador</button><button name="submit" value="true" class="djj-button djj-button--primary" data-djj-confirm="Enviar esta jornada para aprobación. Después quedará pendiente de la decisión de un supervisor.">Enviar a aprobación</button></div></form></section>
<section class="djj-card djj-data-section" aria-labelledby="my-attendance-list"><header><div><h2 id="my-attendance-list">Historial de jornadas</h2><p>@Model.Jornadas.Count registro(s).</p></div></header><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Fecha</th><th class="djj-align-right">Ordinarias</th><th class="djj-align-right">Extra</th><th class="djj-align-right">Ausencia</th><th>Estado</th><th>Respuesta</th></tr></thead><tbody>@if (!Model.Jornadas.Any()) { <tr><td colspan="6"><div class="djj-empty-state"><h3>Sin jornadas</h3><p>Todavía no registraste jornadas.</p></div></td></tr> }@foreach (var item in Model.Jornadas) { <tr><td class="djj-table__nowrap">@item.Fecha.ToString("dd/MM/yyyy")</td><td class="djj-align-right">@item.HorasOrdinarias.ToString("N2") h</td><td class="djj-align-right">@item.HorasExtra.ToString("N2") h</td><td class="djj-align-right">@item.HorasAusencia.ToString("N2") h</td><td><span class="djj-status-badge djj-status-badge--@Tone(item.Estado)">@item.Estado</span></td><td>@(string.IsNullOrWhiteSpace(item.RespuestaSupervisor) ? "Sin respuesta" : item.RespuestaSupervisor)</td></tr> }</tbody></table></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
