@model Proyecto_Final.Models.Admin.OperatingExpenseFormViewModel
@using Proyecto_Final.Models.Admin
@{ var departments = ViewBag.Departments as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>(); var categories = ViewBag.Categories as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>(); }
<input asp-for="ExpenseId" type="hidden" /><input asp-for="OperationToken" type="hidden" />
<fieldset><legend>Clasificación</legend><div class="djj-form-grid djj-form-grid--three"><div class="djj-field"><label asp-for="ExpenseDate">Fecha</label><input asp-for="ExpenseDate" class="djj-input" /><span asp-validation-for="ExpenseDate" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="DepartmentId">Departamento</label><select asp-for="DepartmentId" class="djj-select"><option value="">Seleccioná</option>@foreach (var item in departments) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="DepartmentId" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="CategoryId">Categoría</label><select asp-for="CategoryId" class="djj-select"><option value="">Seleccioná</option>@foreach (var item in categories) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="CategoryId" class="djj-field__error"></span></div></div></fieldset>
<fieldset><legend>Documento</legend><div class="djj-form-grid djj-form-grid--three"><div class="djj-field"><label asp-for="SupplierName">Proveedor</label><input asp-for="SupplierName" class="djj-input" /><span asp-validation-for="SupplierName" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="DocumentNumber">N.º documento</label><input asp-for="DocumentNumber" class="djj-input" /><span asp-validation-for="DocumentNumber" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="DocumentType">Tipo</label><select asp-for="DocumentType" class="djj-select"><option>Factura</option><option>Recibo</option><option>Nota de débito</option><option>Otro</option></select></div></div><div class="djj-field"><label asp-for="Description">Descripción</label><textarea asp-for="Description" class="djj-textarea" rows="3"></textarea><span asp-validation-for="Description" class="djj-field__error"></span></div></fieldset>
<fieldset><legend>Montos y pago</legend><div class="djj-form-grid djj-form-grid--four"><div class="djj-field"><label asp-for="Subtotal">Subtotal (₡)</label><input asp-for="Subtotal" type="number" step="0.01" min="0.01" inputmode="decimal" class="djj-input" data-expense-money /><span asp-validation-for="Subtotal" class="djj-field__error"></span></div><div class="djj-field"><label asp-for="Tax">Impuesto (₡)</label><input asp-for="Tax" type="number" step="0.01" min="0" inputmode="decimal" class="djj-input" data-expense-money /><span asp-validation-for="Tax" class="djj-field__error"></span></div><div class="djj-field"><label for="expense-total">Total calculado</label><output id="expense-total" class="djj-money-output" data-expense-total>₡@Model.Total.ToString("N2")</output><small class="djj-field__hint">Se valida nuevamente en el servidor.</small></div><div class="djj-field"><label asp-for="PaymentMethod">Método de pago</label><select asp-for="PaymentMethod" class="djj-select"><option>Transferencia</option><option>Tarjeta</option><option>Efectivo</option><option>Crédito</option></select></div></div></fieldset>
@if (Model.ExpenseId == 0) { <fieldset><legend>Evidencia <span class="djj-page-header__meta">(opcional)</span></legend><div class="djj-field"><label asp-for="Receipt">Comprobante privado</label><input asp-for="Receipt" type="file" accept=".pdf,.jpg,.jpeg,.png" class="djj-input" data-file-label="expense-file-name" /><span id="expense-file-name" class="djj-field__hint" aria-live="polite">Ningún archivo seleccionado</span><small class="djj-field__hint">PDF, JPG o PNG; queda fuera de wwwroot y requiere autorización.</small><span asp-validation-for="Receipt" class="djj-field__error"></span></div></fieldset> } else { <div class="djj-alert djj-alert--info" role="status">El comprobante original se conserva para proteger la trazabilidad.</div> }
