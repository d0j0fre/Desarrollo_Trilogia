@model Proyecto_Final.Models.Admin.OperatingExpenseFormViewModel
@using Proyecto_Final.Models.Admin
@{
    var departments = ViewBag.Departments as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>();
    var categories = ViewBag.Categories as IReadOnlyList<SelectOptionViewModel> ?? Array.Empty<SelectOptionViewModel>();
}
<input asp-for="ExpenseId" type="hidden" />
<input asp-for="OperationToken" type="hidden" />
<div class="form-row">
    <div class="form-group col-md-4"><label asp-for="ExpenseDate">Fecha</label><input asp-for="ExpenseDate" class="form-control" /><span asp-validation-for="ExpenseDate" class="text-danger"></span></div>
    <div class="form-group col-md-4"><label asp-for="DepartmentId">Departamento</label><select asp-for="DepartmentId" class="form-control"><option value="">Seleccione</option>@foreach (var item in departments) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
    <div class="form-group col-md-4"><label asp-for="CategoryId">Categoría</label><select asp-for="CategoryId" class="form-control"><option value="">Seleccione</option>@foreach (var item in categories) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
</div>
<div class="form-row">
    <div class="form-group col-md-6"><label asp-for="SupplierName">Proveedor</label><input asp-for="SupplierName" class="form-control" /><span asp-validation-for="SupplierName" class="text-danger"></span></div>
    <div class="form-group col-md-3"><label asp-for="DocumentNumber">N.º documento</label><input asp-for="DocumentNumber" class="form-control" /><span asp-validation-for="DocumentNumber" class="text-danger"></span></div>
    <div class="form-group col-md-3"><label asp-for="DocumentType">Tipo</label><select asp-for="DocumentType" class="form-control"><option>Factura</option><option>Recibo</option><option>Nota de débito</option><option>Otro</option></select></div>
</div>
<div class="form-group"><label asp-for="Description">Descripción</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="form-row">
    <div class="form-group col-md-3"><label asp-for="Subtotal">Subtotal</label><input asp-for="Subtotal" type="number" step="0.01" min="0.01" class="form-control" data-expense-money /><span asp-validation-for="Subtotal" class="text-danger"></span></div>
    <div class="form-group col-md-3"><label asp-for="Tax">Impuesto</label><input asp-for="Tax" type="number" step="0.01" min="0" class="form-control" data-expense-money /><span asp-validation-for="Tax" class="text-danger"></span></div>
    <div class="form-group col-md-3"><label>Total calculado</label><output class="form-control font-weight-bold" data-expense-total>₡@Model.Total.ToString("N2")</output><small class="form-text text-muted">Se recalcula y valida en el servidor.</small></div>
    <div class="form-group col-md-3"><label asp-for="PaymentMethod">Método de pago</label><select asp-for="PaymentMethod" class="form-control"><option>Transferencia</option><option>Tarjeta</option><option>Efectivo</option><option>Crédito</option></select></div>
</div>
@if (Model.ExpenseId == 0)
{
    <div class="form-group s4-file-zone">
        <label asp-for="Receipt">Comprobante privado opcional</label>
        <input asp-for="Receipt" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control-file" data-file-label="expense-file-name" />
        <span id="expense-file-name" class="s4-file-note" aria-live="polite">Ningún archivo seleccionado</span>
        <small class="s4-file-note">PDF, JPG o PNG; el archivo queda fuera de wwwroot y requiere autorización para descargar.</small>
        <span asp-validation-for="Receipt" class="text-danger"></span>
    </div>
}
else
{
    <div class="alert alert-info"><i class="fa fa-lock mr-1"></i>El comprobante original se conserva para proteger la trazabilidad.</div>
}
