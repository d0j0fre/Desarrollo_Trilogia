@model Proyecto_Final.Models.Admin.OperatingExpenseFormViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Registrar gasto"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Gastos · Nuevo registro</span><h1>Registrar gasto</h1><p>El total y el impacto presupuestario se recalculan en el servidor.</p></div></header><form asp-action="Create" method="post" enctype="multipart/form-data" class="djj-card djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><partial name="_OperatingForm" model="Model" /><div class="djj-form-actions"><a asp-action="Index" class="djj-button djj-button--ghost">Cancelar</a><button class="djj-button djj-button--primary" type="submit">Registrar gasto</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
