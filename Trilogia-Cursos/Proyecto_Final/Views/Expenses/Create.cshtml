@model Proyecto_Final.Models.Admin.OperatingExpenseFormViewModel
@{ ViewData["Title"] = "Registrar gasto"; }

<div class="container py-4 s4-admin-page">
    <header class="d-flex flex-wrap justify-content-between align-items-start mb-4">
        <div class="s4-page-header">
            <span class="s4-eyebrow"><i class="fa fa-receipt"></i> Control operativo</span>
            <h2>Registrar gasto</h2>
            <p class="text-muted mb-0">El total y el impacto presupuestario se recalculan en el servidor.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa fa-arrow-left mr-1"></i>Volver</a>
    </header>
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div class="card">
        <div class="card-header">Datos y comprobante</div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <partial name="_OperatingForm" model="Model" />
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary" type="submit"><i class="fa fa-lock mr-1"></i>Registrar gasto</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
