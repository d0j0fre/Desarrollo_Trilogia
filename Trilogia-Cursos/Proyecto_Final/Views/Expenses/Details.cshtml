@model Proyecto_Final.Models.Admin.OperatingExpenseDetailsViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = $"Gasto {Model.Expense.ExpenseId}"; var executionCapped = Math.Max(0, Math.Min(100, (int)Model.Expense.ExecutionPercent)); string Tone(string state) => state switch { "Pagado" => "success", "Aprobado" => "success", "Rechazado" => "danger", "Anulado" => "neutral", _ => "warning" }; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Gasto auditado · #@Model.Expense.ExpenseId</span><h1>@Model.Expense.Description</h1><p>@Model.Expense.DepartmentName · @Model.Expense.CategoryName</p></div><div class="djj-page-header__actions"><span class="djj-badge djj-badge--@Tone(Model.Expense.Status)">@Model.Expense.Status</span>@if (Model.Expense.Status == "Registrado") { <a asp-action="Edit" asp-route-id="@Model.Expense.ExpenseId" class="djj-button djj-button--outline">Editar</a> }<a asp-action="Index" class="djj-button djj-button--ghost">Volver</a></div></header>
@if (Model.Expense.ExecutionPercent >= 80) { <div class="djj-alert djj-alert--@(Model.Expense.ExecutionPercent >= 100 ? "danger" : "warning")" role="alert"><strong>Atención presupuestaria.</strong> Este gasto ubica la ejecución en @Model.Expense.ExecutionPercent.ToString("N1")% (@Model.Expense.ConsumptionLevel).</div> }
<section class="djj-card djj-budget-progress" aria-labelledby="expense-impact"><div class="djj-card__header"><div><h2 id="expense-impact">Impacto presupuestario</h2><p>Real frente al presupuesto asociado.</p></div><strong>@Model.Expense.ExecutionPercent.ToString("N1")%</strong></div><div class="djj-progress" role="progressbar" aria-label="Ejecución presupuestaria" aria-valuenow="@executionCapped" aria-valuemin="0" aria-valuemax="100"><span class="djj-progress__bar djj-progress__bar--@(Model.Expense.ExecutionPercent >= 100 ? "danger" : Model.Expense.ExecutionPercent >= 80 ? "warning" : "success")" style="--djj-progress-value:@executionCapped%"></span></div><div class="djj-money-comparison"><span>Presupuesto <strong>₡@Model.Expense.BudgetAmount.ToString("N2")</strong></span><span>Real <strong>₡@Model.Expense.RealSpent.ToString("N2")</strong></span><span>Comprometido <strong>₡@Model.Expense.CommittedSpent.ToString("N2")</strong></span></div></section>
<div class="djj-detail-layout"><section class="djj-card"><div class="djj-card__header"><div><h2>Datos del gasto</h2><p>Documento, responsable y valores registrados.</p></div></div><dl class="djj-detail-grid"><div><dt>Fecha</dt><dd>@Model.Expense.ExpenseDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Documento</dt><dd>@Model.DocumentType @Model.Expense.DocumentNumber</dd></div><div><dt>Proveedor</dt><dd>@(Model.Expense.SupplierName ?? "Sin proveedor")</dd></div><div><dt>Método de pago</dt><dd>@Model.PaymentMethod</dd></div><div><dt>Subtotal</dt><dd class="djj-money">₡@Model.Expense.Subtotal.ToString("N2")</dd></div><div><dt>Impuesto</dt><dd class="djj-money">₡@Model.Expense.Tax.ToString("N2")</dd></div><div><dt>Total</dt><dd class="djj-money djj-money--dominant">₡@Model.Expense.Total.ToString("N2")</dd></div><div><dt>Nivel</dt><dd>@Model.Expense.ConsumptionLevel · @Model.Expense.ExecutionPercent.ToString("N2")%</dd></div></dl>@if (Model.Expense.HasReceipt) { <a asp-action="Receipt" asp-route-id="@Model.Expense.ExpenseId" class="djj-button djj-button--outline">Descargar comprobante privado</a> }</section>
<aside class="djj-card"><div class="djj-card__header"><div><h2>Acciones</h2><p>Revisá monto, evidencia e impacto antes de decidir.</p></div></div><div class="djj-workspace-form">@if (Model.Expense.Status == "Registrado") { <form asp-action="Approve" method="post" class="djj-workspace-form" data-djj-confirm="Aprobar el gasto #@Model.Expense.ExpenseId por ₡@Model.Expense.Total.ToString("N2"). Afectará el presupuesto.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Expense.ExpenseId" /><label class="djj-check"><input type="checkbox" name="overrideBudget" value="true" />Autorizar exceso (requiere permiso)</label><button class="djj-button djj-button--success">Aprobar gasto</button></form><form asp-action="Reject" method="post" class="djj-workspace-form" data-djj-confirm="Rechazar el gasto #@Model.Expense.ExpenseId.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Expense.ExpenseId" /><div class="djj-field"><label for="expense-reject-reason">Motivo de rechazo</label><textarea id="expense-reject-reason" name="reason" class="djj-textarea" required maxlength="500"></textarea></div><button class="djj-button djj-button--danger">Rechazar</button></form> }@if (Model.Expense.Status == "Aprobado") { <form asp-action="Pay" method="post" data-djj-confirm="Marcar como pagado el gasto #@Model.Expense.ExpenseId por ₡@Model.Expense.Total.ToString("N2").">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Expense.ExpenseId" /><button class="djj-button djj-button--primary">Marcar pagado</button></form> }@if (Model.Expense.Status != "Pagado" && Model.Expense.Status != "Anulado") { <form asp-action="Cancel" method="post" class="djj-workspace-form" data-djj-confirm="Anular el gasto #@Model.Expense.ExpenseId. Dejará de afectar el presupuesto.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Expense.ExpenseId" /><div class="djj-field"><label for="expense-cancel-reason">Motivo de anulación</label><textarea id="expense-cancel-reason" name="reason" class="djj-textarea" required maxlength="500"></textarea></div><button class="djj-button djj-button--danger">Anular gasto</button></form> }</div></aside></div>
<section class="djj-card"><div class="djj-card__header"><div><h2>Auditoría</h2><p>Cambios de estado y responsables.</p></div></div><ul class="djj-audit-list">@foreach (var item in Model.Audit) { <li><strong>@item.Action</strong><span>@item.UserName · @item.CreatedUtc.ToString("dd/MM/yyyy HH:mm") UTC</span><p>@item.Detail</p></li> }</ul></section>
