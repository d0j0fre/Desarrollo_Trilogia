@model Proyecto_Final.Models.Admin.OperatingExpenseFormViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Editar gasto"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Gastos · Registro #@Model.ExpenseId</span><h1>Editar gasto</h1><p>Actualizá el registro antes de que cambie de estado.</p></div></header><form asp-action="Edit" method="post" enctype="multipart/form-data" class="djj-card djj-workspace-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="djj-validation-summary" role="alert" tabindex="-1" data-djj-validation-summary></div><partial name="_OperatingForm" model="Model" /><div class="djj-form-actions"><a asp-action="Details" asp-route-id="@Model.ExpenseId" class="djj-button djj-button--ghost">Cancelar</a><button class="djj-button djj-button--primary">Guardar cambios</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
