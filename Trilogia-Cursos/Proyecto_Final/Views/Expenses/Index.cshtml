@model Proyecto_Final.Models.Admin.ExpensesDashboardViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Gastos operativos"; ViewBag.Departments = Model.Departments; ViewBag.Categories = Model.Categories; string Tone(string value) => value is "Excedido" or "Crítico" ? "danger" : value == "Advertencia" ? "warning" : "success"; string StateTone(string state) => state switch { "Pagado" => "success", "Aprobado" => "success", "Rechazado" => "danger", "Anulado" => "neutral", _ => "warning" }; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Operación</span><h1>Gastos operativos</h1><p>Registro, aprobación, pago y afectación presupuestaria.</p></div><div class="djj-page-header__actions"><a asp-controller="BudgetComparison" asp-action="Index" class="djj-button djj-button--outline">Comparativa</a><a asp-action="Create" class="djj-button djj-button--primary">Registrar gasto</a></div></header>
<nav class="djj-domain-nav" aria-label="Presupuestos y gastos"><a asp-controller="Budgets" asp-action="Index">Presupuestos</a><a asp-action="Index" aria-current="page">Gastos</a><a asp-controller="BudgetComparison" asp-action="Index">Comparativa</a></nav>
<div class="djj-kpi-grid djj-kpi-grid--five"><article class="djj-card djj-kpi-card"><span>Registrado</span><strong>₡@Model.RegisteredTotal.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Aprobado</span><strong>₡@Model.ApprovedTotal.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Pagado</span><strong>₡@Model.PaidTotal.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Pendiente</span><strong>₡@Model.PendingTotal.ToString("N2")</strong></article><article class="djj-card djj-kpi-card"><span>Disponible</span><strong>@(Model.AvailableBudget < 0 ? "−" : string.Empty)₡@Math.Abs(Model.AvailableBudget).ToString("N2")</strong></article></div>
<section class="djj-card djj-filter-card" aria-labelledby="expense-filters"><h2 id="expense-filters">Filtrar gastos</h2><form method="get" class="djj-filter-bar djj-filter-bar--finance"><div class="djj-field"><label for="expense-search">Buscar</label><input id="expense-search" name="Search" value="@Model.Filter.Search" class="djj-input" placeholder="Documento, proveedor o descripción" /></div><div class="djj-field"><label for="expense-from">Desde</label><input id="expense-from" type="date" name="From" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" class="djj-input" /></div><div class="djj-field"><label for="expense-to">Hasta</label><input id="expense-to" type="date" name="To" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="djj-input" /></div><div class="djj-field"><label for="expense-dept">Departamento</label><select id="expense-dept" name="DepartmentId" class="djj-select"><option value="">Todos</option>@foreach (var item in Model.Departments) { <option value="@item.Id" selected="@(Model.Filter.DepartmentId == item.Id)">@item.Name</option> }</select></div><div class="djj-field"><label for="expense-category">Categoría</label><select id="expense-category" name="CategoryId" class="djj-select"><option value="">Todas</option>@foreach (var item in Model.Categories) { <option value="@item.Id" selected="@(Model.Filter.CategoryId == item.Id)">@item.Name</option> }</select></div><div class="djj-field"><label for="expense-status">Estado</label><select id="expense-status" name="Status" class="djj-select"><option value="">Todos</option>@foreach (var state in new[] { "Registrado", "Aprobado", "Rechazado", "Pagado", "Anulado" }) { <option selected="@(Model.Filter.Status == state)">@state</option> }</select></div><div class="djj-filter-bar__actions"><button class="djj-button djj-button--primary">Filtrar</button><a asp-action="Index" class="djj-button djj-button--ghost">Limpiar</a></div></form></section>
<section class="djj-card djj-data-section"><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Fecha / documento</th><th>Departamento</th><th>Descripción</th><th class="djj-align-right">Total</th><th>Estado</th><th>Impacto</th><th>Acción</th></tr></thead><tbody>@if (!Model.Expenses.Items.Any()) { <tr><td colspan="7"><div class="djj-empty-state"><h3>Sin gastos</h3><p>No hay registros para los filtros seleccionados.</p></div></td></tr> }@foreach (var item in Model.Expenses.Items) { <tr><td>@item.ExpenseDate.ToString("dd/MM/yyyy")<small class="djj-table__note">@item.DocumentNumber</small></td><td>@item.DepartmentName<small class="djj-table__note">@item.CategoryName</small></td><td>@item.Description<small class="djj-table__note">@(item.SupplierName ?? "Sin proveedor")</small></td><td class="djj-align-right"><strong>₡@item.Total.ToString("N2")</strong></td><td><span class="djj-badge djj-badge--@StateTone(item.Status)">@item.Status</span></td><td><span class="djj-badge djj-badge--@Tone(item.ConsumptionLevel)">@item.ConsumptionLevel · @item.ExecutionPercent.ToString("N1")%</span></td><td><a asp-action="Details" asp-route-id="@item.ExpenseId" class="djj-button djj-button--outline djj-button--sm">Ver</a></td></tr> }</tbody></table></div><footer class="djj-table-footer"><span>@Model.Expenses.Total gasto(s)</span><div class="djj-row-actions">@if (Model.Expenses.Page > 1) { <a asp-route-Page="@(Model.Expenses.Page - 1)" asp-route-Search="@Model.Filter.Search" asp-route-From="@Model.Filter.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To?.ToString("yyyy-MM-dd")" asp-route-DepartmentId="@Model.Filter.DepartmentId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-Status="@Model.Filter.Status" class="djj-button djj-button--ghost djj-button--sm">Anterior</a> }@if (Model.Expenses.Page < Model.Expenses.TotalPages) { <a asp-route-Page="@(Model.Expenses.Page + 1)" asp-route-Search="@Model.Filter.Search" asp-route-From="@Model.Filter.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To?.ToString("yyyy-MM-dd")" asp-route-DepartmentId="@Model.Filter.DepartmentId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-Status="@Model.Filter.Status" class="djj-button djj-button--ghost djj-button--sm">Siguiente</a> }</div></footer></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
