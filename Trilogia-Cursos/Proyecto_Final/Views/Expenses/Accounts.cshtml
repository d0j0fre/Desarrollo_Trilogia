@model Proyecto_Final.Models.Admin.AccountsViewModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Cuentas presupuestarias legadas"; }
<header class="djj-page-header"><div class="djj-page-header__copy"><span class="djj-page-header__eyebrow">Finanzas · Solo lectura</span><h1>Cuentas presupuestarias legadas</h1><p>Consulta temporal del modelo mensual anterior; el presupuesto anual es el modelo autoritativo.</p></div><div class="djj-page-header__actions"><a asp-controller="Budgets" asp-action="Index" class="djj-button djj-button--primary">Presupuestos anuales</a><a asp-action="Index" class="djj-button djj-button--ghost">Volver a gastos</a></div></header><div class="djj-alert djj-alert--warning" role="note"><strong>Solo lectura.</strong> Estos registros se conservan por compatibilidad y no deben modificarse.</div><section class="djj-card djj-data-section"><div class="djj-table-wrap"><table class="djj-table djj-table--compact"><thead><tr><th>Código</th><th>Nombre</th><th>Descripción</th><th class="djj-align-right">Presupuesto mensual</th><th>Estado</th></tr></thead><tbody>@if (!Model.Cuentas.Any()) { <tr><td colspan="5"><div class="djj-empty-state"><h3>Sin cuentas legadas</h3><p>No hay registros conservados.</p></div></td></tr> }@foreach (var item in Model.Cuentas) { <tr><td><strong>@item.Codigo</strong></td><td>@item.Nombre</td><td>@(item.Descripcion ?? "—")</td><td class="djj-align-right">₡@item.PresupuestoMensual.ToString("N2")</td><td><span class="djj-badge djj-badge--@(item.Activo ? "success" : "neutral")">@(item.Activo ? "Activa" : "Inactiva")</span></td></tr> }</tbody></table></div></section>
