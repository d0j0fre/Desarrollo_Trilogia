<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 o superior dibuja su propia pantalla de arranque con el
         icono de la aplicacion. Se le da el fondo vino y el logo, en vez del
         blanco generico del sistema. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_wine</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_wine</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_wine</item>
    </style>
</resources>
