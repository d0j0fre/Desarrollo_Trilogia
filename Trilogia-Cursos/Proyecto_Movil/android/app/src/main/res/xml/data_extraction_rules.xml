<?xml version="1.0" encoding="utf-8"?>
<!--
  Que se excluye de los respaldos y de las transferencias entre telefonos.

  El almacen donde viven los tokens y la base local con rutas y entregas no
  salen del aparato. Un respaldo en la nube que incluyera la sesion permitiria
  restaurarla en otro telefono sin volver a autenticarse.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="database" path="operacion_labodega.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="database" path="operacion_labodega.db" />
    </device-transfer>
</data-extraction-rules>
